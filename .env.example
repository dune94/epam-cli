# GENERATED by install.sh from orchestrations/config/provider-sets.json and
# orchestrations/config/env-vars.json — do not hand-edit this file, edit those.
# Copy to .env and fill in; re-running the installer regenerates THIS template,
# never your real .env.

# ── Provider credentials — each is used by the set(s) named ──
# used by: openrouter
OPENROUTER_API_KEY=

# used by: openrouter
MINIMAX_API_KEY=

# ── Feature-scoped — needed only if you use that feature ──
# Jira ticket ingestion (a project with EPAM_PROJECT set)
JIRA_EMAIL=

# Jira ticket ingestion (a project with EPAM_PROJECT set)
JIRA_TOKEN=

# replay (--replay on / EPAM_REPLAY=on) — already checked separately by the installer's own Replay step
LANGFUSE_SECRET_KEY=

# replay (--replay on / EPAM_REPLAY=on) — already checked separately by the installer's own Replay step
LANGFUSE_PUBLIC_KEY=

# GitHub-hosted codelines via the copilot provider (src/providers/copilot/CopilotProvider.ts)
GITHUB_PERSONAL_ACCESS_TOKEN=
