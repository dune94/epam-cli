# Copy to .env and fill in. The API REFUSES TO START without the two required values —
# a misconfigured install fails where someone is watching, not at the first click that spends money.

# REQUIRED. Gates the launch button. Anyone with this can spend real money on the shared key.
LAUNCH_PASSWORD=

# REQUIRED. Never guessed: a guessed vendor is how MiniMax reached a claude run.
EPAM_PROVIDER_SET=claude

# Recorded on every run so a replay targets the code level the original ran against.
EPAM_CODE_LEVEL=v1.6

# Where the UI is served.
LAUNCH_UI_PORT=8099

# ── the host-side runner reads these; it is NOT a container ──────────────────
# EPAM_HOME=/path/to/epam-cli
# EPAM_LAUNCHER=/path/to/epam-cli/orchestrations/scripts/tier3-metrolinx-run.sh
# EPAM_NODE_OPTIONS=--max-old-space-size=4096

# The name on the login screen, the dashboard header and the browser tab.
# Compiled into the UI bundle, so a change needs: docker compose build launch-ui
LAUNCH_TITLE=
