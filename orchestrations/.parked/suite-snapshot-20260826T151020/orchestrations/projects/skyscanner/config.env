# ── Skyscanner Project Config ─────────────────────────────────────────────────
# Consumed by orchestrations/scripts/orchestrate.sh --project skyscanner

# ── Project identity ──────────────────────────────────────────────────────────
PROJECT_NAME=skyscanner
EPAM_BROWNFIELD=0
EPAM_PHASES="scaffold core"

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=/home/bradleyjerome/projects/skyscanner-app
PRD_CANONICAL=orchestrations/travel-app-prd.canonical.json
PRD_FILE=orchestrations/travel-app-prd.json

# ── Required keys (checked before launch, comma-separated) ───────────────────
REQUIRED_KEYS=MINIMAX_API_KEY,OPENROUTER_API_KEY

# ── Gate / coordinator model ──────────────────────────────────────────────────
# Set to glm-5.2 (2026-07-17): glm-5.2 has 1M context vs glm-5.1's 202K;
# 4 of 7 coordinator calls in the last clean run exceeded glm-5.1's limit
# (worst: spec-validator at 503K tokens, 148% over). glm-5.2 is also slightly
# cheaper ($0.91 vs $0.97/M input). ESCALATION_MODEL_HIGH stays as glm-5.1 —
# spec-mode and the HIGH ladder ceiling are unaffected.
# ORCH_GATE_PROVIDER=openrouter   # moved to config.openrouter.env
# EPAM_ORCHESTRATION_PROVIDER=openrouter   # moved to config.openrouter.env
# MODEL PINS REMOVED 2026-08-25 — THE LADDER IS THE SOURCE OF TRUTH.
# These variables each pinned one model and won over the seam's ladder-resolved choice for
# every consumer that read them. Found by a MOCKED run: the request on the wire asked for
# z-ai/glm-5.2 while seamInvocationEnv had resolved z-ai/glm-5.3 — the resolver was right and
# a config literal beat it downstream. Every consumer already falls through to the seam
# (seamStartModel / EPAM_MODEL), so removing them hands the decision back to the ladder.
# EPAM_FINAL_FALLBACK_MODEL is deliberately KEPT: it applies after ladder exhaustion, which
# is the one point where the ladder has nothing left to say.
# ORCH_GATE_MODEL=z-ai/glm-5.2   # removed: ladder decides

# ── Escalation ladder ─────────────────────────────────────────────────────────
# ESCALATION_MODEL: GLM 5.2 for Rung 2/3 (reasoning model, 1M ctx).
# ESCALATION_MODEL_HIGH: stronger/pricier model than medium tier.
# claude.sh's classify_ladder_tier() decides medium vs high per story from
# story-failures.jsonl — never hardcoded per story ID.
# ESCALATION_MODEL=z-ai/glm-5.2   # removed: ladder decides
# ESCALATION_MODEL_HIGH=z-ai/glm-5.1   # removed: ladder decides

# ── Temperature ───────────────────────────────────────────────────────────────
# Pinned to 0 for ALL models (2026-07-10). Root cause this fixes: claude.sh's
# FailureDiversity mechanism detects a story retrying with a DIFFERENT diagnosis
# each attempt — signature of token-selection variance, not a capability gap —
# and pins EPAM_TEMPERATURE=0 for that story. Without pinning globally, this
# correction was silently discarded for non-GLM models (MiniMax-M3, kimi-k2),
# confirmed live 2026-07-09/10: SKY-002-impl cycled through 6 different diagnoses
# across 8 retries without converging.
EPAM_TEMPERATURE=0

# ── Spec-mode models ──────────────────────────────────────────────────────────
# Always use the HIGH tier for spec-mode decisions (AC elaboration, story splits).
# A bad spec-pass decision can't be retried at a stronger model automatically,
# unlike implementation stories. Root cause of live defect (2026-07-06): openspec
# on kimi-k2 repeatedly ignored "MANDATORY split required" instructions for
# oversized stories, burning the entire downstream retry ladder.
# SPEC_MODE_PROVIDER=openrouter   # moved to config.openrouter.env
# SPEC_MODE_OPENSPEC_MODEL=z-ai/glm-5.1   # removed: ladder decides
# SPEC_MODE_OPENSPEC_MODEL_HIGH=z-ai/glm-5.1   # removed: ladder decides
# SPEC_MODE_SPECKIT_MODEL=z-ai/glm-5.1   # removed: ladder decides
# SPEC_MODE_SPECKIT_MODEL_HIGH=z-ai/glm-5.1   # removed: ladder decides
# SPEC_MODE_MODEL=z-ai/glm-5.1   # removed: ladder decides
SPEC_PASS_BLOCK_ON_TIMEOUT=true
# RUNCLAUDE_TIMEOUT_MS is deliberately NOT set. It is the operator's force-override and wins over
# everything, so setting it here held one number over all 36 seams — each of which declares the
# budget its own work needs. 76031b1 made those declarations live; a line here kept them dead for
# this project. Set it temporarily to debug a hang; leaving it set makes every declaration
# documentation.
SPEC_MODE_MAX_OUTPUT_TOKENS=16384
SPEC_AGENT_MAX_RETRIES=2

# LADDER PINS MOVED TO llm-settings.json 2026-08-25 (B6). The ladder design post-dates this
# project and it was never migrated; the engine kept honouring these pins, so nothing failed
# and the drift stayed invisible. A committed pin is a SECOND HOME for a declaration and
# outranks it (model-ladders.sh: an already-set chain wins), which would have given this
# project PARTIAL inheritance the moment the base declared ladders. The runtime operator
# override is unaffected — only the committed pin is gone.
# ── Model ladder ──────────────────────────────────────────────────────────────
# BUG fixed (2026-07-05): kimi-k2 had no ladder entry, so stories assigned to
# it never escalated at R2 — they exhausted all 8 attempts on the same model.
# Confirmed: SKY-003 repeated the identical trivial mistake across every rung.
# EPAM_MODEL_LADDER_MEDIUM="MiniMax-M2.5=MiniMax-M3|MiniMax-M3=z-ai/glm-5.2|zhipuai/glm-z1-32b=z-ai/glm-5.2|zhipuai/glm-z1-9b=z-ai/glm-5.2"   # moved to llm-settings.json
# EPAM_MODEL_LADDER_HIGH="MiniMax-M2.5=MiniMax-M3|MiniMax-M3=z-ai/glm-5.1|zhipuai/glm-z1-32b=z-ai/glm-5.1|zhipuai/glm-z1-9b=z-ai/glm-5.1|z-ai/glm-5.2=z-ai/glm-5.1|z-ai/glm-5.1=moonshotai/kimi-k3"   # moved to llm-settings.json
# kimi-k3: HIGH-tier ceiling above glm-5.1. Only reached when a story exhausts
# all glm-5.1 retries (Rung3 max-effort). $3/M input/$15/M output — 2 retries max.
EPAM_MODEL_LADDER=
# EPAM_FINAL_FALLBACK_MODEL=moonshotai/kimi-k3   # moved to config.openrouter.env
# EPAM_FINAL_FALLBACK_PROVIDER=openrouter   # moved to config.openrouter.env

# ── Provider routing ──────────────────────────────────────────────────────────
# Maps model vendor globs to provider names (consumed by resolve_model_provider()
# in claude.sh — zero vendor names hardcoded in the engine itself).
# EPAM_MODEL_PROVIDER_MAP="zhipuai/*=openrouter|moonshotai/*=openrouter|z-ai/*=openrouter|glm-*=openrouter|kimi-*=openrouter|deepseek/*=openrouter|MiniMax-*=minimax"   # moved to config.openrouter.env

# ── Runtime settings ──────────────────────────────────────────────────────────
MINIMAX_TOOL_TIMEOUT_MS=15000
# ORCH_MINI_MODEL=MiniMax-M2.5   # removed: ladder decides
# ORCH_UPGRADE_MODEL=MiniMax-M3   # removed: ladder decides
EPAM_RETRY_EXTENSION_ENABLED=1
EPAM_RETRY_EXTENSION_MAX=2
# Project default only — an explicit launch-time value wins (see metrolinx).
SKIP_REGRESSION_GUARD=true
EPAM_RALPH_WIGGUM_ENABLED=0
EPAM_STORY_TIMEOUT_SECS=600
EPAM_MAX_RETRIES=7
SKIP_BROWSER_E2E_ROUTING=true
