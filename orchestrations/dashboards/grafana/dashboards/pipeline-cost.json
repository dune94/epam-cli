{
  "uid": "epam-pipeline-cost",
  "title": "Pipeline Cost",
  "tags": ["epam-cli", "pipeline"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Total spend (this log window)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "P0666D91AE6B4D6B1" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://agent-monitor/logs-json/phase-cost.jsonl",
          "url_options": { "method": "GET", "data": "" },
          "format": "table",
          "parser": "backend",
          "root_selector": "",
          "columns": [
            { "selector": "task_cost_usd", "text": "cost", "type": "number" }
          ],
          "computed_columns": [],
          "filters": [],
          "summarizeExpression": "sum(cost)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Cost per call over time",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 18, "x": 6, "y": 0 },
