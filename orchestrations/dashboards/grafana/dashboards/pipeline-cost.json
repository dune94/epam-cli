          "parser": "backend",
          "root_selector": "",
          "columns": [
            { "selector": "started_at", "text": "time", "type": "timestamp" },
            { "selector": "task_cost_usd", "text": "cost", "type": "number" },
            { "selector": "agent_type", "text": "agent", "type": "string" }
          ]
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
