# Local Jira Docker environment variables.
# Copy to .env and fill in values after completing Jira setup wizard.

# Jira connection — local Docker
JIRA_URL=http://localhost:8080
JIRA_EMAIL=admin
JIRA_TOKEN=admin-password-set-during-setup

# Project to create/seed stories into
JIRA_PROJECT_KEY=SKY
JIRA_PROJECT_NAME=Skyscanner Mini-App

# Codeline repo paths (for multi-worktree routing)
JIRA_WORKTREE_BE=/home/bradleyjerome/projects/skyscanner-app
JIRA_WORKTREE_FE=/home/bradleyjerome/projects/skyscanner-app-frontend
