# ── Metrolinx Brownfield Pipeline Config ─────────────────────────────────────
# Usage: source orchestrations/jira/metrolinx.env && bash tier3-<runner>.sh
#
# Brownfield mode: EPAM_BROWNFIELD=1 activates no-teardown execution.
# Codelines are discovered at runtime from JIRA_CODELINE_ROOT by the
# codeline-discovery agent — no JIRA_CODELINES or JIRA_WORKTREE_* needed here.

# ── Pipeline mode ──────────────────────────────────────────────────────────
JIRA_PIPELINE=1
EPAM_BROWNFIELD=1
CODEGRAPH_ENABLED=1
SEMBLE_ENABLED=0

# ── Jira connection ────────────────────────────────────────────────────────
JIRA_URL=https://metrolinx.atlassian.net
JIRA_EMAIL=v-bradley.jerome@metrolinx.com
JIRA_TOKEN=ATATT3xFfGF0uAq_at6iCs0l-Cq35esdSTa3T3kHAYaNnwTLcYBWIad6fwOoojHoEbVZZI5RFrCE1bOynu0YwsNldws8DxXTbvx4eYbF77SARqDxHeiXBOR9tRQhwp5Y-rBnSIM8E1c6k6t58KxyRbnwLPkyvda2QV_RLCwyd6uoyF-35PWwkKo=E8AAE224
JIRA_PROJECT_KEY=AMSD
JIRA_BOARD_ID=
JIRA_JQL="issue = AMSD-1820"

# ── Brownfield codeline discovery ──────────────────────────────────────────
# Root directory containing all Metrolinx local repositories.
# codeline-discovery.js scans this directory, filters to git repos, and calls
# an LLM to match Jira tickets to the correct repo(s) at runtime.
JIRA_CODELINE_ROOT=/home/bradleyjerome/projects/metrolinx

# ── Baseline branch ────────────────────────────────────────────────────────
# The branch that represents the project's main line of development.
# Brownfield gate diff oracles (review-ranger, fuzz-weaver, etc.) diff the
# story's changes against this branch — not against HEAD~1 or a fresh git init.
# Metrolinx convention: develop is the integration branch (equivalent of main).
JIRA_BASELINE_BRANCH=develop

# ── Model ladder ──────────────────────────────────────────────────────────
ORCH_GATE_PROVIDER=qwen
EPAM_ORCHESTRATION_PROVIDER=qwen
ORCH_GATE_MODEL=z-ai/glm-5.2
ESCALATION_MODEL=z-ai/glm-5.2
ESCALATION_MODEL_HIGH=z-ai/glm-5.1
EPAM_TEMPERATURE=0
SPEC_MODE_PROVIDER=qwen
SPEC_MODE_OPENSPEC_MODEL=z-ai/glm-5.2
SPEC_MODE_OPENSPEC_MODEL_HIGH=z-ai/glm-5.1
SPEC_MODE_SPECKIT_MODEL=z-ai/glm-5.1
SPEC_MODE_SPECKIT_MODEL_HIGH=z-ai/glm-5.1
SPEC_MODE_MODEL=z-ai/glm-5.2
SPEC_PASS_BLOCK_ON_TIMEOUT=true
RUNCLAUDE_TIMEOUT_MS=360000
SPEC_MODE_MAX_OUTPUT_TOKENS=6000
SPEC_AGENT_MAX_RETRIES=2
EPAM_MODEL_LADDER_MEDIUM="MiniMax-M2.5=MiniMax-M3|MiniMax-M3=z-ai/glm-5.2|zhipuai/glm-z1-32b=z-ai/glm-5.2|zhipuai/glm-z1-9b=z-ai/glm-5.2|moonshotai/kimi-k2=z-ai/glm-5.2"
EPAM_MODEL_LADDER_HIGH="MiniMax-M2.5=MiniMax-M3|MiniMax-M3=z-ai/glm-5.1|zhipuai/glm-z1-32b=z-ai/glm-5.1|zhipuai/glm-z1-9b=z-ai/glm-5.1|z-ai/glm-5.2=z-ai/glm-5.1|moonshotai/kimi-k2=z-ai/glm-5.1|z-ai/glm-5.1=moonshotai/kimi-k3"
EPAM_MODEL_LADDER=""
EPAM_FINAL_FALLBACK_MODEL=moonshotai/kimi-k2
EPAM_FINAL_FALLBACK_PROVIDER=qwen
EPAM_MODEL_PROVIDER_MAP="zhipuai/*=qwen|moonshotai/*=qwen|z-ai/*=qwen|glm-*=qwen|kimi-*=qwen|deepseek/*=qwen|MiniMax-*=minimax"
MINIMAX_TOOL_TIMEOUT_MS=15000
ORCH_MINI_MODEL=MiniMax-M2.5
ORCH_UPGRADE_MODEL=MiniMax-M3
EPAM_RETRY_EXTENSION_ENABLED=1
EPAM_RETRY_EXTENSION_MAX=2
SKIP_REGRESSION_GUARD=false
EPAM_RALPH_WIGGUM_ENABLED=0
EPAM_STORY_TIMEOUT_SECS=600
EPAM_GATE_TIMEOUT_SECS=1200
EPAM_MAX_RETRIES=7
SKIP_BROWSER_E2E_ROUTING=true
