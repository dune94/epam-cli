# Calculate phase-level totals
actual_minutes = sum(task.get('elapsed_minutes', 0) for task in tasks)
forecast_minutes = sum(task.get('forecast_hours', 0) * 60 for task in tasks)
actual_cost_usd = sum(task.get('actual_cost_usd', 0) for task in tasks)
forecast_cost_usd = sum(task.get('forecast_cost_usd', 0) for task in tasks)

