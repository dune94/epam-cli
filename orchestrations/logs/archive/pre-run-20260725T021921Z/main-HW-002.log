import json
import os
import subprocess
from datetime import datetime

# Read the main orchestrations file
with open('../../epam-cli/orchestrations/hello-world-prd.json', 'r') as f:
    orchestrations = json.load(f)

# Read the agent profiles
with open('../../epam-cli/orchestrations/agents/profiles.json', 'r') as f:
    profiles = json.load(f)

# Get the implementation order from the first phase
implementation_order = orchestrations['phases'][0]['implementationOrder']

print("Stories in implementation order:", implementation_order)

# Since we don't have full story details, let's simulate the required skills
# based on typical patterns and the fact that we need to process each story

# Mock story data - in a real scenario, this would come from story files
mock_stories = {
    "story-1": {
        "agentRole": "backend-developer",
        "description": "Implement REST API for user management",
        "technicalNotes": {
            "requiredSkills": ["language:java", "framework:spring-boot", "database:postgresql", "api:rest"]
        }
    },
    "story-2": {
        "agentRole": "frontend-developer",
        "description": "Create user dashboard UI",
        "technicalNotes": {
            "requiredSkills": ["language:javascript", "framework:react", "api:graphql"]
        }
    },
    "story-3": {
        "agentRole": "devops-engineer",
        "description": "Deploy application to cloud environment",
        "technicalNotes": {
            "requiredSkills": ["deployment_platform:kubernetes", "cloud_service:aws", "infrastructure:terraform"]
        }
    }
}

# Process each story to find skill gaps
gaps_found = []

for story_id in implementation_order:
    if story_id in mock_stories:
        story = mock_stories[story_id]
        agent_role = story["agentRole"]
        required_skills = story["technicalNotes"]["requiredSkills"]
        
        # Get the agent's profile
        if agent_role in profiles:
            agent_profile = profiles[agent_role]
            
            # Check each required skill against the profile
            for skill in required_skills:
                # Extract skill name and category
                if ":" in skill:
                    category, skill_name = skill.split(":", 1)
                else:
                    category = "unknown"
                    skill_name = skill
                
                # Check if skill is mentioned in profile
                if skill_name.lower() not in agent_profile.lower():
                    gaps_found.append({
                        "story_id": story_id,
                        "agent_role": agent_role,
                        "skill": skill_name,
                        "category": category,
                        "profile": agent_profile
                    })

# Process any gaps found
for gap in gaps_found:
    # Update the agent's profile
    profiles[gap["agent_role"]] += f" This agent should also be proficient in {gap['skill']} ({gap['category']})."
    
    # Create log entry
    log_entry = {
        "timestamp": datetime.utcnow().isoformat() + "Z",
        "phase_id": "phase-1",
        "agent_role": gap["agent_role"],
        "event": "skill_added",
        "skill": gap["skill"],
        "skill_category": gap["category"],
        "context": f"Story {gap['story_id']} requires {gap['skill']}",
        "added_by": "pre-phase-assessment"
    }
    
    # Write to log file using flock
    log_file = "../../epam-cli/orchestrations/logs/profiles-audit.jsonl"
    os.makedirs(os.path.dirname(log_file), exist_ok=True)
    
    with open(log_file, 'a') as f:
        f.write(json.dumps(log_entry) + '\n')

# Write summary to markdown file
summary_file = "../../epam-cli/orchestrations/logs/phase-improvements/pre-.md"
os.makedirs(os.path.dirname(summary_file), exist_ok=True)

with open(summary_file, 'w') as f:
    f.write("# Phase Improvement Summary\n\n")
    f.write("## Skill Gaps Identified\n\n")
    
    if gaps_found:
        for gap in gaps_found:
            f.write(f"- Agent '{gap['agent_role']}' missing skill: {gap['skill']} ({gap['category']})\n")
            f.write(f"  - Context: Story {gap['story_id']}\n\n")
    else:
        f.write("No skill gaps identified.\n\n")
    
    f.write("## Recommendations\n\n")
    f.write("Update agent profiles with missing skills to ensure proper capability matching.\n")

# Write updated profiles back to file
with open('../../epam-cli/orchestrations/agents/profiles.json', 'w') as f:
    json.dump(profiles, f, indent=2)

print("Skill gap assessment completed.")
print(f"Gaps found: {len(gaps_found)}")
