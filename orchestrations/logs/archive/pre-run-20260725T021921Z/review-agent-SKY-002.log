import { describe, it, expect, vi, afterEach } from 'vitest';
import { SkyscannerClient, SearchParams, FlightResult } from './client.js';

const MOCK_API_KEY = 'test-rapidapi-key-12345';

const VALID_RESPONSE = {
  Currencies: [{ Code: 'USD', Symbol: '$', ThousandsSeparator: ',', DecimalSeparator: '.', DecimalDigits: 2 }],
  Places: [
    { PlaceId: 1, Name: 'New York', Type: 'Station', SkyscannerCode: 'JFK' },
    { PlaceId: 2, Name: 'London', Type: 'Station', SkyscannerCode: 'LHR' },
  ],
  Carriers: [
    { CarrierId: 100, Name: 'British Airways' },
    { CarrierId: 101, Name: 'Virgin Atlantic' },
  ],
  Quotes: [
    {
      QuoteId: 1,
      MinPrice: 450,
      Direct: true,
      OutboundLeg: {
        CarrierIds: [100],
        OriginId: 1,
        DestinationId: 2,
        DepartureDate: '2025-01-15T00:00:00',
      },
      InboundLeg: {
        CarrierIds: [100],
        OriginId: 2,
        DestinationId: 1,
        DepartureDate: '2025-01-22T00:00:00',
      },
      QuoteDateTime: '2025-01-10T00:00:00',
    },
    {
      QuoteId: 2,
      MinPrice: 380,
      Direct: false,
      OutboundLeg: {
        CarrierIds: [100, 101],
        OriginId: 1,
        DestinationId: 2,
        DepartureDate: '2025-01-16T00:00:00',
      },
      InboundLeg: {
        CarrierIds: [101],
        OriginId: 2,
        DestinationId: 1,
        DepartureDate: '2025-01-23T00:00:00',
      },
      QuoteDateTime: '2025-01-10T00:00:00',
    },
  ],
};

function createMockFetch(response: { ok: boolean; status: number; json: () => Promise<unknown> }) {
  return vi.fn().mockResolvedValue(response);
}

describe('SkyscannerClient', () => {
  afterEach(() => {
    vi.restoreAllMocks();
    vi.unstubAllGlobals();
  });

  describe('constructor', () => {
    it('throws a descriptive Error when no apiKey is provided and RAPIDAPI_KEY env var is unset', () => {
      const originalEnv = process.env.RAPIDAPI_KEY;
      delete process.env.RAPIDAPI_KEY;
      try {
        expect(() => new SkyscannerClient({ apiKey: undefined })).toThrow(
          /requires an API key.*RAPIDAPI_KEY/i
        );
      } finally {
        if (originalEnv !== undefined) process.env.RAPIDAPI_KEY = originalEnv;
      }
    });

    it('throws the same missing-key Error when apiKey is an empty string', () => {
      const originalEnv = process.env.RAPIDAPI_KEY;
      delete process.env.RAPIDAPI_KEY;
      try {
        expect(() => new SkyscannerClient({ apiKey: '' })).toThrow(
          /requires an API key.*RAPIDAPI_KEY/i
        );
      } finally {
        if (originalEnv !== undefined) process.env.RAPIDAPI_KEY = originalEnv;
      }
    });

    it('throws the missing-key Error when RAPIDAPI_KEY env var is an empty string and no apiKey is provided', () => {
      const originalEnv = process.env.RAPIDAPI_KEY;
      process.env.RAPIDAPI_KEY = '';
      try {
        expect(() => new SkyscannerClient({})).toThrow(
          /requires an API key.*RAPIDAPI_KEY/i
        );
      } finally {
        if (originalEnv !== undefined) process.env.RAPIDAPI_KEY = originalEnv;
        else delete process.env.RAPIDAPI_KEY;
      }
    });

    it('constructor-provided apiKey takes precedence over RAPIDAPI_KEY env var', () => {
      const originalEnv = process.env.RAPIDAPI_KEY;
      process.env.RAPIDAPI_KEY = 'env-key-should-be-ignored';
      try {
        const client = new SkyscannerClient({ apiKey: MOCK_API_KEY });
        // We can't directly read #apiKey, but we can verify it works by
        // making a fetch call and checking the header value
        const mockFetch = createMockFetch({
          ok: true,
          status: 200,
          json: () => Promise.resolve(VALID_RESPONSE),
        });
        vi.stubGlobal('fetch', mockFetch);
        client.searchFlights({ origin: 'JFK', destination: 'LHR', date: '2025-01-15' });
        expect(mockFetch).toHaveBeenCalledWith(
          expect.any(String),
          expect.objectContaining({
            headers: expect.objectContaining({
              'X-RapidAPI-Key': MOCK_API_KEY,
            }),
          })
        );
      } finally {
        if (originalEnv !== undefined) process.env.RAPIDAPI_KEY = originalEnv;
        else delete process.env.RAPIDAPI_KEY;
      }
    });

    it('uses RAPIDAPI_KEY env var when no apiKey is provided to constructor', () => {
      const originalEnv = process.env.RAPIDAPI_KEY;
      process.env.RAPIDAPI_KEY = 'env-key-value';
      try {
        const client = new SkyscannerClient({});
        const mockFetch = createMockFetch({
          ok: true,
          status: 200,
          json: () => Promise.resolve(VALID_RESPONSE),
        });
        vi.stubGlobal('fetch', mockFetch);
        client.searchFlights({ origin: 'JFK', destination: 'LHR', date: '2025-01-15' });
        expect(mockFetch).toHaveBeenCalledWith(
          expect.any(String),
          expect.objectContaining({
            headers: expect.objectContaining({
              'X-RapidAPI-Key': 'env-key-value',
            }),
          })
        );
      } finally {
        if (originalEnv !== undefined) process.env.RAPIDAPI_KEY = originalEnv;
        else delete process.env.RAPIDAPI_KEY;
      }
    });
  });

  describe('searchFlights', () => {
    it('constructs the correct RapidAPI URL and headers', async () => {
      const client = new SkyscannerClient({ apiKey: MOCK_API_KEY });
      const mockFetch = createMockFetch({
        ok: true,
        status: 200,
        json: () => Promise.resolve(VALID_RESPONSE),
      });
      vi.stubGlobal('fetch', mockFetch);

      await client.searchFlights({ origin: 'JFK', destination: 'LHR', date: '2025-01-15', adults: 2 });

      expect(mockFetch).toHaveBeenCalledWith(
        expect.stringContaining('/US/USD/en-US/JFK/LHR/2025-01-15'),
        expect.objectContaining({
          method: 'GET',
          headers: expect.objectContaining({
            'X-RapidAPI-Host': 'skyscanner-skyscanner-flight-search-v1.p.rapidapi.com',
            'X-RapidAPI-Key': MOCK_API_KEY,
          }),
        })
      );
      expect(mockFetch.mock.calls[0][0]).toContain('adults=2');
    });

    it('parses a successful response into FlightResult[]', async () => {
      const client = new SkyscannerClient({ apiKey: MOCK_API_KEY });
      const mockFetch = createMockFetch({
        ok: true,
        status: 200,
        json: () => Promise.resolve(VALID_RESPONSE),
      });
      vi.stubGlobal('fetch', mockFetch);

      const results = await client.searchFlights({ origin: 'JFK', destination: 'LHR', date: '2025-01-15' });

      expect(results).toHaveLength(2);
      expect(results[0]).toEqual({
        price: 450,
        currency: 'USD',
        airline: 'British Airways',
        departure: '2025-01-15T00:00:00',
        arrival: '2025-01-15T00:00:00',
        duration: 0,
        stops: 0,
      });
      expect(results[1]).toEqual({
        price: 380,
        currency: 'USD',
        airline: 'British Airways, Virgin Atlantic',
        departure: '2025-01-16T00:00:00',
        arrival: '2025-01-16T00:00:00',
        duration: 0,
        stops: 1,
      });
    });

    it('rejects with an Error including the HTTP status code on 4xx/5xx', async () => {
      const client = new SkyscannerClient({ apiKey: MOCK_API_KEY });
      const mockFetch = createMockFetch({
        ok: false,
        status: 429,
        json: () => Promise.resolve({}),
      });
      vi.stubGlobal('fetch', mockFetch);

      await expect(
        client.searchFlights({ origin: 'JFK', destination: 'LHR', date: '2025-01-15' })
      ).rejects.toThrow(/HTTP status 429/);
    });

    it('rejects with a descriptive parse/validation Error when response body is malformed', async () => {
      const client = new SkyscannerClient({ apiKey: MOCK_API_KEY });
      const mockFetch = createMockFetch({
        ok: true,
        status: 200,
        json: () => Promise.resolve({ unexpected: 'shape' }),
      });
      vi.stubGlobal('fetch', mockFetch);

      await expect(
        client.searchFlights({ origin: 'JFK', destination: 'LHR', date: '2025-01-15' })
      ).rejects.toThrow(/missing or invalid/i);
    });

    it('rejects with a parse Error when response body is not valid JSON', async () => {
      const client = new SkyscannerClient({ apiKey: MOCK_API_KEY });
      const mockFetch = vi.fn().mockResolvedValue({
        ok: true,
        status: 200,
        json: () => Promise.reject(new SyntaxError('Unexpected token')),
      });
      vi.stubGlobal('fetch', mockFetch);

      await expect(
        client.searchFlights({ origin: 'JFK', destination: 'LHR', date: '2025-01-15' })
      ).rejects.toThrow(/Failed to parse Skyscanner API response as JSON/);
    });
  });

  describe('apiKey security', () => {
    it('error message on HTTP failure does not include the apiKey value', async () => {
      const client = new SkyscannerClient({ apiKey: MOCK_API_KEY });
      const mockFetch = createMockFetch({
        ok: false,
        status: 500,
        json: () => Promise.resolve({}),
      });
      vi.stubGlobal('fetch', mockFetch);

      try {
        await client.searchFlights({ origin: 'JFK', destination: 'LHR', date: '2025-01-15' });
        expect.unreachable('Should have thrown');
      } catch (err) {
        const message = (err as Error).message;
        expect(message).not.toContain(MOCK_API_KEY);
      }
    });
  });
});
