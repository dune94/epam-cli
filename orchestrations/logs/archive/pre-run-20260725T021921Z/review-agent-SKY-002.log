import { URL } from 'node:url';

/** RapidAPI host for Skyscanner */
const SKYSCANNER_API_HOST = 'skyscanner-skyscanner-flight-search-v1.p.rapidapi.com';
/** Base URL for Skyscanner browse quotes endpoint */
const SKYSCANNER_BROWSE_QUOTES_URL = `https://${SKYSCANNER_API_HOST}/apiservices/browsequotes/v1.0`;

export interface SearchParams {
  origin: string;
  destination: string;
  date: string;
  adults?: number;
}

export interface FlightResult {
  price: number;
  currency: string;
  airline: string;
  departure: string;
  arrival: string;
  duration: number;
  stops: number;
}

export class SkyscannerClient {
  #apiKey: string;

  constructor({ apiKey }: { apiKey?: string }) {
    const resolved = apiKey ?? process.env.RAPIDAPI_KEY;
    if (!resolved || resolved === '') {
      throw new Error(
        'SkyscannerClient requires an API key. Pass apiKey to the constructor or set the RAPIDAPI_KEY environment variable.'
      );
    }
    this.#apiKey = resolved;
  }

  async searchFlights(params: SearchParams): Promise<FlightResult[]> {
    const { origin, destination, date, adults } = params;
    const url = new URL(`${SKYSCANNER_BROWSE_QUOTES_URL}/US/USD/en-US/${origin}/${destination}/${date}`);
    if (adults !== undefined) {
      url.searchParams.set('adults', String(adults));
    }

    const response = await fetch(url.toString(), {
      method: 'GET',
      headers: {
        'X-RapidAPI-Host': SKYSCANNER_API_HOST,
        'X-RapidAPI-Key': this.#apiKey,
      },
    });

    if (!response.ok) {
      throw new Error(
        `Skyscanner API request failed with HTTP status ${response.status}`
      );
    }

    let body: unknown;
    try {
      body = await response.json();
    } catch (parseErr) {
      throw new Error(
        `Failed to parse Skyscanner API response as JSON: ${(parseErr as Error).message}`
      );
    }

    return this.validateAndMapResults(body);
  }

  private validateAndMapResults(body: unknown): FlightResult[] {
    if (body === null || body === undefined || typeof body !== 'object') {
      throw new Error('Skyscanner API response body is not a valid object');
    }

    const raw = body as Record<string, unknown>;
    const quotes = raw.Quotes;
    const places = raw.Places;
    const carriers = raw.Carriers;
    const currencies = raw.Currencies;

    if (!Array.isArray(quotes)) {
      throw new Error('Skyscanner API response missing or invalid "Quotes" array');
    }
    if (!Array.isArray(places)) {
      throw new Error('Skyscanner API response missing or invalid "Places" array');
    }
    if (!Array.isArray(carriers)) {
      throw new Error('Skyscanner API response missing or invalid "Carriers" array');
    }
    if (!Array.isArray(currencies)) {
      throw new Error('Skyscanner API response missing or invalid "Currencies" array');
    }

    const placeMap = new Map<number, string>();
    for (const place of places) {
      if (typeof place !== 'object' || place === null) continue;
      const p = place as Record<string, unknown>;
      const placeId = p.PlaceId;
      const name = p.Name;
      if (typeof placeId === 'number' && typeof name === 'string') {
        placeMap.set(placeId, name);
      }
    }

    const carrierMap = new Map<number, string>();
    for (const carrier of carriers) {
      if (typeof carrier !== 'object' || carrier === null) continue;
      const c = carrier as Record<string, unknown>;
      const carrierId = c.CarrierId;
      const name = c.Name;
      if (typeof carrierId === 'number' && typeof name === 'string') {
        carrierMap.set(carrierId, name);
      }
    }

    const currencyCode = Array.isArray(currencies) && currencies.length > 0
      ? (currencies[0] as Record<string, unknown>)?.Code
      : undefined;
    if (typeof currencyCode !== 'string') {
      throw new Error('Skyscanner API response missing or invalid currency code');
    }

    const results: FlightResult[] = [];
    for (const quote of quotes) {
      if (typeof quote !== 'object' || quote === null) continue;
      const q = quote as Record<string, unknown>;
      const minPrice = q.MinPrice;
      const originId = q.OutboundLeg?.OriginId;
      const destId = q.OutboundLeg?.DestinationId;
      const departureDate = q.OutboundLeg?.DepartureDate;
      const carrierIds: unknown[] = q.OutboundLeg?.CarrierIds ?? [];

      if (typeof minPrice !== 'number') {
        throw new Error('Skyscanner API response quote missing or invalid "MinPrice"');
      }
      if (typeof originId !== 'number') {
        throw new Error('Skyscanner API response quote missing or invalid OutboundLeg.OriginId');
      }
      if (typeof destId !== 'number') {
        throw new Error('Skyscanner API response quote missing or invalid OutboundLeg.DestinationId');
      }
      if (typeof departureDate !== 'string') {
        throw new Error('Skyscanner API response quote missing or invalid OutboundLeg.DepartureDate');
      }

      const airlineNames = carrierIds
        .filter((id): id is number => typeof id === 'number')
        .map((id) => carrierMap.get(id))
        .filter((name): name is string => typeof name === 'string');

      results.push({
        price: minPrice,
        currency: currencyCode,
        airline: airlineNames.join(', ') || 'Unknown',
        departure: departureDate,
        arrival: departureDate,
        duration: 0,
        stops: carrierIds.length > 1 ? carrierIds.length - 1 : 0,
      });
    }

    return results;
  }
}
