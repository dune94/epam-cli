import { SkyscannerClient, FlightResult } from './skyscanner-client';

const REQUIRED_FLAGS = ['--from', '--to', '--date'] as const;
const DATE_PATTERN = /^\d{4}-\d{2}-\d{2}$/;
const DEFAULT_CURRENCY_SYMBOL = '£';
const DEFAULT_ADULTS = 1;

interface ParsedArgs {
  from: string;
  to: string;
  date: string;
  adults: number;
}

function parseArgs(argv: string[]): ParsedArgs | { error: string; exitCode: number } {
  const args = argv.slice(2);
  const flags: Record<string, string | undefined> = {};

  for (let i = 0; i < args.length; i++) {
    if (args[i]?.startsWith('--')) {
      const key = args[i] as string;
      const value = args[i + 1];
      if (value === undefined || value.startsWith('--')) {
        return { error: `Missing value for ${key}`, exitCode: 2 };
      }
      flags[key] = value;
      i++;
    }
  }

  for (const flag of REQUIRED_FLAGS) {
    if (!flags[flag]) {
      return {
        error: `Missing required flag: ${flag}\nUsage: cli.ts --from <IATA> --to <IATA> --date <YYYY-MM-DD> [--adults <N>]`,
        exitCode: 2,
      };
    }
  }

  const from = flags['--from']!;
  const to = flags['--to']!;
  const date = flags['--date']!;

  if (!DATE_PATTERN.test(date)) {
    return {
      error: `Invalid --date format: "${date}". Expected YYYY-MM-DD.`,
      exitCode: 2,
    };
  }

  let adults: number = DEFAULT_ADULTS;
  const adultsStr = flags['--adults'];
  if (adultsStr !== undefined) {
    const parsed = Number(adultsStr);
    if (!Number.isInteger(parsed) || parsed <= 0) {
      return {
        error: `Invalid --adults value: "${adultsStr}". Expected a positive integer.`,
        exitCode: 2,
      };
    }
    adults = parsed;
  }

  return { from, to, date, adults };
}

function padLeft(str: string, width: number): string {
  return str.padStart(width);
}

function padRight(str: string, width: number): string {
  return str.padEnd(width);
}

function renderTable(flights: FlightResult[], currencySymbol: string): string {
  const headers = ['Airline', 'Price', 'Departure', 'Arrival', 'Duration', 'Stops'];
  const colWidths = headers.map((h, i) => {
    const headerWidth = h.length;
    const dataWidths = flights.map((f) => {
      const val = formatValue(f, i, currencySymbol);
      return val.length;
    });
    return Math.max(headerWidth, ...dataWidths);
  });

  const lines: string[] = [];

  // Header row
  const headerLine = headers
    .map((h, i) => (i === 1 ? padLeft(h, colWidths[i]!) : padRight(h, colWidths[i]!)))
    .join(' | ');
  lines.push(headerLine);

  // Separator row
  const separatorLine = colWidths.map((w) => '-'.repeat(w)).join(' | ');
  lines.push(separatorLine);

  // Data rows
  for (const flight of flights) {
    const row = headers
      .map((_, i) => {
        const val = formatValue(flight, i, currencySymbol);
        return i === 1 ? padLeft(val, colWidths[i]!) : padRight(val, colWidths[i]!);
      })
      .join(' | ');
    lines.push(row);
  }

  return lines.join('\n');
}

function formatValue(flight: FlightResult, colIndex: number, currencySymbol: string): string {
  switch (colIndex) {
    case 0:
      return flight.airline;
    case 1:
      return `${currencySymbol}${flight.price}`;
    case 2:
      return flight.departure;
    case 3:
      return flight.arrival;
    case 4:
      return flight.duration;
    case 5:
      return String(flight.stops);
    default:
      return '';
  }
}

async function main(): Promise<void> {
  const apiKey = process.env.RAPIDAPI_KEY;
  if (!apiKey || apiKey.trim() === '') {
    process.stderr.write('Error: RAPIDAPI_KEY environment variable is not set.\n');
    process.exit(1);
  }

  const parsed = parseArgs(process.argv);
  if ('error' in parsed) {
    process.stderr.write(`${parsed.error}\n`);
    process.exit(parsed.exitCode);
  }

  const client = new SkyscannerClient(apiKey);
  try {
    const results = await client.searchFlights(parsed.from, parsed.to, parsed.date, parsed.adults);
    if (results.length === 0) {
      process.stdout.write('No flights found.\n');
      process.exit(0);
    }
    const currencySymbol = (results as any).currencySymbol ?? DEFAULT_CURRENCY_SYMBOL;
    const table = renderTable(results, currencySymbol);
    process.stdout.write(`${table}\n`);
  } catch (err: unknown) {
    const message = err instanceof Error ? err.message : String(err);
    process.stderr.write(`${message}\n`);
    process.exit(1);
  }
}

main();
