import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { FlightResult } from './skyscanner-client';

vi.mock('./skyscanner-client', () => {
  const mockSearchFlights = vi.fn();
  return {
    SkyscannerClient: vi.fn().mockImplementation(() => ({
      searchFlights: mockSearchFlights,
    })),
    FlightResult: undefined,
    __mockSearchFlights: mockSearchFlights,
  };
});

let mockSearchFlights: ReturnType<typeof vi.fn>;

describe('cli', () => {
  let originalExit: typeof process.exit;
  let originalStdout: typeof process.stdout.write;
  let originalStderr: typeof process.stderr.write;
  let exitCode: number | undefined;
  let stdoutOutput: string;
  let stderrOutput: string;

  beforeEach(() => {
    vi.resetModules();
    vi.restoreAllMocks();

    originalExit = process.exit;
    originalStdout = process.stdout.write;
    originalStderr = process.stderr.write;

    exitCode = undefined;
    stdoutOutput = '';
    stderrOutput = '';

    process.exit = ((code?: number) => {
      exitCode = code ?? 0;
      throw new Error(`PROCESS_EXIT_${code}`);
    }) as typeof process.exit;

    process.stdout.write = ((data: string | Buffer) => {
      stdoutOutput += String(data);
      return true;
    }) as typeof process.stdout.write;

    process.stderr.write = ((data: string | Buffer) => {
      stderrOutput += String(data);
      return true;
    }) as typeof process.stderr.write;

    process.env.RAPIDAPI_KEY = 'test-api-key';
  });

  afterEach(() => {
    process.exit = originalExit;
    process.stdout.write = originalStdout;
    process.stderr.write = originalStderr;
    delete process.env.RAPIDAPI_KEY;
  });

  async function runCli(args: string[]): Promise<void> {
    process.argv = ['node', 'cli.js', ...args];
    try {
      await import('./cli');
    } catch (e: unknown) {
      if (e instanceof Error && e.message.startsWith('PROCESS_EXIT_')) {
        return;
      }
      throw e;
    }
  }

  it('exits with code 2 when --from is missing', async () => {
    await runCli(['--to', 'LHR', '--date', '2025-01-01']);
    expect(exitCode).toBe(2);
    expect(stderrOutput).toContain('--from');
    expect(stdoutOutput).toBe('');
  });

  it('exits with code 2 when --to is missing', async () => {
    await runCli(['--from', 'JFK', '--date', '2025-01-01']);
    expect(exitCode).toBe(2);
    expect(stderrOutput).toContain('--to');
    expect(stdoutOutput).toBe('');
  });

  it('exits with code 2 when --date is missing', async () => {
    await runCli(['--from', 'JFK', '--to', 'LHR']);
    expect(exitCode).toBe(2);
    expect(stderrOutput).toContain('--date');
    expect(stdoutOutput).toBe('');
  });

  it('exits with code 2 when --date format is invalid', async () => {
    await runCli(['--from', 'JFK', '--to', 'LHR', '--date', '01-01-2025']);
    expect(exitCode).toBe(2);
    expect(stderrOutput).toContain('date');
    expect(stdoutOutput).toBe('');
  });

  it('exits with code 2 when --adults is invalid', async () => {
    await runCli(['--from', 'JFK', '--to', 'LHR', '--date', '2025-01-01', '--adults', 'abc']);
    expect(exitCode).toBe(2);
    expect(stderrOutput).toContain('adults');
    expect(stdoutOutput).toBe('');
  });

  it('exits with code 1 when RAPIDAPI_KEY is missing', async () => {
    delete process.env.RAPIDAPI_KEY;
    await runCli(['--from', 'JFK', '--to', 'LHR', '--date', '2025-01-01']);
    expect(exitCode).toBe(1);
    expect(stderrOutput).toContain('RAPIDAPI_KEY');
    expect(stdoutOutput).toBe('');
  });

  it('renders table correctly for valid multi-row results', async () => {
    const flights: FlightResult[] = [
      { airline: 'British Airways', price: 199, departure: '10:00', arrival: '22:00', duration: '12h', stops: 0 },
      { airline: 'Delta', price: 250, departure: '08:00', arrival: '20:00', duration: '12h', stops: 1 },
    ];
    const { SkyscannerClient } = await import('./skyscanner-client');
    const inst = new SkyscannerClient('key');
    mockSearchFlights = (inst as any).searchFlights;
    mockSearchFlights.mockResolvedValue(Object.assign(flights, { currencySymbol: '£' }));

    await runCli(['--from', 'JFK', '--to', 'LHR', '--date', '2025-01-01', '--adults', '2']);
    expect(exitCode).toBeUndefined();
    expect(stdoutOutput).toContain('Airline');
    expect(stdoutOutput).toContain('Price');
    expect(stdoutOutput).toContain('British Airways');
    expect(stdoutOutput).toContain('£199');

    // Verify separator row
    const lines = stdoutOutput.trim().split('\n');
    expect(lines.length).toBeGreaterThanOrEqual(3);
    const separatorLine = lines[1]!;
    const separatorSegments = separatorLine.split(' | ');
    const headerLine = lines[0]!;
    const headerSegments = headerLine.split(' | ');
    expect(separatorSegments.length).toBe(6);
    for (let i = 0; i < separatorSegments.length; i++) {
      expect(separatorSegments[i]!.length).toBe(headerSegments[i]!.length);
    }

    // Verify Price column is right-aligned
    const dataLine = lines[2]!;
    const dataSegments = dataLine.split(' | ');
    const priceSegment = dataSegments[1]!;
    expect(priceSegment).toMatch(/^\s*£/);
  });

  it('renders "No flights found." for empty results', async () => {
    const { SkyscannerClient } = await import('./skyscanner-client');
    const inst = new SkyscannerClient('key');
    mockSearchFlights = (inst as any).searchFlights;
    mockSearchFlights.mockResolvedValue([]);

    await runCli(['--from', 'JFK', '--to', 'LHR', '--date', '2025-01-01']);
    expect(stdoutOutput.trim()).toBe('No flights found.');
  });

  it('writes error message to stderr and exits 1 when client throws', async () => {
    const { SkyscannerClient } = await import('./skyscanner-client');
    const inst = new SkyscannerClient('key');
    mockSearchFlights = (inst as any).searchFlights;
    mockSearchFlights.mockRejectedValue(new Error('API rate limit exceeded'));

    await runCli(['--from', 'JFK', '--to', 'LHR', '--date', '2025-01-01']);
    expect(exitCode).toBe(1);
    expect(stderrOutput).toContain('API rate limit exceeded');
    expect(stdoutOutput).toBe('');
  });
});
