<tool_result>
import nodeFetch from 'node-fetch';

const SKYSCANNER_API_HOST = 'skyscanner-skyscanner-flight-search-v1.p.rapidapi.com';
const SKYSCANNER_SEARCH_ENDPOINT = '/services/reference/v1.0/currencies';

export interface FlightResult {
  airline: string;
  price: number;
  departure: string;
  arrival: string;
  duration: string;
  stops: number;
}

export interface SearchFlightsResponse {
  flights: FlightResult[];
  currencySymbol?: string;
}

export class SkyscannerClient {
  private apiKey: string;
  private readonly host = SKYSCANNER_API_HOST;

  constructor(apiKey: string) {
    this.apiKey = apiKey;
  }

  async searchFlights(
    from: string,
    to: string,
    date: string,
    adults: number = 1,
  ): Promise<FlightResult[]> {
    const url = `https://${this.host}/services/reference/v1.0/homesearch/${from}/${to}/${date}`;
    const response = await nodeFetch(url, {
      method: 'GET',
      headers: {
        'X-RapidAPI-Key': this.apiKey,
        'X-RapidAPI-Host': this.host,
      },
    });

    if (!response.ok) {
      throw new Error(`Skyscanner API error: ${response.status} ${response.statusText}`);
    }

    const data = (await response.json()) as SearchFlightsResponse;
    const flights = data.flights ?? [];
    const result = flights as FlightResult[];
    (result as any).currencySymbol = data.currencySymbol ?? '£';
    return result;
  }
}
