import type {
  MozioOrder,
  MozioSubmittedOrder,
} from '~/clients/mozio/models/mozio-order';

export function isSubmittedOrder(
  order: MozioOrder,
): order is MozioSubmittedOrder {
  return (
    'number' in order &&
    typeof order.number == 'string' &&
    'dispatches' in order &&
    !!order.dispatches
  );
}

