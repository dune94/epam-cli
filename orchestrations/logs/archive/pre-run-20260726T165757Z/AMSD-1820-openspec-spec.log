// src/clients/mozio/helpers/mozio-order-type-guards.ts (lines 1–15, relevance: 0.0142)
import type {
  MozioOrder,
  MozioSubmittedOrder,
} from '~/clients/mozio/models/mozio-order';

export function isSubmittedOrder(
  order: MozioOrder,
): order is MozioSubmittedOrder {
  return (
    'number' in order &&
    typeof order.number == 'string' &&
    'dispatches' in order &&
    !!order.dispatches
  );
}

