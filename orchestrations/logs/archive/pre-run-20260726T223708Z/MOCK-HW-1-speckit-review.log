      "description": "Update the test in src/hello.test.ts to expect getGreeting() to return 'hello dolly' instead of 'hello world'.",
      "acceptanceCriteria": [
        "The test for getGreeting expects the return value 'hello dolly'"
      ],
      "dependencies": [
        "MOCK-HW-1-impl"
      ],
      "agentRole": "test-engineer"
    }
  ]
}

