// src/services/up-api/departures/get-go-transit-departures/getGoTransitDepartures.ts (lines 36–55, relevance: 0.0092)
export const getGoTransitDepartures = async (
  payload: IGetGoTransitDeparturesPayload,
): Promise<IGetGoTransitDeparturesResponse> => {
  const url = getGoTransitDeparturesApiUrl(payload);

  const response = await fetch(url, {
    headers: getRequestHeaders({
      subscriptionKey: publicEnv.UP_API_APIM_SUBSCRIPTION_KEY,
      versionLabel: publicEnv.UP_API_VERSION_LABEL,
    }),
  });

  if (!response.ok) {
    throw new HttpError("Failed to fetch GO Transit departures", {
      status: response.status,
    });
  }

  return response.json();
};


