import { Schema } from "@contentstack/management/types/stack/contentType";
import { client } from "../../client";

export async function updateContentCardsComponentV1() {
  const globalField = await client.fetchGlobalField("content_cards_component");
  const contentCards = globalField.schema.find((field: Schema) => field.uid === "content_cards");
  const internalLinks = contentCards.schema.find(
    (field: Schema) => field.uid === "content_card_internal_link",
  );

  internalLinks.reference_to.push("campaign_page", "blog_listing_page");

  await globalField.update();
}

