const ContentstackAbPromoSignUpBanner: FC<IContentstackAbPromoSignUpBannerProps> = ({
  contentKey = "",
}) => {
  const { getContentByKey } = useContent();
  const locale = useContentstackLocale();

  const promoSignUpBannerModel = getContentByKey<
    IAbTestableComponentModel<IPromoSignupBanner> | undefined
  >(contentKey, undefined);

  const memoizedMapContentToComponentProps = useCallback(
    (model: IPromoSignupBanner) => mapContentToComponentProps(model, locale),
    [locale],
  );

  if (!promoSignUpBannerModel) return null;

  return (
    <AbTestWrapper<IPromoSignupBanner, IProps>
      model={promoSignUpBannerModel}
      mapContentToComponentProps={memoizedMapContentToComponentProps}
      component={Component}
    />
  );
};


