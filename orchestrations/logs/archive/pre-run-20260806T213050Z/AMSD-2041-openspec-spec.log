4	import { cn } from "@metrolinx/cx-shared/build/src/utils/cn";
5	import CustomLink from "components/CustomLink/CustomLink";
6	import { Image } from "components/Image";
7	import { useNextLocale } from "hooks/useNextLocale";
8	import { IContentCard } from "interface/content/news";
9	import { getMetaDataInfoBasedOnLocale } from "utils/common";
10	import { getLocaleByNextLocale } from "utils/locale";
11	
12	export interface IContentCardProps extends IContentCard {
13	  children?: ReactNode;
14	  linkContentType?: string;
15	}
16	
17	export const ContentCard: FC<IContentCardProps> = ({
18	  url,
19	  image,
20	  title,
21	  description,
22	  linkContentType,
23	  withStroke = false,
24	  shadow = "dark",
25	  children,
26	  type,
27	  tags,
28	}) => {
29	  const locale = useNextLocale();
30	  const { t } = useTranslation();
31	
32	  const [hasError, setHasError] = useState(false);
33	
34	  const currentLocale = getLocaleByNextLocale(locale);
35	  const { description: altText } = getMetaDataInfoBasedOnLocale(image?.metadata, currentLocale);
36	
37	  const imageFallback =
38	    !image?.public_id || hasError
39	      ? `url(/images/image-placeholder.svg) no-repeat center, ${twTheme.colors.neutral[400]}`
40	      : twTheme.colors.global.white;
41	  const translatedType = type && t(`contentCardPill${type}`, "");
42	
43	  const renderCardContent = () => (
44	    <div
45	      className={cn(
46	        "h-full w-[272px] sm:w-[304px]",
47	        { "border border-solid border-neutral-300": withStroke, "hover:shadow-sm": url },
48	        shadow === "light" ? "hover:shadow-global-white/30" : "hover:shadow-global-black/10",
49	      )}
50	    >
51	      <div
52	        className="relative h-[200px]"
53	        style={{
54	          background: imageFallback,
55	        }}
56	      >
57	        {image?.public_id && (
58	          <Image
59	            src={encodeURI(image?.public_id)}
60	            alt={altText || ""}
61	            objectFit="cover"
62	            objectPosition="center"
63	            layout="fill"
64	            onImageError={() => setHasError(true)}
65	            data-testid="content-card-image"
66	          />
67	        )}
68	      </div>
69	      <div className="p-24 w-full text-left break-words" role="group">
70	        {translatedType && (
71	          <span className="inline-block py-[6px] px-8 cx-overline text-global-black bg-neutral-200 rounded-[4px] mb-12 font-normal">
72	            {translatedType}
73	          </span>
74	        )}
75	        {title && (
76	          <strong
77	            className="w-full block cx-headline-500 text-global-black mb-12"
78	            data-testid="content-card-heading"
79	          >
80	            {title}
81	          </strong>
82	        )}
83	        {description && (
84	          <p className="cx-body-text text-neutral-700" data-testid="content-card-description">
85	            {description}
86	          </p>
87	        )}
88	        {children}
89	
90	        {/* Tags */}
91	        {tags && tags?.length > 0 ? (
92	          <div className="mt-12 flex flex-wrap gap-x-8 gap-y-12">
93	            {tags.map((tag, index) => (
94	              <span
95	                key={index}
96	                className="inline-block text-center py-[4px] px-8 cx-body-text-xsmall text-global-black bg-neutral-200 rounded-[4px]"
97	              >
98	                {tag.toUpperCase()}
99	              </span>
100	            ))}
101	          </div>
102	        ) : null}
103	      </div>
104	    </div>
105	  );
106	
107	  if (!title || (!description && !children)) return null;
108	
109	  return (
110	    <>
111	      {url ? (
112	        <CustomLink
113	          tabIndex={0}
114	          href={url}
115	          className="content-card block h-full w-fit bg-global-white cx-focus-outline"
116	          data-ga-select-content={linkContentType}
117	          data-testid="content-card-container"
118	        >
119	          {renderCardContent()}
120	        </CustomLink>
121	      ) : (
122	        <div
123	          aria-disabled
124	          role="link"
125	          tabIndex={0}
126	          className="content-card block h-full w-fit bg-global-white cx-focus-outline"
127	        >
128	          {renderCardContent()}
129	        </div>
130	      )}
131	    </>
132	  );
133	};
