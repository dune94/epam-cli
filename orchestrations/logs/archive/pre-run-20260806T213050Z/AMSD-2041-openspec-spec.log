// migration-scripts/global_fields/brand_ribbon/brand_ribbon.v1.ts (lines 1–17, relevance: 0.0084)
import { Schema } from "@contentstack/management/types/stack/contentType";
import { client } from "../../client";

export async function updateBrandRibbonV1() {
  const globalField = await client.fetchGlobalField("brand_ribbon");

  const promoItems = globalField.schema.find((field: Schema) => field.uid === "brands");
  const promoColor = promoItems.schema.find((field: Schema) => field.uid === "promo_color");

  promoColor.enum.choices = [
    { value: "#256C2F", key: "GO-GREEN" },
    { value: "#0076D3", key: "UP-BLUE" },
    { value: "#191919", key: "MX/PRESTO-BLACK" },
  ];

  await globalField.update();
}

