7	export const getEntries = async ({
8	  contentType,
9	  query,
10	  locale,
11	}: {
12	  contentType: string;
13	  query: object;
14	  locale: string;
15	}) => {
16	  const result: Entry[] = [];
17	
18	  const _query = await client.client.contentType(contentType).entry().query({
19	    query,
20	    locale,
21	    include_count: true,
22	    include_publish_details: true, // required for entries actualisation
23	    limit: QUERY_RESPONSE_LIMIT,
24	  });
25	
26	  try {
27	    const { items, count } = await _query.find();
28	    result.push(...items);
29	
30	    while (result.length < count) {
31	      const { items } = await client.client
32	        .contentType(contentType)
33	        .entry()
34	        .query({
35	          query,
36	          locale,
37	          include_publish_details: true, // required for entries actualisation
38	          skip: result.length,
39	          limit: QUERY_RESPONSE_LIMIT,
40	        })
41	        .find();
42	
43	      result.push(...items);
44	    }
45	
46	    return await actualiseEntries(contentType, result);
47	  } catch (e: any) {
48	    console.error(
49	      e.message,
50	      `Error retrieving content management entries of content type: ${contentType} for lang: ${locale}`,
51	    );
52	  }
53	};
