--- src/components/contentstack/ContentStackGallery/ContentStackGallery.tsx
import { useTranslation } from "next-i18next";
import { Gallery } from "@metrolinx/cx-shared/build/src/components/Gallery/Gallery";
import { ICloudinaryImage } from "@metrolinx/cx-shared/build/src/interface/content/global";
import { useContent } from "hooks/useContent";
import { useNextLocale } from "hooks/useNextLocale";
import { IImageGallery } from "interface/content/page";

interface IContentStackGalleryProps {
  contentKey: string;
  ctaClasses?: string;
}

export const ContentStackGallery = ({ contentKey, ctaClasses }: IContentStackGalleryProps) => {
  const { t } = useTranslation();
  const { getContentByKey } = useContent();
  const locale = useNextLocale();

  const {
    cta_label,
    image_gallery_heading,
    modular_blocks,
    rich_text_basic,
    gallery_embedding_toggle: isEmbedded,
  } = getContentByKey<IImageGallery>(contentKey, {} as IImageGallery);

  const images = (modular_blocks || []).reduce<ICloudinaryImage[]>(
    (acc, { gallery_item: { image_gallery_image } }) => acc.concat(image_gallery_image),
    [],
  );

  const galleryTitle = t("imageGallery.title");
  const prevSlideLabel = t("imageGallery.prevSlide");
  const nextSlideLabel = t("imageGallery.nextSlide");
  const closeLabel = t("imageGallery.close");

  return (
    <Gallery
      locale={locale}
      title={galleryTitle}
      ctaLabel={cta_label || ""}
      ctaClasses={ctaClasses}
      heading={image_gallery_heading}
      richTextBasic={rich_text_basic}
      images={images}
      modalCloseButtonAriaLabel={closeLabel}
      modalPrevSlideAriaLabel={prevSlideLabel}
      modalNextSlideAriaLabel={nextSlideLabel}
      isEmbedded={isEmbedded}
    />
  );
};

--- src/components/contentstack/ContentStackStaticMaps/ContentStackStaticMaps.tsx
import { useTranslation } from "next-i18next";
import { StaticMaps } from "@metrolinx/cx-shared/build/src/components/StaticMaps/StaticMaps";
import { ICloudinaryImage } from "@metrolinx/cx-shared/build/src/interface/content/global";
import { getCloudinaryImageAlt } from "@metrolinx/cx-shared/build/src/utils/common/getCloudinaryImageAlt";
import { useContent } from "hooks/useContent";
import { useNextLocale } from "hooks/useNextLocale";

interface IContentStackStaticMapsProps {
  contentKey: string;
  priorityLoadImage?: boolean;
}

export const ContentStackStaticMaps = ({
  contentKey,
  priorityLoadImage,
}: IContentStackStaticMapsProps) => {
  const paths = {
    getMapsData: `${contentKey}.static_map`,
  };

  const locale = useNextLocale();
  const { getContentByKey } = useContent();
  const { t } = useTranslation();

  const data = getContentByKey<ICloudinaryImage[]>(paths.getMapsData, []);
  const imageData = data[0] || {};
  const altText = getCloudinaryImageAlt(imageData?.metadata, locale);
  const labels = { map: t("map"), enlarge: t("enlarge") };

  return (
    <StaticMaps
      imageData={imageData}
      priorityLoadImage={priorityLoadImage}
      labels={labels}
      enlargeBtnClasses="bg-global-black text-global-white"
      ariaLabels={{
        zoomIn: t("zoom.zoomIn"),
        zoomOut: t("zoom.zoomOut"),
        closeButton: t("TRM194"),
      }}
      dialogStyles="bg-neutral-300"
      alt={altText}
    />
  );
};

--- src/components/contentstack/ContentStackVideoPlayer/ContentStackVideoPlayer.tsx
import { Video } from "components/Video";
import { useContent } from "hooks/useContent";

export interface IContentStackVideoPlayerProps {
  contentKey?: string;
  isFullWidth?: boolean;
}

export const ContentStackVideoPlayer = ({
  contentKey,
  isFullWidth = false,
}: IContentStackVideoPlayerProps) => {
  const paths = {
    videoId: `${contentKey}.Video.youtube_video_id`,
    videoHeading: `${contentKey}.Video.video_heading`,
    videoCaption: `${contentKey}.Video.video_caption`,
  };
  const { getContentByKey } = useContent();
  const videoId = getContentByKey<string>(paths.videoId, "");
  const videoHeading = getContentByKey<string>(paths.videoHeading, "");
  const videoCaption = getContentByKey<string>(paths.videoCaption, "");

  if (!videoId) return null;

  return (
    <Video
      videoId={videoId}
      heading={videoHeading}
      caption={videoCaption}
      isFullWidth={isFullWidth}
    />
  );
};

