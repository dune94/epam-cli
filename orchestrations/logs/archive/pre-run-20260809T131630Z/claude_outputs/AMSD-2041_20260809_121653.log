import { contentstackConfig, ContentstackLocales, ContentTypes } from "constants/contentstack";
import { publicEnv } from "constants/publicEnv";
import { IGlobalDictionary } from "interface/content/globalDictionary";
import {
  IAccessibilityAssistancePage,
  IContentstackPage,
  IStationDetailsPage,
  IUserAccountPageSpecificData,
} from "interface/content/page";
import { IEnrichedPublishedPage } from "interface/contentstack";
import { IDirectoryData, IMappedByLocaleDirectories } from "interface/directory";
import { IMappedByLocalePageSlugs } from "interface/page";
import logger from "services/logger";
import { getValue } from "utils";
import { getLineColors } from "utils/common/getLineColors";
import { getFullSlug, transformSlugIntoUrl } from "utils/slug";
import { blogService } from "./blogService";
import {
  getEntry,
  getPageContentTypes,
  getSingletonEntry,
  findSingletonEntry,
} from "./contentstack";
import { getAllLinesInfo } from "./go-transit/getAllLinesInfo";
import { partnersPromotionsService } from "./partnersPromotionsService";
import { serviceUpdatesService } from "./serviceUpdatesService";
import { stationService } from "./stationService";
import { userAccountService } from "./userAccountService";

export const excludedContentTypes = [ContentTypes.StationDetailPage];

class PageService {
  async getAllPublishedPages(): Promise<IEnrichedPublishedPage[]> {
    const contentTypes = await getPageContentTypes();
    const contentTypesUids = contentTypes
      .map((contentType) => contentType.uid)
      .filter((uid) => !excludedContentTypes.includes(uid as ContentTypes));

    const handlePageEntriesError = (contentTypeUid: string, locale: string) => (error: unknown) => {
      logger.error(
        error,
        `Error retrieving page entries of content type: ${contentTypeUid} of locale: ${locale}`,
      );
      throw error;
    };

    const pageEntriesPromises = contentTypesUids.reduce((acc, contentTypeUid) => {
      const { referenceFieldPath, jsonRtePath, only } = contentstackConfig[contentTypeUid] || {};
      const enSpecificPageTypeEntriesPromise = getEntry<IContentstackPage[]>({
        contentTypeUid,
        referenceFieldPath,
        jsonRtePath,
        only,
        lang: ContentstackLocales.EN,
      }).then(
        this.getEnrichedPageDetails(contentTypeUid, ContentstackLocales.EN),
        handlePageEntriesError(contentTypeUid, ContentstackLocales.EN),
      );
      const frSpecificPageTypeEntriesPromise = getEntry<IContentstackPage[]>({
        contentTypeUid,
        referenceFieldPath,
        jsonRtePath,
        only,
        lang: ContentstackLocales.FR,
      }).then(
        this.getEnrichedPageDetails(contentTypeUid, ContentstackLocales.FR),
        handlePageEntriesError(contentTypeUid, ContentstackLocales.FR),
      );

      acc.push(enSpecificPageTypeEntriesPromise, frSpecificPageTypeEntriesPromise);

      return acc;
    }, [] as Promise<IEnrichedPublishedPage>[]);

    const results = await Promise.all(pageEntriesPromises);

    return results.filter(({ entries }) => Array.isArray(entries) && entries.length);
  }

  getMappedByLocalePageSlugs(
    pages: IEnrichedPublishedPage[],
    mappedDirectories: IMappedByLocaleDirectories,
  ): IMappedByLocalePageSlugs {
    return pages.reduce((acc, { locale, entries }) => {
      entries.forEach((entry: IContentstackPage) => {
        const { uid, url, directory } = entry;
        const directoryUid = directory?.[0]?.uid;
        const directoryDetails = directoryUid
          ? mappedDirectories[locale]?.[directoryUid]
          : undefined;
        const slug = getFullSlug(directoryDetails?.parts, url);

        acc[locale] = acc[locale] || {};
        acc[locale][uid] = slug;
      });

      return acc;
    }, {} as IMappedByLocalePageSlugs);
  }

  async getHeaderAndFooter({ lang }: { lang: ContentstackLocales }) {
    try {
      const [footer, header] = await Promise.all([
        getEntry({ contentTypeUid: ContentTypes.GlobalFooter, lang }),
        getEntry({ contentTypeUid: ContentTypes.GlobalHeader, lang }),
      ]);

      return {
        header,
        footer,
      };
    } catch (e) {
      logger.error(e, `Error retrieving header and footer by locale: ${lang}`);
      throw e;
    }
  }

  async getStaticUpdates({ lang }: { lang: ContentstackLocales }) {
    try {
      const serviceUpdates = await serviceUpdatesService.getContentstackUpdatesWithLineColors(lang);

      return {
        staticUpdates: serviceUpdates,
      };
    } catch (e) {
      logger.error(e, `Error retrieving service updates static info: ${lang}`);
      throw e;
    }
  }

  async getPageLevelServiceAlerts({ lang }: { lang: ContentstackLocales }) {
    try {
      const [maintenance, secondary] = await Promise.all([
        getEntry({ contentTypeUid: ContentTypes.MaintenanceBanner, lang }),
        getEntry({ contentTypeUid: ContentTypes.SecondaryBanner, lang }),
      ]);

      return {
        serviceAlerts: {
          maintenance,
          secondary,
        },
      };
    } catch (e) {
      logger.error(e, `Error retrieving page level service alerts by locale: ${lang}`);
      throw e;
    }
  }

  async getCookiesBanner({ lang }: { lang: ContentstackLocales }) {
    try {
      return await getEntry({
        contentTypeUid: ContentTypes.CookiesBlock,
        referenceFieldPath: [],
        lang,
      });
    } catch (e) {
      logger.error(e, `Error retrieving cookie banner by locale: ${lang}`);
      throw e;
    }
  }

  async getGlobalDictionary({ lang }: { lang: ContentstackLocales }) {
    try {
      return await getEntry<[IGlobalDictionary]>({
        contentTypeUid: ContentTypes.GlobalDictionary,
        lang,
      });
    } catch (e) {
      logger.error(e, `Error retrieving global dictionary by locale: ${lang}`);
      throw e;
    }
  }

  private getEnrichedPageDetails =
    (contentTypeUid: string, locale: ContentstackLocales) =>
    (entries: IContentstackPage[]): IEnrichedPublishedPage => {
      return { contentTypeUid, locale, entries: entries.filter(({ url }) => Boolean(url)) };
    };

  async getPageSpecificData({
    contentTypeUid,
    entryUid,
    lang,
  }: {
    contentTypeUid: string;
    entryUid: string;
    lang: ContentstackLocales;
  }) {
