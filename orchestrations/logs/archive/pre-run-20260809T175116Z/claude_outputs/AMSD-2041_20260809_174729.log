        }

        case ContentTypes.SeeSchedulesPage: {
          // TODO: Define correct types for every page
          const [tripDetailsPage, tripSearchPage] = await Promise.all([
            getSingletonEntry({
              contentTypeUid: ContentTypes.TripDetails,
