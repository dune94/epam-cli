            data.accessibilityOptions = accessibilityAssistanceWebform?.accessibility_options;
            data.disclaimer = accessibilityAssistanceWebform?.disclaimer;
          }

          return data;
        }

        case ContentTypes.AccessibilityAssistanceWebform: {
          const [tripDetailsPage, subscriptionOptions] = await Promise.all([
            getSingletonEntry({
              contentTypeUid: ContentTypes.TripDetails,
              referenceFieldPath: contentstackConfig[ContentTypes.TripDetails].referenceFieldPath,
