  }

  if (
    !CONTENTSTACK_API_KEY ||
    !CONTENTSTACK_DELIVERY_TOKEN ||
    !CONTENTSTACK_ENVIRONMENT ||
    !CONTENTSTACK_BRANCH
  ) {
    throw new Error("Missing required environment variables");
  }
}

