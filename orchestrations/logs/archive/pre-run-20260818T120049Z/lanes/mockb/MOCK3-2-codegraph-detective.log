**`src/schedule.ts`** — Stop(type_alias), formatStops(function), totalMinutes(function)

```typescript
1	/** Renders a stop sequence for a departure board. */
2	export type Stop = { name: string; minutes: number };
3	
4	export function formatStops(stops: Stop[]): string {
5	  const parts: string[] = [];
6	  for (let i = 0; i < stops.length - 1; i++) {
7	    parts.push(`${stops[i].name} (${stops[i].minutes}m)`);
8	  }
9	  return parts.join(' -> ');
10	}
11	
12	export function totalMinutes(stops: Stop[]): number {
13	  return stops.length ? stops[stops.length - 1].minutes : 0;
14	}
```

