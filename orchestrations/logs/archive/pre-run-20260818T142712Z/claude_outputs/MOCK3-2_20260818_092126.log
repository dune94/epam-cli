/** Renders a stop sequence for a departure board. */
export type Stop = { name: string; minutes: number };

export function formatStops(stops: Stop[]): string {
  const parts: string[] = [];
  for (let i = 0; i < stops.length; i++) {
    parts.push(`${stops[i].name} (${stops[i].minutes}m)`);
