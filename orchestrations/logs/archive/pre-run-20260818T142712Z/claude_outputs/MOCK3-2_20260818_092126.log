### /home/bradleyjerome/projects/mock3/mock-b/src/schedule.ts
```
/** Renders a stop sequence for a departure board. */
export type Stop = { name: string; minutes: number };

export function formatStops(stops: Stop[]): string {
  const parts: string[] = [];
  for (let i = 0; i < stops.length; i++) {
    parts.push(`${stops[i].name} (${stops[i].minutes}m)`);
  }
  return parts.join(' -> ');
}

export function totalMinutes(stops: Stop[]): number {
  return stops.length ? stops[stops.length - 1].minutes : 0;
}
```

### /home/bradleyjerome/projects/mock3/mock-b/test/schedule.test.ts
```
import { describe, it, expect } from 'vitest';
import { formatStops, totalMinutes } from '../src/schedule';

const LINE = [
  { name: 'Union', minutes: 0 },
  { name: 'Bloor', minutes: 12 },
  { name: 'Eglinton', minutes: 25 },
];

describe('formatStops', () => {
  it('separates stops with an arrow', () => {
    expect(formatStops(LINE)).toContain('->');
  });
  it('names the first stop', () => {
    expect(formatStops(LINE)).toContain('Union');
  });
  it('names the final stop', () => {
    expect(formatStops(LINE)).toContain('Eglinton');
  });
  it('renders an empty line without error', () => {
    expect(formatStops([])).toBe('');
  });
});

describe('totalMinutes', () => {
  it('reports the journey length', () => { expect(totalMinutes(LINE)).toBe(25); });
  it('handles an empty line', () => { expect(totalMinutes([])).toBe(0); });
});
```

