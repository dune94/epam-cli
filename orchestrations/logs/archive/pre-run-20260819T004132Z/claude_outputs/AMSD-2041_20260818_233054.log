    (pageProps as { contentstackContext?: IContentstackContext })?.contentstackContext ?? {};

  const [contentstackContextValue, setContentstackContextValue] =
    useState<IContentstackContext>(initialContextValue);

  const setPage = (page: IContentstackPage) => {
    setContentstackContextValue((prev) => ({ ...prev, page: [page] }));
  };

  useEffect(() => {
    initAppSettings();

    const root = document.getElementById("__next");
    root?.setAttribute("tabindex", "-1");
  }, []);

  useEffect(() => {
    ContentstackLivePreview.init({
      stackSdk: Stack,
    });
  }, []);

  useEffect(() => {
    // onEntryChange is a separate static method on ContentstackLivePreview,
    // not an IInitData config property, so it must be registered after init().
    ContentstackLivePreview.onEntryChange(() => {
      const liveHash = ContentstackLivePreview.hash;

      if (!liveHash) {
        return;
      }

      const { contentTypeUid, entryUid } = pageProps as IContentstackPageProps;

      if (!contentTypeUid || !entryUid) {
        return;
      }

      const lang = getLocaleByNextLocale(routerLocale ?? "") as ContentstackLocales;

      // Reuse the same getSingleEntry + contentstackConfig lookup pattern that
      // getSinglePageEntry (pageService.ts) uses on the server side, so live
      // preview re-fetches stay in lockstep with published reads. Using
      // getSingleEntry directly from contentstack.ts avoids pulling the entire
      // pageService dependency tree (contactUsService, newsService, etc.) into
      // the client-side bundle.
      const config = contentstackConfig[contentTypeUid];

      getSingleEntry({
        contentTypeUid,
        entryUid,
        lang,
        ...config,
      })
        .then((page) => {
          setPage(page as IContentstackPage);
        })
        .catch((e) => {
          console.warn("Live preview re-fetch failed, falling back to published content:", e);
        });
    });
  }, [pageProps, routerLocale]);

  useClearStoragesOnSignOut(isSignedOut);

  const path = getPathname(asPath);

  return (
    <AppEnvironmentProvider linkAs={AppLink} imageAs={AppImage}>
      <UserProfileProvider>
        <SessionProvider refetchInterval={refetchInterval} refetchOnWindowFocus>
          <OnlineChatContextWrapper>
            <ErrorBoundary
              FallbackComponent={ClientSideErrorFallback as ComponentType<FallbackProps>}
            >
              <ContentstackContext.Provider value={contentstackContextValue}>
                {/* The key is passed to force page update on route change in some specific cases https://github.com/vercel/next.js/discussions/22512 */}
                <Component {...pageProps} key={path} />
                <SuccessfulSignInToast />
                <ToastNotification />
              </ContentstackContext.Provider>
              <CommonAnalytics contentTypeUid={pageProps.contentTypeUid} />
            </ErrorBoundary>
          </OnlineChatContextWrapper>
        </SessionProvider>
      </UserProfileProvider>
    </AppEnvironmentProvider>
  );
}

export default appWithTranslation(MyApp);
