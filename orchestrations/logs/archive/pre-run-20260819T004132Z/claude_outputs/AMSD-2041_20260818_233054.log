import "@metrolinx/cx-shared/build/bundle.css";
import "styles/globals.css";
import type { AppProps } from "next/app";
import { useRouter } from "next/router";
import { useEffect, useState, ComponentType } from "react";
import ContentstackLivePreview from "@contentstack/live-preview-utils";
import { SessionProvider } from "next-auth/react";
import { appWithTranslation } from "next-i18next";
import { ErrorBoundary, FallbackProps } from "react-error-boundary";
import { ToastNotification } from "@metrolinx/cx-shared/build/src/components/ToastNotification/ToastNotification";
import { AppEnvironmentProvider } from "@metrolinx/cx-shared/build/src/context/AppEnvironmentContext";
import { AppImage } from "components/AppImage";
import { AppLink } from "components/AppLink";
import { ClientSideErrorFallback } from "components/ClientSideErrorFallback";
import { CommonAnalytics } from "components/CommonAnalytics";
import { SuccessfulSignInToast } from "components/SuccessfulSignInToast";
import { ContentstackLocales } from "constants/contentstack";
import { OnlineChatContextWrapper } from "context/OnlineChatContext";
import { UserProfileProvider } from "context/UserProfileContext";
import { ContentstackContext, IContentstackContext } from "context/contentstackContext";
import { useAuthRefetchInterval } from "hooks/useAuthRefetchInterval";
import { useClearStoragesOnSignOut } from "hooks/useClearStoragesOnSignOut";
import { IContentstackPage } from "interface/content/page";
import { Stack } from "services/contentstack";
import { getSinglePageEntry } from "services/pageService";
import { getLocaleByNextLocale } from "utils/locale";
import { getPathname } from "utils/url/getPathname";
import packageJSON from "../../package.json";

const initAppSettings = () => {
  window.appSettings = { version: packageJSON.version };
};

interface IContentstackPageProps {
  contentTypeUid?: string;
  entryUid?: string;
  page?: [IContentstackPage];
}

function MyApp({ Component, pageProps }: AppProps) {
  const { asPath, locale: routerLocale } = useRouter();
  const { refetchInterval, isLoading, session } = useAuthRefetchInterval();

  const isSignedOut = !isLoading && !session;

  const initialContextValue: IContentstackContext =
    (pageProps as { contentstackContext?: IContentstackContext })?.contentstackContext ?? {};

  const [contentstackContextValue, setContentstackContextValue] =
    useState<IContentstackContext>(initialContextValue);

  const setPage = (page: IContentstackPage) => {
    setContentstackContextValue((prev) => ({ ...prev, page: [page] }));
  };

  useEffect(() => {
    initAppSettings();

    const root = document.getElementById("__next");
    root?.setAttribute("tabindex", "-1");
  }, []);

  useEffect(() => {
    ContentstackLivePreview.init({
      stackSdk: Stack,
    });

    // onEntryChange is a separate static method on ContentstackLivePreview,
    // not an IInitData config property, so it must be registered after init().
    ContentstackLivePreview.onEntryChange(() => {
      const liveHash = ContentstackLivePreview.hash;

      if (!liveHash) {
        return;
      }

      const { contentTypeUid, entryUid } = pageProps as IContentstackPageProps;

      if (!contentTypeUid || !entryUid) {
        return;
      }

      const lang = getLocaleByNextLocale(routerLocale ?? "") as ContentstackLocales;

      // Reuse the server-side getSinglePageEntry helper (which itself drives
      // ContentstackFactory.createContentTypeEntryQuery + getSingleEntry with the same
      // contentstackConfig-driven reference fields, only/except, and cache policy as
      // published reads) so live preview re-fetches stay in lockstep with production.
      // The re-fetched entry is written into ContentstackContext so every useContent
      // consumer (147+ components) re-renders with the draft entry.
      getSinglePageEntry(contentTypeUid, entryUid, lang)
        .then((page) => {
          setPage(page as IContentstackPage);
        })
        .catch(() => {
          // Swallow preview re-fetch errors; fall back to published content.
        });
    });
  }, [pageProps, routerLocale]);

  useClearStoragesOnSignOut(isSignedOut);

  const path = getPathname(asPath);

  return (
    <AppEnvironmentProvider linkAs={AppLink} imageAs={AppImage}>
      <UserProfileProvider>
        <SessionProvider refetchInterval={refetchInterval} refetchOnWindowFocus>
          <OnlineChatContextWrapper>
            <ErrorBoundary
              FallbackComponent={ClientSideErrorFallback as ComponentType<FallbackProps>}
            >
              <ContentstackContext.Provider value={contentstackContextValue}>
                {/* The key is passed to force page update on route change in some specific cases https://github.com/vercel/next.js/discussions/22512 */}
                <Component {...pageProps} key={path} />
                <SuccessfulSignInToast />
                <ToastNotification />
              </ContentstackContext.Provider>
              <CommonAnalytics contentTypeUid={pageProps.contentTypeUid} />
            </ErrorBoundary>
          </OnlineChatContextWrapper>
        </SessionProvider>
      </UserProfileProvider>
    </AppEnvironmentProvider>
  );
}

export default appWithTranslation(MyApp);
