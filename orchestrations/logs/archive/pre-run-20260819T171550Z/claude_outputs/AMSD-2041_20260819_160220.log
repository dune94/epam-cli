import { createContext, useCallback, useEffect, useRef, useState } from "react";
import ContentstackLivePreview from "@contentstack/live-preview-utils";
import { ContentTypes } from "constants/contentstack";
import { IContentstackHeader } from "interface/content/header";
import { IContentstackPage } from "interface/content/page";
import { IDirectoryData } from "interface/directory";
import { IOnboarding } from "interface/onboarding";
import { ContentstackLocales } from "constants/contentstack";
import { getSingleEntry, Stack } from "services/contentstack";

export interface IContentstackContext {
  header?: [IContentstackHeader];
  footer?: [any];
  onboarding?: [IOnboarding];
  page?: [IContentstackPage];
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  directories?: IDirectoryData;
  languageAlternativePageSlug?: string[];
  setPage?: (page: IContentstackPage) => void;
}

export const ContentstackContext = createContext<IContentstackContext>({});

interface IContentstackProviderProps {
  value: IContentstackContext;
  contentTypeUid?: string;
  lang?: ContentstackLocales;
  children: React.ReactNode;
}

export const ContentstackProvider = ({
  value,
  contentTypeUid,
  lang,
  children,
}: IContentstackProviderProps) => {
  const initialPage = value.page?.[0];
  const [page, setPageState] = useState<IContentstackPage | undefined>(initialPage);
  const valueRef = useRef(value);
  valueRef.current = value;

  const setPage = useCallback((updated: IContentstackPage) => {
    setPageState(updated);
  }, []);

  // Re-sync local page state when the routed entry changes (route change).
  const entryUid = value.page?.[0]?.uid;
  const lastSyncedUidRef = useRef<string | undefined>(initialPage?.uid);
  useEffect(() => {
    if (entryUid && entryUid !== lastSyncedUidRef.current) {
      lastSyncedUidRef.current = entryUid;
      setPageState(value.page?.[0]);
    }
  }, [entryUid, value.page]);

  useEffect(() => {
    if (typeof window === "undefined") {
      return undefined;
    }

    let callbackUid: string | undefined;
    let cancelled = false;

    ContentstackLivePreview.init({
      stackSdk: Stack,
      ssr: false,
      enable: true,
      mode: "preview",
    }).then(() => {
      if (cancelled) {
        return;
      }

      callbackUid = ContentstackLivePreview.onEntryChange(async () => {
        const current = valueRef.current;
        const currentPage = current.page?.[0];
        const resolvedContentTypeUid =
          contentTypeUid ??
          currentPage?._content_type_uid ??
          ContentstackLivePreview.config?.stackDetails?.contentTypeUid;
        const resolvedEntryUid =
          currentPage?.uid ?? ContentstackLivePreview.config?.stackDetails?.entryUid;
        const resolvedLang =
          lang ??
          (currentPage as { locale?: string } | undefined)?.locale ??
          ContentstackLivePreview.config?.stackDetails?.locale;

        if (!resolvedContentTypeUid || !resolvedEntryUid || !resolvedLang) {
          return;
        }

        try {
          const updated = await getSingleEntry({
            contentTypeUid: resolvedContentTypeUid,
            entryUid: resolvedEntryUid,
            lang: resolvedLang as ContentstackLocales,
          });
          setPageState(updated);
        } catch {
          // Swallow live-preview re-fetch errors so the published render is preserved.
        }
      });
    });

    return () => {
      cancelled = true;
      if (callbackUid) {
        ContentstackLivePreview.unsubscribeOnEntryChange(callbackUid);
      }
    };
  }, [contentTypeUid, lang]);

  const contextValue: IContentstackContext = {
    ...value,
    page: page ? [page] : value.page,
    setPage,
  };

  return (
    <ContentstackContext.Provider value={contextValue}>{children}</ContentstackContext.Provider>
  );
};
