import { HomepageComponentMapper } from "components/componentMappers/HomepageComponentMapper";
import { ContentStackHomePageHeroBanner } from "components/contentstack/ContentStackHomePageHeroBanner";
import { ContentStackLandAcknowledgement } from "components/contentstack/ContentStackLankAck";
import { ContentstackRecentNews } from "components/contentstack/ContentstackRecentNews";
import { IRecentNews } from "interface/content/news";
import { IContentstackPage, PageComponents } from "interface/content/page";
import { getValue } from "utils";

export interface IHomepageProps {
  page: [IContentstackPage];
}

const paths = {
  title: "0.title",
  seo: "0.content_seo",
  pageComponents: "0.modular_blocks",
  recentNews: "0.recent_news",
};

export const Homepage: React.FC<IHomepageProps> = (props) => {
  const { page } = props;
  const { include_recent_news: withRecentNews, recent_news_heading: recentNewsHeading } =
    getValue<IRecentNews>(page, paths.recentNews, {} as IRecentNews);
  const pageComponents = getValue<PageComponents>(page, paths.pageComponents, []);

  return (
    <div className="bg-global-white lg:bg-neutral-200">
      <div className="w-full relative overflow-hidden">
        <ContentStackHomePageHeroBanner />
      </div>
      <div className="relative z-10 lg:-mt-[128px] bg-global-white lg:bg-transparent">
        <div className="cx-container lg:bg-global-white xl:bg-transparent">
          <HomepageComponentMapper pageComponents={pageComponents} />
        </div>
      </div>

      {withRecentNews && (
        <section className="w-full mx-0 xl:mx-auto cx-container bg-neutral-200">
          <div className="w-full col-span-full xl:col-start-2 xl:col-end-14">
            <ContentstackRecentNews heading={recentNewsHeading} />
          </div>
        </section>
      )}

      <div className="w-full">
        <ContentStackLandAcknowledgement />
      </div>
    </div>
  );
};
