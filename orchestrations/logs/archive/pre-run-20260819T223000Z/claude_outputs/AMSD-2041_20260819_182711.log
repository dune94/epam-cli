import {
  ICommonContentstackConfig,
  IContentstackGetEntry,
  IContentstackGetInteractiveMapsStackEntry,
  IContentstackGetSingleEntry,
  IContentstackGetSingletonEntry,
  ICreateEntryConfig,
  ICreateQueryConfig,
} from "../interface/contentstack";
