import logger from "./logger";

const {
  API_KEY = "",
  DELIVERY_TOKEN = "",
  INTERACTIVE_MAPS_STACK_API_KEY = "",
  INTERACTIVE_MAPS_STACK_DELIVERY_TOKEN = "",
  INTERACTIVE_MAPS_STACK_ENVIRONMENT = "",
