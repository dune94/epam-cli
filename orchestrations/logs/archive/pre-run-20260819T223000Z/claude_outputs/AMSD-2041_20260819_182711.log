  onboarding?: [IOnboarding];
  page?: [IContentstackPage];
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  directories?: IDirectoryData;
  languageAlternativePageSlug?: string[];
}

export const ContentstackContext = createContext<IContentstackContext>({});

/**
 * Minimal pub-sub used by Contentstack Live Preview. `_app.tsx` calls
 * `notifyContentstackLivePreview(updatedPage)` from the SDK's `onEntryChange`
 * callback; the active page provider (in `pages/[[...slug]].tsx` or
 * `pages/404.tsx`) subscribes via `subscribeContentstackLivePreview` and
 * pushes the updated page into its own state, re-rendering all consumers.
 *
 * This intentionally does NOT touch the existing `IContentstackContext` shape
 * — every existing `useContent` consumer continues to read the context value
 * unchanged; only the Provider value gets replaced when a live-preview update
 * arrives.
 */
type LivePreviewListener = (updatedPage: IContentstackPage) => void;

const livePreviewListeners = new Set<LivePreviewListener>();

export const subscribeContentstackLivePreview = (listener: LivePreviewListener) => {
  livePreviewListeners.add(listener);

  return () => {
    livePreviewListeners.delete(listener);
  };
};

export const notifyContentstackLivePreview = (updatedPage: IContentstackPage) => {
  livePreviewListeners.forEach((listener) => {
    try {
      listener(updatedPage);
    } catch {
      // Swallow listener errors so one bad subscriber does not break the rest.
    }
  });
};
