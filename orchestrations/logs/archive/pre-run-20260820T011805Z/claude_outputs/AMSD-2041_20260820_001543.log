export interface IContentstackContext {
  header?: [IContentstackHeader];
  footer?: [any];
  onboarding?: [IOnboarding];
  page?: [IContentstackPage];
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  directories?: IDirectoryData;
  languageAlternativePageSlug?: string[];
  /**
   * Re-fetched draft entry data pushed by the Contentstack Live Preview
   * subscription in _app.tsx. Page-level providers merge it over the
   * server-side props so useContent consumers re-render with draft content.
   */
  livePreviewContent?: IContentstackContext | null;
}

export const ContentstackContext = createContext<IContentstackContext>({});
