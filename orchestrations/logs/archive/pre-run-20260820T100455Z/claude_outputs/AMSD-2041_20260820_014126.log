  jsonRtePath,
  only,
  except,
  where,
  cachePolicy,
}: IContentstackGetSingletonEntry): Promise<IContentstackPage> => {
  const query = new ContentstackFactory({
    stack: Stack,
  }).createContentTypeQuery({
    contentTypeUid,
    referenceFieldPath,
    cachePolicy,
    only,
    except,
    where,
    lang,
  });

  try {
    const result = await query.findOne();

    if (jsonRtePath) {
      Utils.jsonToHTML({
        entry: result,
