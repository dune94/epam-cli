      muteErrorLog: this.isDevelopment,
    });

    const cachedFooterData = readFromFs<IMappedByLocaleData>({
      fileName: "footer",
      muteErrorLog: this.isDevelopment,
    });

    const cachedCookiesBannerData = readFromFs<IMappedByLocaleData>({
      fileName: "cookiesBanner",
      muteErrorLog: this.isDevelopment,
    });

    const cachedOnboardingData = readFromFs<IMappedByLocaleData>({
      fileName: "onboarding",
      muteErrorLog: this.isDevelopment,
    });

    const cachedHeader = cachedHeaderData?.[lang];
    const cachedFooter = cachedFooterData?.[lang];
    const cachedCookiesBanner = cachedCookiesBannerData?.[lang];
    const cachedOnboarding = cachedOnboardingData?.[lang];

    try {
      const [header, footer, cookiesBanner, onboarding, page] = await Promise.all([
