    root?.setAttribute("tabindex", "-1");
  }, []);

  useClearStoragesOnSignOut(isSignedOut);

  const path = getPathname(asPath);

  // Read the live `page` value from the ContentstackProvider so that draft
  // entries delivered by the Live Preview SDK propagate to the page tree
  // (and to child components that read from `useContent`) without a full
  // page reload.
  const { content } = useContent();
  const reactivePage = content?.page;
  const mergedPageProps = reactivePage ? { ...pageProps, page: reactivePage } : pageProps;

  // Mutable handle to the latest Provider callbacks + page identifiers.
  // The onEntryChange subscriber below is registered once on mount, so it
  // needs a ref to reach the up-to-date setters on each fire.
  const providerHandlesRef = useRef<{
    contentTypeUid?: string;
    entryUid?: string;
    lang?: string;
    setPage?: (page: [IContentstackPage]) => void;
    setPreviewHash?: (hash: string | null) => void;
  }>({});

  useEffect(() => {
    providerHandlesRef.current = {
      contentTypeUid: pageProps?.contentTypeUid,
      entryUid: pageProps?.entryUid,
      lang: routerLocale === "fr" ? "fr-ca" : "en-ca",
    };
  }, [pageProps, routerLocale]);

  // Re-fetch the changed entry on every Contentstack Live Preview event and
  // push the draft into the Provider so every `useContent` consumer
  // re-renders without a full page reload.
  const handleEntryChange = useCallback(async () => {
    const { contentTypeUid, entryUid, setPage, setPreviewHash } = providerHandlesRef.current;

    if (!contentTypeUid || !entryUid || !setPage) {
      return;
    }

    try {
      const hash = ContentstackLivePreview.hash;
      const config = contentstackConfig[contentTypeUid] || {};
      const lang = (providerHandlesRef.current.lang || "en-ca") as ContentstackLocales;

      setPreviewHash?.(hash || null);

      const draft = await getSingleEntry({
        contentTypeUid,
        entryUid,
        lang,
        ...config,
        ...getLivePreviewConfig(hash),
      });

      if (draft) {
        setPage([draft]);
      }
    } catch {
      // Live preview is best-effort: never block rendering on a failed
      // draft fetch. The Provider keeps showing the last good (published)
      // page value.
    }
  }, []);

  useEffect(() => {
    ContentstackLivePreview.init({
      stackSdk: Stack as unknown as IStackSdk,
      enable: true,
    }).catch(() => {
      // Init failures are non-fatal — the app continues to render
      // published content; live preview is silently disabled.
    });

    const callbackId = ContentstackLivePreview.onEntryChange(handleEntryChange);

    return () => {
      ContentstackLivePreview.unsubscribeOnEntryChange(callbackId);
    };
  }, [handleEntryChange]);

  return (
    <AppEnvironmentProvider linkAs={AppLink} imageAs={AppImage}>
      <ContentstackProvider initialValue={pageProps}>
        <UserProfileProvider>
          <SessionProvider refetchInterval={refetchInterval} refetchOnWindowFocus>
            <OnlineChatContextWrapper>
              <ErrorBoundary
                FallbackComponent={ClientSideErrorFallback as ComponentType<FallbackProps>}
              >
                {/* The key is passed to force page update on route change in some specific cases https://github.com/vercel/next.js/discussions/22512 */}
                <Component {...mergedPageProps} key={path} />
                <SuccessfulSignInToast />
                <ToastNotification />
              </ErrorBoundary>
              <CommonAnalytics contentTypeUid={pageProps.contentTypeUid} />
            </OnlineChatContextWrapper>
          </SessionProvider>
        </UserProfileProvider>
      </ContentstackProvider>
    </AppEnvironmentProvider>
  );
}

export default appWithTranslation(MyApp);
