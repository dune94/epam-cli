import { createContext, useCallback, useContext, useMemo, useState } from "react";
import { ContentTypes } from "constants/contentstack";
import { IContentstackHeader } from "interface/content/header";
import { IContentstackPage } from "interface/content/page";
import { IDirectoryData } from "interface/directory";
import { IOnboarding } from "interface/onboarding";

export interface IContentstackContext {
  header?: [IContentstackHeader];
  footer?: [any];
  onboarding?: [IOnboarding];
  page?: [IContentstackPage];
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  directories?: IDirectoryData;
  languageAlternativePageSlug?: string[];
  /**
   * Active Contentstack live-preview hash, when the page is being rendered
   * inside Visual Builder / preview mode. `null` when preview is inactive.
   */
  previewHash?: string | null;
  /**
   * Sets the active preview hash. Pass `null` to leave preview mode.
   * Setting this re-fetches page entries so consumers re-render with drafts.
   */
  setPreviewHash?: (hash: string | null) => void;
  /**
   * Replaces the current `page` value held by the Provider. The Contentstack
   * Live Preview SDK's `onEntryChange` subscriber in `_app.tsx` calls this
   * with a freshly fetched draft entry so that all `useContent` consumers
   * re-render without a full page reload.
   */
  setPage?: (page: [IContentstackPage]) => void;
}

export const ContentstackContext = createContext<IContentstackContext>({});

const PREVIEW_QUERY_PARAM = "preview";

const readInitialPreviewHash = (): string | null => {
  if (typeof window === "undefined") {
    return null;
  }

  const params = new URLSearchParams(window.location.search);
  const hash = params.get(PREVIEW_QUERY_PARAM);

  return hash || null;
};

export interface IContentstackProviderProps {
  initialValue?: IContentstackContext;
  children: React.ReactNode;
}

/**
 * App-wide Provider that distributes Contentstack data plus reactive
 * live-preview state. When `setPreviewHash` is called (typically by the
 * `ContentstackLivePreview.onEntryChange` subscriber in `_app.tsx`),
 * every consumer of `useContent` / `useContentstackPreview` re-renders.
 */
export const ContentstackProvider: React.FC<IContentstackProviderProps> = ({
  initialValue,
  children,
}) => {
  const [previewHash, setPreviewHashState] = useState<string | null>(
    () => initialValue?.previewHash ?? readInitialPreviewHash(),
  );
  const [pageOverride, setPageOverrideState] = useState<[IContentstackPage] | undefined>(
    () => initialValue?.page,
  );

  const setPreviewHash = useCallback((hash: string | null) => {
    setPreviewHashState(hash);
  }, []);

  const setPage = useCallback((nextPage: [IContentstackPage]) => {
    setPageOverrideState(nextPage);
  }, []);

  const value = useMemo<IContentstackContext>(() => {
    const merged: IContentstackContext = {
      ...(initialValue || {}),
      previewHash,
      setPreviewHash,
      setPage,
    };

    if (pageOverride) {
      merged.page = pageOverride;
    }

    return merged;
  }, [initialValue, previewHash, pageOverride, setPreviewHash, setPage]);

  return <ContentstackContext.Provider value={value}>{children}</ContentstackContext.Provider>;
};

/**
 * Hook for reading & subscribing to the live-preview hash. Components and
 * services that fetch from Contentstack call this to learn whether they
 * should request draft entries.
 */
export const useContentstackPreview = () => {
  const { previewHash, setPreviewHash } = useContext(ContentstackContext);

  return { previewHash: previewHash ?? null, setPreviewHash };
};
```

