        paths: jsonRtePath,
        renderOption,
      });
    }

    return result;
  } catch (error) {
    logger.error(
      `Error retrieving entry of single content type: ${contentTypeUid} for lang: ${lang}`,
      error,
    );

    throw error;
  }
};

