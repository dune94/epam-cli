import { CachePolicy } from "contentstack";
import { contentstackConfig, ContentstackLocales, ContentTypes } from "constants/contentstack";
import { ONLY_FIELDS as NEWS_ONLY_FIELDS } from "constants/news";
import { INewsDetailsPageBaseInfo } from "interface/content/news";
import {
  IContentStackConstructionNoticePage,
  IContentstackPage,
  INewsArticlePage,
  IRegionPage,
  IShallowReference,
  ITopicPage,
} from "interface/content/page";
import { TRelatedProjects } from "interface/content/project";
import { IEnrichedPublishedPage } from "interface/contentstack";
import { IDirectoryData, IMappedByLocaleDirectories } from "interface/directory";
import { IMappedByLocaleEvents } from "interface/events";
import { IMappedByLocalePageSlugs } from "interface/page";
import { IMappedByLocaleProjects, IProject } from "interface/projects";
import { IRegionWithProjects } from "interface/regions";
import { ITopicProjectData, ITopicWithProjects } from "interface/topics";
import logger from "services/logger";
