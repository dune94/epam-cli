+     fi
+     [ -n "$_branch" ] || return 0
+     if git -C "$_repo" rev-parse --verify --quiet "origin/${_branch}" >/dev/null 2>&1; then
+         printf 'origin/%s' "$_branch"
+     else
+         printf '%s' "$_branch"
+     fi
