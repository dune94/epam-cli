  if (hasInsufficient) {
    process.stderr.write('\\n[ac-gate] ⛔ One or more stories have INSUFFICIENT ACs.\\n');
    process.stderr.write('[ac-gate] Pipeline must halt. Human approval required (see Jira comments).\\n');
