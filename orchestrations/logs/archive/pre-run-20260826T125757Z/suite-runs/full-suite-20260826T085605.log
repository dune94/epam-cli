            \"- [\" + (.severity // \"issue\") + \"] \" + (.description // \"\")
            + (if (.file // \"\") != \"\" then \" (\" + .file + (if (.line // 0) > 0 then \":\" + (.line|tostring) else \"\" end) + \")\" else \"\" end)
            + (if (.suggestedFix // \"\") != \"\" then \"\\n  - Suggested fix: \" + .suggestedFix else \"\" end)
          ) | join(\"\\n\");
