# ──────────────────────────────────────────────
_handoff_file=\"$LOG_DIR/phase-handoff-${PHASE}.md\"
{
    echo \"# Phase Handoff: ${PHASE}\"
    echo \"Generated: $(date -Iseconds)\"
    echo \"\"
    echo \"## Completed Stories\"
    jq -r --arg phase \"$PHASE\" \\
        '(.implementationOrder[$phase] // []) as $ids |
