    `spec-mode: ${agent} threw for ${storyId} (${attemptLabel}) — ` +
    `${err && err.name ? err.name : 'Error'}: ${err && err.message ? err.message : String(err)}`
  );
  if (err && err.stack) console.error(err.stack);

  if (isBug) {
