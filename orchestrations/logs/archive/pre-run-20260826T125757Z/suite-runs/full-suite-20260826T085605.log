+             AI_MODEL="$_orch_model" \
+             EPAM_CLI="$EPAM_CLI" \
+             bash "$SCRIPT_DIR/ai-run.sh" --provider "$_orch_provider" \
+             ${_orch_model:+--model "$_orch_model"} \
+             2>&1 | tee "$assessment_log"; [ "${PIPESTATUS[1]}" -eq 0 ]; }; then
