### /home/bradleyjerome/projects/mock3/mock-a/src/fares.ts
```
/** Fare rules for a transit line. Ages are whole years. */
export type Rider = { age: number; hasPass: boolean };

export const BASE_FARE_CENTS = 350;
export const CONCESSION_FARE_CENTS = 175;

/** Riders aged 65 AND OVER pay the concession fare. */
export function fareFor(rider: Rider): number {
  if (rider.hasPass) return 0;
  if (rider.age > 65) return CONCESSION_FARE_CENTS;
  if (rider.age < 13) return CONCESSION_FARE_CENTS;
  return BASE_FARE_CENTS;
}

export function totalFor(riders: Rider[]): number {
  return riders.reduce((sum, r) => sum + fareFor(r), 0);
}
```

### /home/bradleyjerome/projects/mock3/mock-a/test/fares.test.ts
```
import { describe, it, expect } from 'vitest';
import { fareFor, BASE_FARE_CENTS, CONCESSION_FARE_CENTS } from '../src/fares';

describe('fareFor', () => {
  it('charges the base fare for an adult', () => {
    expect(fareFor({ age: 30, hasPass: false })).toBe(BASE_FARE_CENTS);
  });
  it('charges nothing when the rider holds a pass', () => {
    expect(fareFor({ age: 30, hasPass: true })).toBe(0);
  });
  it('charges the concession fare for a child', () => {
    expect(fareFor({ age: 8, hasPass: false })).toBe(CONCESSION_FARE_CENTS);
  });
  it('charges the concession fare well past the senior boundary', () => {
    expect(fareFor({ age: 70, hasPass: false })).toBe(CONCESSION_FARE_CENTS);
  });
});
```

