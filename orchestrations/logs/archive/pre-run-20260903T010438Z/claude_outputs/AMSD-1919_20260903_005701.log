                  dataTestId="checkout-confirm-email-input"
                />
              </div>

              {showTicketDeliveryOptions && (
                <div className="space-y-24" data-testid="ticket-delivery">
                  <div>
                    <p
                      className="inline mr-8 text-neutral-900 cx-headline-500"
                      data-testid="ticket-delivery-heading"
                    >
                      {t("TRM780.heading")}
                    </p>

                    <Tooltip
                      overlay={tooltip}
                      placement="bottom"
                      showArrow
                      trigger={["click", "hover", "focus"]}
                      overlayInnerStyle={TOOLTIP_STYLES}
                      overlayClassName={cn(
                        "cx-tooltip cx-checkout-tooltip max-w-[336px] p-16 !text-16 break-words",
                        {
                          "cx-email-mobile-tooltip": isMobile || isTablet,
                          "cx-email-desktop-tooltip": !isMobile || !isTablet,
                        },
                      )}
                      id="ticket-delivery-tooltip"
                    >
                      <Info24
                        className="cx-custom-outline fill-global-black inline translate-y-[-2px]"
                        tabIndex={0}
                        aria-labelledby={t("TRM445")}
                      />
                    </Tooltip>

                    <div id={t("TRM445")} className="sr-only">
                      {tooltip}
                    </div>
                  </div>

                  <FormRadioGroup
                    name="ticketDelivery"
                    options={ticketDeliveryOptions}
                    classes={{
                      optionsWrapper: "md:flex-col md:items-start text-global-black gap-16",
                    }}
                  />
                </div>
              )}
              <FormCheckBox
                name="emailConsent"
                id="checkout-email-consent"
                aria-labelledby="checkout-form-email-consent-label"
                label={
                  <RichText
                    id="checkout-form-email-consent-label"
                    content={emailConsent}
                    path="rich_text_basic"
                    styleClasses={{
                      linkColor: "text-neutral-700 !cx-body-text-small !font-normal",
                      bodyColor: "text-neutral-700",
                      paragraphClasses: "!cx-body-text-small",
                    }}
                    wrapperClasses="w-full empty:hidden"
                    testIdPrefix="consent-checkbox-label"
                  />
                }
                dataTestId="consent-checkbox"
              />
            </div>
          </div>

          {isPaymentRequired && (
            <div data-testid="checkout-payment-method-container">
              <h2
                className="mb-24 cx-headline-300 lg:cx-headline-200"
                data-testid="payment-method-heading"
              >
                {paymentHeadline}
