import { cloneElement } from "react";
import { render, screen, waitFor } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { useSession } from "next-auth/react";
import { Button } from "@metrolinx/cx-shared/build/src/components/Button/Button";
import { ContentstackProvider } from "context/ContentstackContext";
import { LeaveGuardProvider } from "context/LeaveGuardContext";
import { UserProfileContext } from "context/UserProfileContext";
import { IUserContext } from "interface/content/user";
import { CheckoutForm, ICheckoutFormProps } from "../CheckoutForm";
import { CheckoutFormProvider, DEFAULT_FORM_VALUES } from "../CheckoutFormProvider";
import { CheckoutPaymentMethodsProvider } from "../CheckoutPaymentMethodsProvider";
import { CHECKOUT_FORM_ID } from "../constants";
import { ICheckoutFormValues } from "../types";
import { cartMock, pageMock, singleLineItemMock, user, userContextMock } from "./content.mock";

jest.mock("next/router", () => ({
  useRouter: () => ({
    locale: "en",
    asPath: "/checkout-page",
    events: {
      on: jest.fn(),
      off: jest.fn(),
    },
  }),
}));

jest.mock("next-auth/react", () => ({
  useSession: jest.fn().mockReturnValue({
    status: "unauthenticated",
  }),
}));

jest.mock("services/v1-api/ecommerce/getCart", () => ({
  ...jest.requireActual("services/v1-api/ecommerce/getCart"),
  getCart: jest.fn(),
}));

jest.mock("next-i18next", () => ({
  Trans: jest.fn().mockImplementation(({ defaults, components }: ITransProps) => {
    if (components.signIn) {
      const signIn = cloneElement(components.signIn, {}, "Sign In");

      return (
        <>
          {defaults} {signIn}
        </>
      );
    }

    if (components.bold) {
      const bold = cloneElement(components.bold, {}, "Combined Ticket");

      return (
        <>
          {defaults} {bold}
        </>
      );
    }

    return null;
  }),
  useTranslation: () => ({
    t: jest
      .fn()
      .mockImplementation((key, options) =>
        options ? [`${key} ${JSON.stringify(options)}`] : key,
      ),
  }),
}));

const onSignInMock = jest.fn();

jest.mock("hooks/useSignIn", () => ({
  useSignIn: jest.fn(() => ({
    onSignIn: onSignInMock,
  })),
}));

interface ITransProps {
  defaults: string;
  components: {
    signIn: JSX.Element;
    bold: JSX.Element;
  };
}

interface IRenderCheckoutFormProps extends Partial<ICheckoutFormProps> {
  defaultFormValues?: ICheckoutFormValues;
  userContext?: IUserContext;
}

const onDirtyFieldsMock = jest.fn();

const defaultProps = {
  cart: cartMock,
  onSubmit: jest.fn(),
  onPaymentMethodsFailure: jest.fn(),
  onDirtyFields: onDirtyFieldsMock,
  redirectUrl: null,
  isPaymentRequired: true,
};

const getAllValidationErrors = () => screen.getAllByTestId("validation-error");
const getFirstName = () => screen.getByLabelText("userAccount.firstName");
const getLastName = () => screen.getByLabelText("userAccount.lastName");
const getEmail = () => screen.getByLabelText("TRM085");
const getConfirmEmail = () => screen.getByLabelText("TRM772");
const getEmailConsent = () => screen.getByTestId("consent-checkbox-container");
const getSubmitButton = () => screen.getByTestId<HTMLButtonElement>("submit-order-btn");

const getUserContext = (values: Partial<IUserContext> = {}): IUserContext => ({
  isLoading: false,
  hasError: false,
  data: null,
  ...values,
});

const getSignInButton = () => screen.getByRole("button", { name: "Sign In" });

const renderCheckoutForm = ({
  defaultFormValues = DEFAULT_FORM_VALUES,
  ...props
}: IRenderCheckoutFormProps = {}) => ({
  user: userEvent.setup(),
  ...render(
    <UserProfileContext.Provider
      value={{ userContext: getUserContext(), setUserContext: () => undefined, ...props }}
    >
      <ContentstackProvider defaultContent={{ page: pageMock }}>
        <LeaveGuardProvider>
          <CheckoutPaymentMethodsProvider cart={cartMock}>
            <CheckoutFormProvider cart={cartMock} defaultFormValues={defaultFormValues}>
              <CheckoutForm {...defaultProps} {...props} />
              <Button
                type="submit"
                form={CHECKOUT_FORM_ID}
                label="Place Your Order"
                data-testid="submit-order-btn"
              />
            </CheckoutFormProvider>
          </CheckoutPaymentMethodsProvider>
        </LeaveGuardProvider>
      </ContentstackProvider>
    </UserProfileContext.Provider>,
  ),
});

const useSessionMock = useSession as jest.Mock;

describe("CheckoutForm", () => {
  afterEach(() => {
    jest.clearAllMocks();
  });

  it("should render all required elements", () => {
    renderCheckoutForm();

    // Heading
    expect(screen.getByText("Passenger Details")).toBeInTheDocument();

    // Sign In
    expect(screen.getByText("TRM779")).toBeInTheDocument();

    // Passenger Details
    const firstName = getFirstName();
    expect(firstName).toBeInTheDocument();
    expect(firstName).toHaveAttribute("data-testid", "checkout-first-name-input");

    const lastName = getLastName();
    expect(lastName).toBeInTheDocument();
    expect(lastName).toHaveAttribute("data-testid", "checkout-last-name-input");

    const email = getEmail();
    expect(email).toBeInTheDocument();
    expect(email).toHaveAttribute("data-testid", "checkout-email-input");

    const confirmEmail = getConfirmEmail();
    expect(confirmEmail).toBeInTheDocument();
    expect(confirmEmail).toHaveAttribute("data-testid", "checkout-confirm-email-input");

    expect(getEmailConsent()).toBeInTheDocument();

    // Payment Details
    expect(screen.getByText("Payment Method")).toBeInTheDocument();

    // Ticket Delivery
    expect(screen.queryByTestId("ticket-delivery")).not.toBeInTheDocument();
  });

  it("should show validation error on submit when fields are empty", async () => {
    const { user } = renderCheckoutForm();

    await user.click(getSubmitButton());

    await waitFor(() => {
      expect(getAllValidationErrors()).toHaveLength(4);
    });
  });

  it.each([
    {
      name: "firstName",
      getInput: getFirstName,
      value: "Garfield",
    },
    {
      name: "lastName",
      getInput: getLastName,
      value: "Odie",
    },
    {
      name: "email",
      getInput: getEmail,
      value: "garfield@test.com",
    },
    {
      name: "confirmEmail",
      getInput: getConfirmEmail,
      value: "garfield@test.com",
    },
  ])("should update $name with $value", async ({ getInput, value }) => {
    const { user } = renderCheckoutForm();

    await user.type(getInput(), value);
    await user.tab();

    await waitFor(() => {
      expect(getInput()).toHaveValue(value);
    });
  });

  it("should prevent pasting on confirm email field", async () => {
    const { user } = renderCheckoutForm({
      defaultFormValues: {
        ...DEFAULT_FORM_VALUES,
        email: "garfied@fav.com",
        confirmEmail: "garfied@fav.com",
      },
    });

    await user.click(getConfirmEmail());
    await user.paste("odie@cartoon.com");

    expect(getConfirmEmail()).toHaveValue("garfied@fav.com");
  });

  it("should trigger validation error on blur only when `confirmEmail` field is not empty", async () => {
    const { user } = renderCheckoutForm();

    await user.type(getEmail(), "scooby@dooby.com");
    await user.tab();

    expect(screen.queryByTestId("validation-error")).not.toBeInTheDocument();

    await user.type(getConfirmEmail(), "shaggy@dooby.com");
    await user.tab();

    expect(screen.queryByTestId("validation-error")).toHaveTextContent("TRM774");
  });

  it("should prefill passenger details", async () => {
    useSessionMock.mockReturnValue({
      status: "authenticated",
    });

    renderCheckoutForm({
      userContext: getUserContext(userContextMock),
    });

    await waitFor(() => {
      expect(getEmail()).toHaveValue(user.email);
      expect(getFirstName()).toHaveValue(user.firstName);
      expect(getLastName()).toHaveValue(user.lastName);
      expect(getConfirmEmail()).toHaveValue(user.email);
    });
  });

  it("should not display sign in button when user is authenticated", () => {
    useSessionMock.mockReturnValue({ status: "authenticated" });

    renderCheckoutForm();

    expect(screen.queryByText("TRM779")).not.toBeInTheDocument();
  });

  it("should call onSignIn callback when the sign in button is clicked", async () => {
    useSessionMock.mockReturnValue({ status: "unauthenticated" });

    const { user } = renderCheckoutForm();

    await user.click(getSignInButton());
    expect(onSignInMock).toHaveBeenCalledTimes(1);
    expect(onSignInMock).toHaveBeenCalledWith("http://localhost/");
  });

  it("should show ticket delivery option when line item is 1 and quantity more than 1", async () => {
    renderCheckoutForm({
      cart: {
        ...cartMock,
        lineItems: [singleLineItemMock],
      },
    });

    expect(screen.getByText("TRM780.heading")).toBeInTheDocument();
    expect(screen.getByText("TRM780.combined")).toBeInTheDocument();
    expect(screen.getByText("TRM780.separate")).toBeInTheDocument();
  });

  it("should display a payment modal", async () => {
    renderCheckoutForm({
      redirectUrl: "/url",
    });

    expect(screen.getByTestId("checkout-payment-modal")).toBeInTheDocument();
  });

  it("should call onDirtyFieldsMock with 'true' if form is touched", async () => {
    const { user } = renderCheckoutForm();

    await user.type(getEmail(), "scooby@dooby.com");
    await user.tab();

    expect(onDirtyFieldsMock).toHaveBeenCalledWith(true);
  });
});
