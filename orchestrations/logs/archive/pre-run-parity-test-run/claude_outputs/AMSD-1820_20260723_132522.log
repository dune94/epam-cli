import { maskSensitiveData } from '~/clients/helpers/mask-sensitive-data';
import type { Currency } from '~/types/models/money';

import type { MozioDispatch } from '../models/mozio-order';
import type { SanitizedMozioDispatchCustomer } from './map-to-sanitized-mozio-dispatch-customer';
import { mapToSanitizedMozioDispatchCustomer } from './map-to-sanitized-mozio-dispatch-customer';

export type SanitizedMozioDispatch = Pick<
  MozioDispatch,
  'reference' | 'lineItems'
> & {
  customer: SanitizedMozioDispatchCustomer;
  report: {
    price: {
      base: MozioDispatch['report']['price']['base'];
      selling: MozioDispatch['report']['price']['selling'];
      discount?: {
        name: string;
        amount: {
          value: number;
          currency: Currency;
        };
      };
    };
  };
};

export function mapToSanitizedMozioDispatch(
  dispatch: Pick<
    MozioDispatch,
    'reference' | 'lineItems' | 'customer' | 'report'
  >,
): SanitizedMozioDispatch {
  return {
    reference: dispatch.reference,
    lineItems: dispatch.lineItems,
    customer: mapToSanitizedMozioDispatchCustomer(dispatch.customer),
    report: {
      price: {
        base: dispatch.report.price.base,
        selling: dispatch.report.price.selling,
        discount: dispatch.report.price.discount
          ? {
              amount: dispatch.report.price.discount.amount,
              name: maskSensitiveData(dispatch.report.price.discount.name),
            }
          : undefined,
      },
    },
  };
}
