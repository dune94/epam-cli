```
import { capitalize } from 'lodash';

import {
  mapCorrelationIdStaffNotesPayload,
  mapErrorStaffNotesPayload,
} from './generate-staff-notes.mappers';
import { StaffNoteType } from './types';
import {
  type MessageStaffNote,
  type PaymentsStaffNote,
  type StaffNote,
  type TicketsStaffNote,
} from './types';

const BIG_COMMERCE_STAFF_NOTES_MAX_LENGTH = 65535;

/**
 * @returns date in `01/02/2025 10:47:22 EST` format
 */
export function getFormattedCanadianDate(date: Date) {
  return date
    .toLocaleDateString('en-US', {
      timeZone: 'Canada/Eastern',
      timeZoneName: 'short',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hourCycle: 'h23',
    })
    .replace(',', '');
}

function formatHyphenatedString(value: string): string {
  return capitalize(value.split('-').join(' '));
}

function createField(label: string, value = ''): string {
  return `${label} - ${value}`;
}

function handleTicketsNote(payload: TicketsStaffNote): string | null {
  const notes = [];

  if (payload.value.length === 0) {
    return null;
  }

  notes.push(`${payload.label}:`);
  notes.push('\n\n');

  payload.value.forEach((ticket, index) => {
    if (index > 0) {
      notes.push('\n');
    }

    notes.push(`#${index + 1}`);
    notes.push('\n');

    notes.push(createField('Ticket Number', ticket.number));
    notes.push('\n');

    notes.push(createField('From Station', ticket.fromStation));
    notes.push('\n');

    notes.push(createField('To Station', ticket.toStation));
    notes.push('\n');

    notes.push(createField('Product Name', ticket.productName));
    notes.push('\n');

    notes.push(createField('Return Status', ticket.returnStatus));
    notes.push('\n');

    notes.push(createField('Quantity of Tickets', ticket.quantity.toString()));
    notes.push('\n');

    notes.push(createField('Ticket Subtotal', ticket.subtotal.toString()));
    notes.push('\n');

    notes.push(
      createField('Ticket Discount Amount', ticket.discount.toString()),
    );
    notes.push('\n');

    notes.push(createField('Ticket Total', ticket.total.toString()));
    notes.push('\n');

    notes.push(createField('Ticket Status', capitalize(ticket.status)));
    notes.push('\n');

    notes.push(
      createField(
        'Purchase Date and Timestamp',
        ticket.purchaseDate
          ? getFormattedCanadianDate(ticket.purchaseDate)
          : '',
      ),
    );
    notes.push('\n');

    notes.push(
      createField(
        'Activation Timestamp',
        ticket.activationDate
          ? getFormattedCanadianDate(ticket.activationDate)
          : '',
      ),
    );
    notes.push('\n');

    notes.push(
      createField(
        'Expiry Date and Timestamp',
        ticket.expiryDate ? getFormattedCanadianDate(ticket.expiryDate) : '',
      ),
    );
    notes.push('\n');
  });

  return notes.join('');
}

function handlePaymentsNote(payload: PaymentsStaffNote): string | null {
  const notes = [];

  if (payload.value.length === 0) {
    return null;
  }

  notes.push(`${payload.label}:`);
  notes.push('\n\n');

  payload.value.forEach((payment, index) => {
    if (index > 0) {
      notes.push('\n');
    }

    notes.push(`#${index + 1}`);
    notes.push('\n');

    notes.push(createField('Payment Type', capitalize(payment.type)));
    notes.push('\n');

    notes.push(createField('Payment Status', capitalize(payment.status)));
    notes.push('\n');

    notes.push(createField('Payment Amount', payment.amount.toString()));
    notes.push('\n');

    if (payment.paymentIntentId) {
      notes.push(createField('Payment Intent ID', payment.paymentIntentId));
      notes.push('\n');
    }

    if (payment.chargebackId) {
      notes.push(createField('Chargeback ID', payment.chargebackId));
      notes.push('\n');
    }

    if (payment.refundId) {
      notes.push(createField('Refund ID', payment.refundId));
      notes.push('\n');
    }

    notes.push(createField('Balance Transaction ID', payment.transactionId));
    notes.push('\n');

    notes.push(
      createField('Payment Method', formatHyphenatedString(payment.method)),
    );
    notes.push('\n');

    notes.push(createField('Last Digits', payment.lastDigits || ''));
    notes.push('\n');

    notes.push(createField('Provider', capitalize(payment.provider)));
    notes.push('\n');
  });

  return notes.join('');
}

function handleMessageNote(payload: MessageStaffNote): string {
  const notes = [];

  notes.push(createField(payload.label, payload.value));
  notes.push('\n');

  return notes.join('');
}

export function generateStaffNotes(
  data: StaffNote[],
  maxLength = BIG_COMMERCE_STAFF_NOTES_MAX_LENGTH,
) {
  const staffNotes = data
    .reduce<string[]>((notes, note) => {
      switch (note.type) {
        case StaffNoteType.MESSAGE:
          notes.push(handleMessageNote(note));
          break;

        case StaffNoteType.TICKETS: {
          const payload = handleTicketsNote(note);

          if (payload) {
            notes.push(payload);
          }

          break;
        }

        case StaffNoteType.PAYMENTS: {
          const payload = handlePaymentsNote(note);

          if (payload) {
            notes.push(payload);
          }

          break;
        }
      }

      return notes;
    }, [])
    .join('\n');

  // Some characters, like é or è are 2 bytes long, so we need to calculate the byte length, not just string length
  const staffNotesByteLength = Buffer.byteLength(staffNotes, 'utf-8');
  const charsLengthDiff = maxLength - staffNotesByteLength;
  const finalLength = maxLength + Math.min(charsLengthDiff, 0);

  return staffNotes.slice(0, finalLength);
}

export function extendStaffNotesWithError({
  staffNotes,
  error,
  correlationId,
}: {
  staffNotes: string;
  error: string;
  correlationId: string;
}): string {
  const currentDate = getFormattedCanadianDate(new Date());

  const errorStaffNotePayload = mapErrorStaffNotesPayload(
    `${error} (${currentDate})`,
  );
  const correlationIdStaffNotePayload =
    mapCorrelationIdStaffNotesPayload(correlationId);

  const newStaffNote = generateStaffNotes([
    correlationIdStaffNotePayload,
    errorStaffNotePayload,
  ]);

  return `${newStaffNote}\n${staffNotes}`;
}
```

