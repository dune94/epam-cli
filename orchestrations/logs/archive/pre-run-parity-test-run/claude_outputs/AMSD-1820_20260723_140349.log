import { StatusCodes } from 'http-status-codes';
import { first, last } from 'lodash';

import type { MozioCreateOrderPayload } from '~/clients/mozio/create-order';
import type {
  MozioCreatedOrder,
  MozioOrderLineItem,
} from '~/clients/mozio/models/mozio-order';
import type { Locale } from '~/constants/locale';
import { getProductValidityDates } from '~/services/helpers/order';
import type { Auth } from '~/types/auth';
import { ProductProvider, ProductType } from '~/types/models/product/product';
import type { Reservation } from '~/types/models/reservation';
import { ApiError, ApiErrorCodes } from '~/utils/error';

import { IntegrationNames } from '../integration-permissions';
import type { LimitedCart, LimitedLineItem } from './types';

const RETURN_TRIP_TAIL = 'return';

function parseMozioReference(mozioReference: string) {
  const [type, code] = mozioReference.split(':');

  if (!type || !code) {
    throw new ApiError(`Mozio reference is invalid: ${mozioReference}`, {
      code: ApiErrorCodes.MOZIO_INVALID_REFERENCE,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  return { type, code };
}

function getTripData(lineItem: LimitedLineItem, isReturnTrip: boolean = false) {
  const { metadata, modification } = lineItem.product;
  const modificationFrom = first(modification.trips)?.fromStation;
  const modificationTo = last(modification.trips)?.toStation;
  const metadataFrom = first(metadata.trips)?.fromStation;
  const metadataTo = last(metadata.trips)?.toStation;

  if (!modificationFrom || !modificationTo || !metadataFrom || !metadataTo) {
    throw new ApiError(`Missing trips data for ${lineItem.id}`, {
      code: ApiErrorCodes.MISSING_TRIPS_MODIFICATION_OR_METADATA,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const fromStation = {
    code: modificationFrom.code,
    name: metadataFrom.name,
  };
  const toStation = {
    code: modificationTo.code,
    name: metadataTo.name,
  };

  // In case of return trip we need to swap from/to
  // so it displayed correctly in Mozio tickets
  if (isReturnTrip) {
    return {
      fromStation: toStation,
      toStation: fromStation,
    };
  }

  return {
    fromStation,
    toStation,
  };
}

function mapLineItemToMozioOrderLineItems(
  lineItem: LimitedLineItem,
): MozioOrderLineItem[] {
  const integration = lineItem.product.integrations[ProductProvider.MOZIO];

  if (!integration) {
    throw new ApiError(`Mozio reference is not found for item ${lineItem.id}`, {
      code: ApiErrorCodes.MOZIO_REFERENCE_NOT_FOUND,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const mozioReference = parseMozioReference(integration.reference);
  const productExpirationDays = lineItem.product.metadata.expiration.days;
  const isReturnTrip =
    lineItem.product.type === ProductType.TICKET &&
    lineItem.product.modification.isReturn;

  const lineItemBase: MozioOrderLineItem = {
    reference: lineItem.id,
    quantity: lineItem.quantity,
    product: {
      ...mozioReference,
      metadata: {
        trip: getTripData(lineItem),
      },
    },
    date: getProductValidityDates(productExpirationDays),
  };

  if (isReturnTrip) {
    return [
      lineItemBase,
      {
        ...lineItemBase,
        reference: `${lineItem.id}#${RETURN_TRIP_TAIL}`,
        product: {
          ...lineItemBase.product,
          metadata: {
            trip: getTripData(lineItem, true),
            isReturn: true,
          },
        },
      },
    ];
  }

  return [lineItemBase];
}

const REPORT_MAP: Record<string, string> = {
  [IntegrationNames.GDS]: 'Distribusion',
};

export function mapCreateMozioOrderPayload({
  cart,
  expiration,
  locale,
  settings,
  auth,
  partnerReference,
}: {
  cart: LimitedCart;
  expiration: {
    date: Date;
  };
  locale: Locale;
  settings: {
    useNotifications: boolean;
  };
  auth: Auth;
  partnerReference?: string;
}): MozioCreateOrderPayload {
  // GO Transit is default channel
  const reportIntegrationName = REPORT_MAP[auth.scopes.name];

  const createMozioOrderPayload: MozioCreateOrderPayload = {
    reference: cart.id,
    expiration,
    locale,
    settings,
    lineItems: cart.lineItems.flatMap(mapLineItemToMozioOrderLineItems),
    report: undefined,
  };

  if (reportIntegrationName) {
    createMozioOrderPayload.report = {
      channel: {
        reference: reportIntegrationName,
        partner: partnerReference
          ? {
              reference: partnerReference,
            }
          : undefined,
      },
    };
  }

  return createMozioOrderPayload;
}

export function mapMozioReservation(data: MozioCreatedOrder): Reservation {
  return {
    provider: ProductProvider.MOZIO,
    id: data.id,
    expiration: {
      date: data.expiration.date,
    },
  };
}
```

