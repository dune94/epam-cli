import { StatusCodes } from 'http-status-codes';

import type { MozioDispatch } from '~/clients/mozio/models/mozio-order';
import { getDispatchLineItemKey } from '~/services/helpers/order';
import type {
  SubmitReservationsServicePayload,
  MozioDispatchPayload,
} from '~/services/submit-reservations/types';
import type { Currency } from '~/types/models/money';
import type {
  OrderDispatch,
  OrderDispatchElement,
  OrderLineItem,
} from '~/types/models/order';
import { ProductProvider, ProductType } from '~/types/models/product/product';
import { ApiError, ApiErrorCodes } from '~/utils/error';
import { getPreciseFloatNumber } from '~/utils/get-precise-float-number';

import { applyReportDiscountsService } from './apply-report-discounts.service';

// Assumption that we have one reservation per product provider
// but we are saving service payload signature between them
type ServicePayloadPerProductProvider = Record<
  ProductProvider,
  SubmitReservationsServicePayload
>;

export function mapServicePayloadPerProductProvider(
  payload: SubmitReservationsServicePayload,
) {
  const { orderNumber, externalCreatedAt, customer, currency, payment } =
    payload;

  return Object.values(
    ProductProvider,
  ).reduce<ServicePayloadPerProductProvider>(
    (acc, productProvider) => {
      const productProviderLineItems = payload.lineItems.filter(
        ({ product }) => !!product.integrations[productProvider],
      );
      const productProviderLineItemsIds = productProviderLineItems.map(
        ({ id }) => id,
      );
      const dispatches = payload.dispatches.reduce<OrderDispatch[]>(
        (productProviderDispatches, { id, elements }) => {
          const dispatchElementsLineItemsIds = elements
            .flatMap(({ lineItems }) =>
              lineItems.filter(({ id }) =>
                productProviderLineItemsIds.includes(id),
              ),
            )
            .map(({ id }) => id);

          if (dispatchElementsLineItemsIds.length === 0) {
            return productProviderDispatches;
          }

          productProviderDispatches.push({
            id,
            elements: elements
              // Assumption that product provider should be the same for all line items of dispatch element
              .filter((element) =>
                element.lineItems.every((lineItem) =>
                  productProviderLineItemsIds.includes(lineItem.id),
                ),
              ),
          });

          return productProviderDispatches;
        },
        [],
      );
      const reservations = payload.reservations.filter(
        ({ provider }) => provider === productProvider,
      );

      return {
        ...acc,
        [productProvider]: {
          orderNumber,
          externalCreatedAt,
          customer,
          currency,
          lineItems: productProviderLineItems,
          dispatches,
          reservations,
          payment,
        },
      };
    },
    {
      [ProductProvider.MOZIO]: {
        orderNumber,
        externalCreatedAt,
        customer,
        currency,
        lineItems: [],
        dispatches: [],
        reservations: [],
        payment: undefined,
      },
    },
  );
}

export function mapDispatchPriceReport(
  dispatchLineItems: OrderDispatchElement['lineItems'],
  lineItems: OrderLineItem[],
  currency: Currency,
): MozioDispatch['report']['price'] {
  const priceReport: MozioDispatch['report']['price'] = {
    base: {
      value: 0,
      currency,
    },
    selling: {
      value: 0,
      currency,
    },
    discount: undefined,
  };

  dispatchLineItems.forEach(({ id, quantity }) => {
    const lineItem = lineItems.find((lineItem) => lineItem.id === id);

    if (!lineItem) {
      throw new ApiError(`Dispatch line item with id ${id} is missing`, {
        code: ApiErrorCodes.MISSING_ORDER_DISPATCH_LINE_ITEM,
        status: StatusCodes.UNPROCESSABLE_ENTITY,
      });
    }

    const [lineItemPrice] = lineItem.prices;

    if (!lineItemPrice) {
      throw new ApiError(
        `Prices for line item with id ${lineItem.id} are missing`,
        {
          code: ApiErrorCodes.MISSING_LINE_ITEM_PRICES,
          status: StatusCodes.UNPROCESSABLE_ENTITY,
        },
      );
    }

    // doesn't matter if the current dispatch line item is a return trip or not
    // we need to split the price in case original line item is a return trip
    const isReturnTicket =
      lineItem.product.type === ProductType.TICKET &&
      lineItem.product.modification.isReturn;

    // return ticket is single line item in bigCommerce
    // with double price, so we need to multiply the price by 0.5
    // when it is return ticket, to send correct report to Mozio
    const multiplier = isReturnTicket ? 0.5 : 1;
    const { unit } = lineItemPrice;

    priceReport.base.value = getPreciseFloatNumber(
      priceReport.base.value + unit.base.value * multiplier * quantity,
    );

    // calculate total price, discounts will be applied in the next step
    priceReport.selling.value = getPreciseFloatNumber(
      priceReport.selling.value + unit.base.value * multiplier * quantity,
    );
  });

  return priceReport;
}

export function mapOrderDispatchesToMozioDispatches({
  orderDispatches,
  orderLineItems,
  currency,
}: {
  orderDispatches: OrderDispatch[];
  currency: Currency;
  orderLineItems: OrderLineItem[];
}): MozioDispatchPayload[] {
  const mozioDispatches = orderDispatches
    .flatMap(({ elements }) => elements)
    .map(({ id: reference, lineItems, customer }) => ({
      reference,
      lineItems: lineItems.map(({ id, quantity, metadata }) => ({
        id: getDispatchLineItemKey(id, metadata?.modification?.isReturn),
        quantity,
      })),
      customer,
      report: {
        price: mapDispatchPriceReport(lineItems, orderLineItems, currency),
      },
    }));

  return applyReportDiscountsService(mozioDispatches, orderLineItems);
}

export function mapSubmittedDispatchesToOrderDispatch({
  orderDispatch,
  submittedDispatches,
}: {
  orderDispatch: OrderDispatch;
  submittedDispatches: OrderDispatch[];
}): OrderDispatch {
  // 'submittedDispatches' can have duplicates as there can be multiple providers results for one dispatch
  // when dispatch elements have different product providers
  const dispatches = submittedDispatches.filter(
    (dispatch) => dispatch.id === orderDispatch.id,
  );

  if (!dispatches.length) {
    throw new ApiError(
      `Missing submitted order dispatch with id ${orderDispatch.id}`,
      {
        code: ApiErrorCodes.MISSING_SUBMITTED_ORDER_DISPATCH,
        status: StatusCodes.UNPROCESSABLE_ENTITY,
      },
    );
  }

  return {
    id: orderDispatch.id,
    elements: orderDispatch.elements.map((element) => {
      const submittedDispatchElement = dispatches
        .flatMap(({ elements }) => elements)
        .find((dispatchElement) => dispatchElement.id === element.id);

      if (!submittedDispatchElement) {
        throw new ApiError(
          `Missing submitted order dispatch element with id ${element.id}`,
          {
            code: ApiErrorCodes.MISSING_SUBMITTED_ORDER_DISPATCH_ELEMENT,
            status: StatusCodes.UNPROCESSABLE_ENTITY,
          },
        );
      }

      return submittedDispatchElement;
    }),
  };
}
