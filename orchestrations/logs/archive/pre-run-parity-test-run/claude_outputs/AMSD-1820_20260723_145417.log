import type { Mock } from 'vitest';
import { vi } from 'vitest';

export type StubbableType<TType> = Function & { prototype: TType };

/**
 * Represents a stubbed version of a given class or type `TType`.
 * Each method of the original type `TType` is transformed into a `Mock` function from 'vitest'.
 * This allows each method in the stubbed instance to mimic the original method, track calls,
 * define behaviors, and return values dynamically during tests.
 *
 * @template TType - The type of the class or object being stubbed.
 */
export type StubbedInstance<TType> = TType & {
  [Key in keyof TType]: TType[Key] extends (
    ...args: infer TArgs
  ) => infer TReturn
    ? Mock<(...args: TArgs) => TReturn>
    : never;
};

/**
 * Automates the creation of a stubbed instance of a specified class or type.
 * It leverages the `StubbedInstance` type to ensure that the resulting object
 * maintains type safety and method signatures consistent with the original class,
 * thus preserving IntelliSense and type-checking capabilities in TypeScript.
 *
 * @param {StubbableType<T>} target - The class (constructor function) to stub.
 * @returns {StubbedInstance<T>} A stubbed instance where each method is replaced with a mock function.
 *
 * @example
 * class A {
 *   foo(a: string): boolean {
 *     // original implementation
 *   }
 * }
 *
 * const stub = vitestStubInstance(A);
 * stub.foo.mockReturnValue(true); // Setup mock to return true
 * expect(stub.foo('test')).toBe(true); // Test using the mocked return value
 *
 * @template T - The type of the class or object being stubbed.
 */
export function vitestStubInstance<T>(
  target: StubbableType<T>,
): StubbedInstance<T> {
  const stub: any = {};
  const methodsToStub = Object.getOwnPropertyNames(target.prototype).filter(
    (methodName) => methodName !== 'constructor',
  );

  for (const method of methodsToStub) {
    stub[method] = vi.fn();
  }

  return stub;
}
