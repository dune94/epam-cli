import { StatusCodes } from 'http-status-codes';

import { PaymentType } from '~/services/schemas/order';
import type { Payment } from '~/services/types';
import type { LineItemPriceGroup } from '~/types/models/line-item';
import {
  OrderDispatchElementStateValue,
  type OrderLineItem,
  type OrderDispatch,
  type OrderDispatchElement,
} from '~/types/models/order';
import { PassengerType } from '~/types/models/passenger';
import { ProductType } from '~/types/models/product';
import { ApiError, ApiErrorCodes } from '~/utils/error';
import { getPreciseFloatNumber } from '~/utils/get-precise-float-number';

import { getStripePaymentReference } from '../helpers/payments/get-stripe-payment-reference';
import type {
  TicketsStaffNote,
  TicketStaffNoteValue,
  PaymentsStaffNote,
  PaymentStaffNoteValue,
  MessageStaffNote,
  StaffNote,
} from './types';
import { StaffNoteType } from './types';

export function mapTicketsStaffNotesPayload(
  value: TicketStaffNoteValue[],
): TicketsStaffNote {
  return {
    type: StaffNoteType.TICKETS,
    label: 'Tickets',
    value,
  };
}

export function mapPaymentsStaffNotesPayload(
  value: PaymentStaffNoteValue[],
): PaymentsStaffNote {
  return {
    type: StaffNoteType.PAYMENTS,
    label: 'Payments',
    value,
  };
}

export function mapCorrelationIdStaffNotesPayload(
  value: string,
): MessageStaffNote {
  return {
    type: StaffNoteType.MESSAGE,
    label: 'Correlation ID',
    value,
  };
}

export function mapLastUpdatedStaffNotesPayload(
  value: string,
): MessageStaffNote {
  return {
    type: StaffNoteType.MESSAGE,
    label: 'Last Updated',
    value,
  };
}

export function mapPartnerNameStaffNotesPayload(
  value: string,
): MessageStaffNote {
  return {
    type: StaffNoteType.MESSAGE,
    label: 'Partner',
    value,
  };
}

export function mapErrorStaffNotesPayload(value: string): MessageStaffNote {
  return {
    type: StaffNoteType.MESSAGE,
    label: 'Error',
    value,
  };
}

function getPassengerTypeLabel(type?: PassengerType) {
  switch (type) {
    case PassengerType.ADULT:
      return 'Adult';

    case PassengerType.SENIOR:
      return 'Senior';

    default:
      return '';
  }
}

function getProductName(lineItem: OrderLineItem, isReturnTicket?: boolean) {
  if (lineItem.product.type === ProductType.PASS) {
    const { content } = lineItem.product;

    return content ? content.name : null;
  }

  const { metadata } = lineItem.product;

  const passengerType = getPassengerTypeLabel(metadata.passenger.types[0]);
  const ticketReturnType = isReturnTicket ? 'Return Trip' : 'One Way';

  return `${passengerType} ${ticketReturnType}`;
}

function mapPaymentStaffNotesPayloadValue(
  payment: Payment,
): PaymentStaffNoteValue {
  const stripeReference = getStripePaymentReference(payment);

  return {
    type: payment.type,
    status: payment.state.value,
    amount: payment.amount.value,
    method: payment.method.type,
    lastDigits: payment.method.metadata?.lastDigits,
    provider: payment.method.metadata?.provider,
    paymentIntentId:
      payment.type === PaymentType.CAPTURE ? stripeReference : undefined,
    chargebackId:
      payment.type === PaymentType.CHARGEBACK ? stripeReference : undefined,
    refundId: payment.type === PaymentType.REFUND ? stripeReference : undefined,
  };
}

function getTicketPricePerUnit(
  price: LineItemPriceGroup,
  isReturnTrip?: boolean,
): { base: number; selling: number; discount: number } {
  const base = isReturnTrip
    ? getPreciseFloatNumber(price.unit.base.value / 2)
    : price.unit.base.value;
  const selling = isReturnTrip
    ? getPreciseFloatNumber(price.unit.selling.value / 2)
    : price.unit.selling.value;
  const discount = getPreciseFloatNumber(base - selling);

  return {
    base,
    selling,
    discount,
  };
}

function mapTicketStaffNotesPayloadValue(
  element: OrderDispatchElement,
  lineItems: OrderLineItem[],
): TicketStaffNoteValue {
  const lineItem = element.lineItems[0];

  if (!lineItem) {
    throw new ApiError('Missing order dispatch element line item', {
      code: ApiErrorCodes.MISSING_ORDER_DISPATCH_LINE_ITEM,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const orderLineItem = lineItems.find(({ id }) => id === lineItem.id);

  if (!orderLineItem) {
    throw new ApiError('Missing order line item', {
      code: ApiErrorCodes.MISSING_ORDER_LINE_ITEM,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const tripMetadata = orderLineItem.product.metadata.trips[0];
  const price = orderLineItem.prices[0];

  if (!tripMetadata) {
    throw new ApiError('Missing trips modification or metadata', {
      code: ApiErrorCodes.MISSING_TRIPS_MODIFICATION_OR_METADATA,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  if (!price) {
    throw new ApiError('Missing order line item price', {
      code: ApiErrorCodes.MISSING_PRICE,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const purchaseDate = element.state.history.find(
    (record) => record.to === OrderDispatchElementStateValue.PENDING,
  )?.transitionedAt;
  const activationDate = element.state.history.find(
    (record) => record.to === OrderDispatchElementStateValue.PROCESSING,
  )?.transitionedAt;

  // the element belongs to the line item that is a return trip
  const isReturnTrip =
    orderLineItem.product.type === ProductType.TICKET &&
    orderLineItem.product.modification.isReturn;
  // the element is the return trip ticket
  const isReturnTicket = lineItem.metadata?.modification.isReturn;

  const {
    base,
    selling,
    discount: discountPerUnit,
  } = getTicketPricePerUnit(price, isReturnTrip);

  // TODO: should prices be per unit or multiplied by tickets quantity?
  const subtotal = getPreciseFloatNumber(base * lineItem.quantity);
  const total = getPreciseFloatNumber(selling * lineItem.quantity);
  const discount = getPreciseFloatNumber(discountPerUnit * lineItem.quantity);

  const productName =
    getProductName(orderLineItem, isReturnTicket) ?? undefined;

  return {
    purchaseDate,
    activationDate,
    expiryDate: element.metadata?.dateTo,
    number: element.metadata?.number,
    status: element.state.value,
    returnStatus: isReturnTicket ? 'Yes' : 'No',
    fromStation: isReturnTicket
      ? tripMetadata.toStation.name
      : tripMetadata.fromStation.name,
    toStation: isReturnTicket
      ? tripMetadata.fromStation.name
      : tripMetadata.toStation.name,
    quantity: lineItem.quantity,
    subtotal,
    total,
    discount,
    productName,
  };
}

export function mapStaffNotesPayload({
  correlationId,
  lastUpdated,
  payments,
  dispatches,
  lineItems,
  error,
  partnerName,
}: {
  correlationId: string;
  lastUpdated: string;
  payments?: Payment[];
  dispatches?: OrderDispatch[];
  lineItems?: OrderLineItem[];
  partnerName?: string;
  error?: string;
}): StaffNote[] {
  const result: StaffNote[] = [];

  const errorStaffNotesPayload = error
    ? mapErrorStaffNotesPayload(error)
    : undefined;

  if (errorStaffNotesPayload) {
    result.push(errorStaffNotesPayload);
  }

  const lastUpdatedStaffNotesPayload =
    mapLastUpdatedStaffNotesPayload(lastUpdated);

  result.push(lastUpdatedStaffNotesPayload);

  const correlationIdStaffNotesPayload =
    mapCorrelationIdStaffNotesPayload(correlationId);

  result.push(correlationIdStaffNotesPayload);

  if (partnerName) {
    const partnerNameStaffNotesPayload =
      mapPartnerNameStaffNotesPayload(partnerName);

    result.push(partnerNameStaffNotesPayload);
  }

  const ticketsStaffNotesPayloadValue =
    dispatches && lineItems
      ? dispatches.flatMap((dispatch) =>
          dispatch.elements.map((element) =>
            mapTicketStaffNotesPayloadValue(element, lineItems),
          ),
        )
      : undefined;

  const ticketsStaffNotesPayload = ticketsStaffNotesPayloadValue
    ? mapTicketsStaffNotesPayload(ticketsStaffNotesPayloadValue)
    : undefined;

  if (ticketsStaffNotesPayload) {
    result.push(ticketsStaffNotesPayload);
  }

  const paymentsStaffNotesPayloadValue = payments?.map((payment) =>
    mapPaymentStaffNotesPayloadValue(payment),
  );

  const paymentsStaffNotesPayload = paymentsStaffNotesPayloadValue
    ? mapPaymentsStaffNotesPayload(paymentsStaffNotesPayloadValue)
    : paymentsStaffNotesPayloadValue;

  if (paymentsStaffNotesPayload) {
    result.push(paymentsStaffNotesPayload);
  }

  return result;
}
