import { StatusCodes } from 'http-status-codes';

import type { BigCommerceCreateCartOptionSelection } from '~/clients/big-commerce/create-cart/types';
import { ProductModifierName } from '~/constants/product';
import type { Modifier } from '~/services/get-products-by-id/types';
import type {
  ProductPassModification,
  ProductTicketModification,
} from '~/types/models/product/modification';
import { ApiError, ApiErrorCodes } from '~/utils/error';

type MapLineItemTripsModificationArgs = {
  modification: ProductTicketModification | ProductPassModification;
  modifiersData: Modifier[];
};

export function mapLineItemTripsModification({
  modification,
  modifiersData,
}: MapLineItemTripsModificationArgs) {
  const modifier = modifiersData.find(
    (m) => m.name === ProductModifierName.TRIPS,
  );

  if (!modifier) {
    throw new ApiError('Missing trips modifier', {
      code: ApiErrorCodes.MISSING_TRIPS_MODIFIER,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const tripsModifierData: BigCommerceCreateCartOptionSelection = {
    option_id: modifier.id,
    option_value: modification.trips
      .flatMap((trip) => [trip.fromStation.code, trip.toStation.code])
      .join(','),
  };

  return tripsModifierData;
}
