import { StatusCodes } from 'http-status-codes';

import type { ProductTripMetadata } from '~/types/models/line-item';
import type { Trip } from '~/types/models/product/modification';
import type { StationMap } from '~/types/models/station';
import { ApiError, ApiErrorCodes } from '~/utils/error';
import { normalizeStationCode } from '~/utils/station-code';

export function getProductTripsMetadata(
  trips: Trip[],
  stations: StationMap,
): ProductTripMetadata[] {
  return trips.map(({ fromStation, toStation }) => {
    const fromStationData = stations[normalizeStationCode(fromStation.code)];
    const toStationData = stations[normalizeStationCode(toStation.code)];

    if (!fromStationData || !toStationData) {
      throw new ApiError(
        `Station data is missing for station: ${!fromStationData ? fromStation.code : toStation.code}`,
        {
          code: ApiErrorCodes.MISSING_STATION_DATA,
          status: StatusCodes.UNPROCESSABLE_ENTITY,
        },
      );
    }

    return {
      fromStation: fromStationData,
      toStation: toStationData,
    };
  });
}
