import { StatusCodes } from 'http-status-codes';

import { ProductModifierName } from '~/constants/product';
import { stringToTripsModificationSchema } from '~/schemas/product.schemas';
import { zodParse } from '~/utils';
import { ApiError, ApiErrorCodes } from '~/utils/error';

type GetTripsModificationOption = {
  name: string;
  value: string;
};

export function getTripsModification(options: GetTripsModificationOption[]) {
  const option = options.find((o) => o.name === ProductModifierName.TRIPS);

  if (!option) {
    throw new ApiError('Missing trips option', {
      code: ApiErrorCodes.MISSING_TRIPS_OPTION,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  return zodParse(stringToTripsModificationSchema, { payload: option.value });
}
