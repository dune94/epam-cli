import { maskSensitiveData } from '~/clients/helpers/mask-sensitive-data';
import type { ReservationMetafieldValue } from '~/services/mappers/order/map-order';
import type {
  OrderDispatchElement,
  OrderMetafieldDispatchesValue,
  OrderMetafieldProduct,
  OrderState,
  Payment,
  PriceDiscount,
  PriceDiscountAutomatic,
  PriceDiscountCode,
  PriceDiscountManual,
} from '~/services/types';
import { PriceDiscountType } from '~/types/models/price';
import type { StationMap } from '~/types/models/station';

import { OrderMetafieldKey, OrderMetafieldsNamespace } from '../constants';

const BROKEN_JSON_ERROR_MESSAGE = 'Failed to parse JSON';

type Error = {
  message: string;
};

interface IOrderMetafieldLogPayload<T> {
  value: T;
  key: string;
  namespace: string;
  id?: number;
  resource_id?: string | number;
}

export type OrderDispatchElementDto = Pick<
  OrderDispatchElement,
  'id' | 'lineItems' | 'customer'
> & {
  metadata?: {
    url: string;
    number?: string;
    dateTo?: string;
    dateFrom?: string;
    integrations?: Record<
      string,
      {
        reference: string;
      }
    >;
  };
  state: Pick<OrderDispatchElement['state'], 'value' | 'reason'> & {
    history: {
      reason: OrderDispatchElement['state']['history'][0]['reason'];
      to: OrderDispatchElement['state']['history'][0]['to'];
      transitionedAt: string;
      from?: OrderDispatchElement['state']['history'][0]['from'];
    }[];
  };
};

export type ReservationMetafieldValueDto = {
  id: ReservationMetafieldValue[0]['id'];
  provider: ReservationMetafieldValue[0]['provider'];
  expiration: {
    date: string;
  };
}[];

export type OrderStateDto = Pick<OrderState, 'reason' | 'value'> & {
  history: {
    reason: OrderState['history'][0]['reason'];
    to: OrderState['history'][0]['to'];
    transitionedAt: string;
    from?: OrderState['history'][0]['from'];
  }[];
};

export type SanitizedElement = Pick<
  OrderDispatchElementDto,
  'id' | 'state' | 'lineItems'
> & {
  customer: {
    email: string;
    firstName: string;
    lastName: string;
  };
  metadata?: {
    url: string;
    number?: string;
    dateTo?: string;
    dateFrom?: string;
    integrations?: Record<
      string,
      {
        reference: string;
      }
    >;
  };
};

export type SanitizedDiscount =
  | PriceDiscountManual
  | PriceDiscountAutomatic
  | (Pick<PriceDiscountCode, 'id' | 'amount' | 'type'> & {
      metadata: { code: string };
    });

export type PaymentDto = Pick<
  Payment,
  'id' | 'amount' | 'metadata' | 'method' | 'type' | 'integrations' | 'address'
> & {
  createdAt: string;
  state: Pick<Payment['state'], 'value' | 'reason'> & {
    history: {
      reason: Payment['state']['history'][0]['reason'];
      to: Payment['state']['history'][0]['to'];
      transitionedAt: string;
      from?: Payment['state']['history'][0]['from'];
    }[];
  };
};

export type SanitizedPayment = Pick<
  PaymentDto,
  | 'id'
  | 'amount'
  | 'createdAt'
  | 'metadata'
  | 'method'
  | 'state'
  | 'type'
  | 'integrations'
> & {
  address: Pick<
    PaymentDto['address'],
    'city' | 'country' | 'postalCode' | 'region'
  > & {
    email: string | undefined;
    firstName: string | undefined;
    lastName: string | undefined;
    street: string | undefined;
  };
};

export function mapToSanitizedElement(
  element: OrderDispatchElementDto,
): SanitizedElement {
  return {
    id: element.id,
    state: element.state,
    lineItems: element.lineItems,
    customer: {
      email: maskSensitiveData(element.customer.email),
      firstName: maskSensitiveData(element.customer.firstName),
      lastName: maskSensitiveData(element.customer.lastName),
    },
    metadata: element.metadata
      ? {
          url: maskSensitiveData(element.metadata.url),
          number: element.metadata.number,
          dateFrom: element.metadata.dateFrom,
          dateTo: element.metadata.dateTo,
          integrations: element.metadata.integrations,
        }
      : undefined,
  };
}

export function mapToSanitizedPayments(
  payments: PaymentDto[],
): SanitizedPayment[] {
  return payments.map((payment) => ({
    type: payment.type,
    method: payment.method,
    id: payment.id,
    amount: payment.amount,
    createdAt: payment.createdAt,
    integrations: payment.integrations,
    metadata: payment.metadata,
    state: payment.state,
    address: {
      country: payment.address.country,
      city: payment.address.city,
      postalCode: payment.address.postalCode,
      region: payment.address.region,
      street: maskSensitiveData(payment.address.street),
      email: maskSensitiveData(payment.address.email),
      firstName: maskSensitiveData(payment.address.firstName),
      lastName: maskSensitiveData(payment.address.lastName),
    },
  }));
}

export function mapToSanitizedDiscounts(
  discounts: PriceDiscount[],
): SanitizedDiscount[] {
  return discounts.map((discount) => {
    if (discount.type === PriceDiscountType.CODE) {
      return {
        id: discount.id,
        amount: discount.amount,
        type: discount.type,
        metadata: {
          code: maskSensitiveData(discount.metadata.code),
        },
      };
    }

    return discount;
  });
}

type MapToOrderMetafieldsSanitizedPayload = IOrderMetafieldLogPayload<string>;

export type MapToOrderMetafieldsSanitizedPayloadResult = {
  payments: IOrderMetafieldLogPayload<SanitizedPayment[]> | Error | undefined;
  state: IOrderMetafieldLogPayload<OrderStateDto> | Error | undefined;
  discounts: IOrderMetafieldLogPayload<SanitizedDiscount[]> | Error | undefined;
  lineItemsIdsMap:
    | IOrderMetafieldLogPayload<Record<string, string>>
    | Error
    | undefined;
  products:
    | IOrderMetafieldLogPayload<OrderMetafieldProduct[]>
    | Error
    | undefined;
  stations: IOrderMetafieldLogPayload<StationMap> | Error | undefined;
  reservations:
    | IOrderMetafieldLogPayload<ReservationMetafieldValueDto>
    | Error
    | undefined;
  dispatches:
    | IOrderMetafieldLogPayload<OrderMetafieldDispatchesValue>
    | Error
    | undefined;
  elements: IOrderMetafieldLogPayload<SanitizedElement>[] | Error | undefined;
};

export function mapToOrderMetafieldsSanitizedPayload(
  data: MapToOrderMetafieldsSanitizedPayload[],
) {
  return data.reduce<MapToOrderMetafieldsSanitizedPayloadResult>(
    (result, metafield) => {
      if (metafield.namespace === OrderMetafieldsNamespace.ELEMENTS) {
        try {
          const element = JSON.parse(
            metafield.value,
          ) as OrderDispatchElementDto;

          const sanitizedElement = mapToSanitizedElement(element);

          const payload = {
            value: sanitizedElement,
            id: metafield.id,
            key: metafield.key,
            namespace: metafield.namespace,
            resource_id: metafield.resource_id,
          };

          if (!result.elements) {
            result.elements = [payload];
          } else if (Array.isArray(result.elements)) {
            result.elements.push(payload);
          }
        } catch (error) {
          result.elements = { message: BROKEN_JSON_ERROR_MESSAGE };
        }
      }

      if (metafield.key === OrderMetafieldKey.PAYMENTS) {
        try {
          const payments = JSON.parse(metafield.value) as PaymentDto[];

          const sanitizedPayments = mapToSanitizedPayments(payments);

          result.payments = {
            value: sanitizedPayments,
            id: metafield.id,
            key: metafield.key,
            namespace: metafield.namespace,
            resource_id: metafield.resource_id,
