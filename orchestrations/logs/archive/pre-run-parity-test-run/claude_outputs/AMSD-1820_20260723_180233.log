};

export type SanitizedPayment = Pick<
  PaymentDto,
  | 'id'
  | 'amount'
  | 'createdAt'
  | 'metadata'
  | 'method'
  | 'state'
  | 'type'
  | 'integrations'
> & {
  address: Pick<
    PaymentDto['address'],
    'city' | 'country' | 'postalCode' | 'region'
  > & {
    email: string | undefined;
    firstName: string | undefined;
    lastName: string | undefined;
    street: string | undefined;
  };
};

export function mapToSanitizedElement(
  element: OrderDispatchElementDto,
): SanitizedElement {
  return {
    id: element.id,
    state: element.state,
    lineItems: element.lineItems,
    customer: {
      email: maskSensitiveData(element.customer.email),
      firstName: maskSensitiveData(element.customer.firstName),
      lastName: maskSensitiveData(element.customer.lastName),
    },
    metadata: element.metadata
      ? {
          url: maskSensitiveData(element.metadata.url),
          number: element.metadata.number,
          dateFrom: element.metadata.dateFrom,
          dateTo: element.metadata.dateTo,
          integrations: element.metadata.integrations,
        }
      : undefined,
  };
}

export function mapToSanitizedPayments(
  payments: PaymentDto[],
): SanitizedPayment[] {
  return payments.map((payment) => ({
    type: payment.type,
    method: payment.method,
    id: payment.id,
    amount: payment.amount,
    createdAt: payment.createdAt,
    integrations: payment.integrations,
    metadata: payment.metadata,
    state: payment.state,
    address: {
      country: payment.address.country,
      city: payment.address.city,
      postalCode: payment.address.postalCode,
      region: payment.address.region,
      street: maskSensitiveData(payment.address.street),
      email: maskSensitiveData(payment.address.email),
      firstName: maskSensitiveData(payment.address.firstName),
      lastName: maskSensitiveData(payment.address.lastName),
    },
  }));
}

export function mapToSanitizedDiscounts(
  discounts: PriceDiscount[],
): SanitizedDiscount[] {
  return discounts.map((discount) => {
    if (discount.type === PriceDiscountType.CODE) {
      return {
        id: discount.id,
        amount: discount.amount,
        type: discount.type,
        metadata: {
          code: maskSensitiveData(discount.metadata.code),
        },
      };
    }

    return discount;
  });
}

