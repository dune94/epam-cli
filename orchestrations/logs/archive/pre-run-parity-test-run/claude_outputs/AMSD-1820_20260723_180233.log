### /home/bradleyjerome/projects/metrolinx/azure.commerce.cdts/src/services/mappers/order/map-submitted-mozio-dispatches-to-order-dispatch.ts
```
import { StatusCodes } from 'http-status-codes';

import type { MozioDispatch } from '~/clients/mozio/models/mozio-order';
import type { OrderDispatch } from '~/types/models/order';
import {
  OrderDispatchElementStateReason,
  OrderDispatchElementStateValue,
} from '~/types/models/order';
import { ProductProvider } from '~/types/models/product/product';
import { ApiError, ApiErrorCodes } from '~/utils/error';

import { parseDispatchLineItemKey } from '../../helpers/order/dispatch-line-item-key';

export function mapSubmittedMozioDispatchesToOrderDispatch(
  orderDispatch: OrderDispatch,
  mozioDispatches: MozioDispatch[],
  transitionedAt: Date,
): OrderDispatch {
  return {
    id: orderDispatch.id,
    elements: orderDispatch.elements.map((element) => {
      const dispatch = mozioDispatches.find(
        (mozioDispatch) => mozioDispatch.reference === element.id,
      );

      if (!dispatch) {
        throw new ApiError(
          `Dispatch element with id ${element.id} is missing`,
          {
            code: ApiErrorCodes.MISSING_ORDER_DISPATCH_ELEMENT,
            status: StatusCodes.UNPROCESSABLE_ENTITY,
          },
        );
      }

      return {
        id: dispatch.reference,
        customer: dispatch.customer,
        lineItems: dispatch.lineItems.map(({ id: lineItemId, quantity }) => {
          const { id, isReturn } = parseDispatchLineItemKey(lineItemId);

          return {
            id,
            quantity,
            ...(isReturn
              ? {
                  metadata: {
                    modification: {
                      isReturn: true,
                    },
                  },
                }
              : {}),
          };
        }),
        state: {
          reason: OrderDispatchElementStateReason.SUBMITTED,
          value: OrderDispatchElementStateValue.PENDING,
          history: [
            ...element.state.history,
            {
              to: OrderDispatchElementStateValue.PENDING,
              from: OrderDispatchElementStateValue.CREATED,
              reason: OrderDispatchElementStateReason.SUBMITTED,
              transitionedAt,
            },
          ],
        },
        metadata: {
          number: dispatch.ticketNumber,
          url: dispatch.ticketUrl,
          dateFrom: dispatch.date.dateFrom,
          dateTo: dispatch.date.dateTo,
          integrations: {
            [ProductProvider.MOZIO]: {
              reference: dispatch.reservationId, //  TODO: Confirm it should be 'reservationId' not 'reference'
            },
          },
        },
      };
    }),
  };
}
