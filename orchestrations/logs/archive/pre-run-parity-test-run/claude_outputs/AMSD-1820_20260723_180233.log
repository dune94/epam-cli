            resource_id: metafield.resource_id,
          };
        } catch (error) {
          result.state = { message: BROKEN_JSON_ERROR_MESSAGE };
        }
      }

      if (metafield.key === OrderMetafieldKey.DISCOUNTS) {
        try {
          const discounts = JSON.parse(metafield.value) as PriceDiscount[];
          const sanitizedDiscounts = mapToSanitizedDiscounts(discounts);

          result.discounts = {
            value: sanitizedDiscounts,
