            key: metafield.key,
            namespace: metafield.namespace,
            resource_id: metafield.resource_id,
          };
        } catch (error) {
          result.discounts = { message: BROKEN_JSON_ERROR_MESSAGE };
        }
      }

      if (metafield.key === OrderMetafieldKey.PRODUCTS) {
        try {
