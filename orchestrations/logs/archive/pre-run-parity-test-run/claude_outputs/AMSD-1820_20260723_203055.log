import { StatusCodes } from 'http-status-codes';

import type { BigCommerceCreateCartOptionSelection } from '~/clients/big-commerce/create-cart/types';
import { ProductModifierName } from '~/constants/product';
import type { Modifier } from '~/services/get-products-by-id/types';
import type { ProductTicketModification } from '~/types/models/product/modification';
import { ApiError, ApiErrorCodes } from '~/utils/error';

type MapLineItemReturnTripModificationArgs = {
  modification: ProductTicketModification;
  modifiersData: Modifier[];
};

export function mapLineItemReturnTripModification({
  modification,
  modifiersData,
}: MapLineItemReturnTripModificationArgs) {
  const modifier = modifiersData.find(
    (m) => m.name === ProductModifierName.IS_RETURN,
  );

  if (!modifier) {
    throw new ApiError('Missing return trip modifier', {
      code: ApiErrorCodes.MISSING_RETURN_TRIP_MODIFIER,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const returnTripValue = modification.isReturn
    ? modifier.options.checked
    : modifier.options.unchecked;

  const returnTripsModifierData: BigCommerceCreateCartOptionSelection = {
    option_id: modifier.id,
    option_value: returnTripValue,
  };

  return returnTripsModifierData;
}
```

