import type { z } from 'zod';

import type {
  customerSchema,
  dispatchSchema,
  priceSchema,
} from '../schemas/dispatch.schema';
import type {
  orderLineItemSchema,
  productSchema,
} from '../schemas/order-line-item.schema';
import type {
  mozioCreatedOrderSchema,
  mozioOrderSchema,
  orderStateSchema,
  mozioSubmittedOrderSchema,
  mozioReportSchema,
} from '../schemas/order.schema';
import type { paymentSchema } from '../schemas/payment.schema';

export type MozioDispatchPrice = z.infer<typeof priceSchema>;
export type MozioDispatchCustomer = z.infer<typeof customerSchema>;
export type MozioDispatch = z.infer<typeof dispatchSchema>;

export type MozioProductSchema = z.infer<typeof productSchema>;
export type MozioOrderLineItem = z.infer<typeof orderLineItemSchema>;

export type MozioOrderPayment = z.infer<typeof paymentSchema>;
export type MozioOrderState = z.infer<typeof orderStateSchema>;

export type MozioCreatedOrder = z.infer<typeof mozioCreatedOrderSchema>;
export type MozioSubmittedOrder = z.infer<typeof mozioSubmittedOrderSchema>;
export type MozioOrder = z.infer<typeof mozioOrderSchema>;
export type MozioReport = z.infer<typeof mozioReportSchema>;

// Responses

export type MozioOrderLineItemResponse = Omit<MozioOrderLineItem, 'date'> & {
  date: {
    dateFrom: string;
    dateTo: string;
  };
};

export type MozioDispatchResponse = Omit<
  MozioDispatch,
  'date' | 'activationTimestamp'
> & {
  date: {
    dateFrom: string;
    dateTo: string;
  };
  activationTimestamp?: string;
};

export type MozioCreatedOrderResponse = Omit<
  MozioCreatedOrder,
  'lineItems' | 'expiration'
> & {
  lineItems: MozioOrderLineItemResponse[];
  expiration: {
    date: string;
  };
};

export type MozioSubmittedOrderResponse = Omit<
  MozioSubmittedOrder,
  'dispatches' | 'lineItems' | 'expiration'
> & {
  lineItems: MozioOrderLineItemResponse[];
  expiration: {
    date: string;
  };
  dispatches: MozioDispatchResponse[];
};

export type MozioOrderResponse =
  | MozioCreatedOrderResponse
  | MozioSubmittedOrderResponse;
