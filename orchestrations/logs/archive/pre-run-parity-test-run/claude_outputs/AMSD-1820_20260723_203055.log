```
import { StatusCodes } from 'http-status-codes';

import { getOrderProducts } from '~/clients/big-commerce/get-order-products';
import type { ServiceFunction } from '~/types/service';
import { ApiError, ApiErrorCodes } from '~/utils/error';

import { ORDER_LINE_ITEMS_LIMIT } from '../constants/order';
import { getProductsContentService } from '../get-products-content';
import { getOrderLineItems } from '../helpers/order/get-order-line-items';
import { getProductsIdsFromBigCommerceLineItems } from '../helpers/order/get-products-ids-from-big-commerce-line-items';
import { hasMoreLineItems } from '../helpers/order/has-more-line-items';
import { mapOrderLineItems } from '../mappers/order/map-order-line-items';
import type {
  GetOrderLineItemsServicePayload,
  GetOrderLineItemsServiceResult,
} from './types';

type GetOrderLineItemsService = ServiceFunction<
  GetOrderLineItemsServiceResult,
  GetOrderLineItemsServicePayload
>;

export const getOrderLineItemsService: GetOrderLineItemsService =
  async function (
    context,
    {
      order,
      currency,
      products,
      stations,
      lineItemsIdsMap,
      includesProductContent,
      locale,
    },
  ) {
    const currentLineItems = getOrderLineItems(order);

    if (!currentLineItems.length) {
      throw new ApiError('Order does not contain line items', {
        code: ApiErrorCodes.MISSING_ORDER_LINE_ITEMS,
        status: StatusCodes.UNPROCESSABLE_ENTITY,
      });
    }

    const hasNextLineItems = hasMoreLineItems(
      order.items_total,
      currentLineItems,
    );

    // Maximum 50 line items are retrieved when requesting the order
    const nextLineItems = hasNextLineItems
      ? await getOrderProducts(context, {
          orderId: order.id,
          limit: ORDER_LINE_ITEMS_LIMIT,
          page: 2,
        })
      : undefined;

    const orderLineItems = nextLineItems
      ? [...currentLineItems, ...nextLineItems]
      : currentLineItems;

    const shouldIncludeContent = includesProductContent && !!locale;

    const content = shouldIncludeContent
      ? await getProductsContentService(context, {
          ids: getProductsIdsFromBigCommerceLineItems(orderLineItems),
          locale,
        })
      : undefined;

    return mapOrderLineItems({
      orderLineItems,
      currency,
      products,
      stations,
      lineItemsIdsMap,
      content,
    });
  };
```

