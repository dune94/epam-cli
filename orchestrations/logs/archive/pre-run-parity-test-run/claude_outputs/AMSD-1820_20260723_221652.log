### /home/bradleyjerome/projects/metrolinx/azure.commerce.cdts/src/services/mappers/order/map-order-customer.ts
```
import { getAsyncContext } from '~/middlewares';
import type { OrderResultDto } from '~/services/types';
import type { Customer } from '~/types/models/customer';
import type {
  OrderCustomer,
  OrderCustomerGuestMetadata,
} from '~/types/models/order';
import { OrderCustomerType } from '~/types/models/order';

export const mapOrderCustomer = ({
  customerBaseFields,
  customerId,
  guestTokenMetadata,
}: {
  customerBaseFields: Pick<Customer, 'firstName' | 'lastName' | 'email'>;
  customerId?: string;
  guestTokenMetadata?: OrderCustomerGuestMetadata;
}): OrderResultDto['customer'] => {
  const { logger } = getAsyncContext();

  if (customerId) {
    return {
      firstName: customerBaseFields.firstName,
      lastName: customerBaseFields.lastName,
      email: customerBaseFields.email,
      type: OrderCustomerType.SIGNED,
      id: customerId,
    };
  }

  if (!guestTokenMetadata) {
    logger.warn('Missing customer guest token metadata');
  }

  return {
    firstName: customerBaseFields.firstName,
    lastName: customerBaseFields.lastName,
    email: customerBaseFields.email,
    type: OrderCustomerType.GUEST,
    metadata: guestTokenMetadata
      ? {
          token: guestTokenMetadata.token,
          expiresAt: guestTokenMetadata.expiresAt,
        }
      : undefined,
  };
};

/**
 * Remove sensitive information (e.g. guest token)
 */
export function mapCustomerWithoutSensitiveInfo(
  customer: OrderCustomer,
): OrderCustomer {
  if (customer.type === OrderCustomerType.GUEST) {
    return {
      type: customer.type,
      email: customer.email,
      firstName: customer.firstName,
      lastName: customer.lastName,
    };
  }

  return {
    id: customer.id,
    type: customer.type,
    email: customer.email,
    firstName: customer.firstName,
    lastName: customer.lastName,
  };
}
```

### /home/bradleyjerome/projects/metrolinx/azure.commerce.cdts/src/services/mappers/order/map-order-discounts.ts
```
import { DiscountId } from '~/constants/discount';
import type { PriceDiscount } from '~/services/types';

export function mapOrderDiscounts(discounts: PriceDiscount[]): PriceDiscount[] {
  return discounts.map((discount) => ({
    ...discount,
    id:
      // Manual line-item discount id is inconsistent between cart and order
      // This is a workaround to keep all discount ids consistent within order
      discount.id == DiscountId.MANUAL_ITEM_DISCOUNT
        ? DiscountId.PRODUCT_MANUAL_DISCOUNT
        : discount.id,
  }));
}
```

