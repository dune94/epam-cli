```
import { StatusCodes } from 'http-status-codes';

import { GetOrdersSortingParam } from '~/clients/big-commerce';
import { getOrderMetafields } from '~/clients/big-commerce/get-order-metafields';
import { getOrders } from '~/clients/big-commerce/get-orders';
import type { ServiceFunction } from '~/types/service';
import { ApiError, ApiErrorCodes } from '~/utils/error';

import { createOrderFromCheckoutService } from '../create-order-from-checkout';
import type {
  ProcessZeroAmountOrderServicePayload,
  ProcessZeroAmountOrderServiceResult,
} from './types';

type ProcessZeroAmountOrderService = ServiceFunction<
  ProcessZeroAmountOrderServiceResult,
  ProcessZeroAmountOrderServicePayload
>;

export const processZeroAmountOrderService: ProcessZeroAmountOrderService =
  async function (
    context,
    {
      cart,
      cartMetafields,
      orderNumber,
      dispatches,
      orderOwner,
      guestTokenMetadata,
    },
  ) {
    const orders = await getOrders(context, {
      cartId: cart.id,
      sort: GetOrdersSortingParam.DATE_CREATED_DESC,
      isDeleted: false,
      includeLineItems: true,
    });

    const order = orders[0];

    const isOrderPriceDifferent = order && order.total_inc_tax !== 0;

    if (isOrderPriceDifferent) {
      throw new ApiError('Unexpected order price', {
        code: ApiErrorCodes.UNEXPECTED_ORDER_PRICE,
        status: StatusCodes.UNPROCESSABLE_ENTITY,
      });
    }

    const orderMetafields = order
      ? await getOrderMetafields(context, { orderId: order.id })
      : undefined;

    const orderPayload = order && { data: order, metafields: orderMetafields };

    const { order: createdOrder } = await createOrderFromCheckoutService(
      context,
      {
        cart: { data: cart, metafields: cartMetafields },
        order: orderPayload,
        orderNumber: order?.external_order_id || orderNumber,
        dispatches,
        orderOwner,
        payments: [],
        customerExternalId: cart.customer?.id,
        guestTokenMetadata,
      },
    );

    return {
      ...createdOrder,
      // Zero-amount order does not have payments, so Stripe token and next actions are not needed
      payments: [],
    };
  };
```

### /home/bradleyjerome/projects/metrolinx/azure.commerce.cdts/src/services/order-staff-notes/generate-staff-notes-on-error.service.ts
```
import { getOrder } from '~/clients/big-commerce/get-order';
import { getAsyncContext } from '~/middlewares';
import type { Context } from '~/types/context';

import { getOrderMetadataFromContextService } from '../async-context-order-metadata';
import { getErrorMessage } from '../helpers/error/get-error-message';
import { extendStaffNotesWithError } from './generate-staff-notes.helpers';
import { generateStaffNotesService } from './generate-staff-notes.service';

type GenerateStaffNotesOnErrorServicePayload = {
  error: unknown;
  orderId: number;
};

export async function generateStaffNotesOnErrorService(
  context: Context,
  { error, orderId }: GenerateStaffNotesOnErrorServicePayload,
): Promise<string | null> {
  const correlationId = getAsyncContext().correlationId;
  const message = getErrorMessage(error);
  const { payments, dispatches, lineItems, cartDetails } =
    getOrderMetadataFromContextService(context) || {};

  const isAllRequiredDataAvailable = !!payments && !!dispatches && !!lineItems;

  const staffNotes = isAllRequiredDataAvailable
    ? generateStaffNotesService(context, {
        payments,
        dispatches,
        lineItems,
        error: message ?? undefined,
        cartDetails,
      })
    : null;

  if (staffNotes || !message) return staffNotes;

  const order = await getOrder(context, {
    orderId,
  });

  // extend the existing order staff notes with an error message
  // we don't want to lose the previous staff notes in case the new ones are not generated
  return extendStaffNotesWithError({
    correlationId,
    error: message,
    staffNotes: order.staff_notes,
  });
}
```

