import { StatusCodes } from 'http-status-codes';
import { first, last } from 'lodash';

import type { MozioCreateOrderPayload } from '~/clients/mozio/create-order';
import type {
  MozioCreatedOrder,
  MozioOrderLineItem,
} from '~/clients/mozio/models/mozio-order';
import type { Locale } from '~/constants/locale';
import { getProductValidityDates } from '~/services/helpers/order';
import type { Auth } from '~/types/auth';
import { ProductProvider, ProductType } from '~/types/models/product/product';
import type { Reservation } from '~/types/models/reservation';
import { ApiError, ApiErrorCodes } from '~/utils/error';

import { IntegrationNames } from '../integration-permissions';
import type { LimitedCart, LimitedLineItem } from './types';

const RETURN_TRIP_TAIL = 'return';

function parseMozioReference(mozioReference: string) {
  const [type, code] = mozioReference.split(':');

  if (!type || !code) {
    throw new ApiError(`Mozio reference is invalid: ${mozioReference}`, {
      code: ApiErrorCodes.MOZIO_INVALID_REFERENCE,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  return { type, code };
}

function getTripData(lineItem: LimitedLineItem, isReturnTrip: boolean = false) {
  const { metadata, modification } = lineItem.product;
  const modificationFrom = first(modification.trips)?.fromStation;
  const modificationTo = last(modification.trips)?.toStation;
  const metadataFrom = first(metadata.trips)?.fromStation;
  const metadataTo = last(metadata.trips)?.toStation;

  if (!modificationFrom || !modificationTo || !metadataFrom || !metadataTo) {
    throw new ApiError(`Missing trips data for ${lineItem.id}`, {
      code: ApiErrorCodes.MISSING_TRIPS_MODIFICATION_OR_METADATA,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const fromStation = {
    code: modificationFrom.code,
    name: metadataFrom.name,
  };
  const toStation = {
    code: modificationTo.code,
    name: metadataTo.name,
  };

  // In case of return trip we need to swap from/to
  // so it displayed correctly in Mozio tickets
  if (isReturnTrip) {
    return {
      fromStation: toStation,
      toStation: fromStation,
    };
  }

  return {
    fromStation,
    toStation,
  };
}

function mapLineItemToMozioOrderLineItems(
  lineItem: LimitedLineItem,
): MozioOrderLineItem[] {
  const integration = lineItem.product.integrations[ProductProvider.MOZIO];

  if (!integration) {
    throw new ApiError(`Mozio reference is not found for item ${lineItem.id}`, {
      code: ApiErrorCodes.MOZIO_REFERENCE_NOT_FOUND,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const mozioReference = parseMozioReference(integration.reference);
  const productExpirationDays = lineItem.product.metadata.expiration.days;
  const isReturnTrip =
    lineItem.product.type === ProductType.TICKET &&
    lineItem.product.modification.isReturn;

  const lineItemBase: MozioOrderLineItem = {
    reference: lineItem.id,
    quantity: lineItem.quantity,
    product: {
      ...mozioReference,
      metadata: {
        trip: getTripData(lineItem),
      },
    },
    date: getProductValidityDates(productExpirationDays),
  };

  if (isReturnTrip) {
    return [
      lineItemBase,
      {
        ...lineItemBase,
        reference: `${lineItem.id}#${RETURN_TRIP_TAIL}`,
        product: {
          ...lineItemBase.product,
          metadata: {
            trip: getTripData(lineItem, true),
            isReturn: true,
          },
        },
      },
    ];
  }

  return [lineItemBase];
}

const REPORT_MAP: Record<string, string> = {
  [IntegrationNames.GDS]: 'Distribusion',
};

export function mapCreateMozioOrderPayload({
  cart,
  expiration,
  locale,
  settings,
  auth,
  partnerReference,
}: {
  cart: LimitedCart;
  expiration: {
    date: Date;
  };
  locale: Locale;
  settings: {
    useNotifications: boolean;
  };
  auth: Auth;
  partnerReference?: string;
}): MozioCreateOrderPayload {
  // GO Transit is default channel
  const reportIntegrationName = REPORT_MAP[auth.scopes.name];

  const createMozioOrderPayload: MozioCreateOrderPayload = {
    reference: cart.id,
    expiration,
    locale,
    settings,
    lineItems: cart.lineItems.flatMap(mapLineItemToMozioOrderLineItems),
    report: undefined,
  };

  if (reportIntegrationName) {
    createMozioOrderPayload.report = {
      channel: {
        reference: reportIntegrationName,
        partner: partnerReference
          ? {
              reference: partnerReference,
            }
          : undefined,
      },
    };
  }

  return createMozioOrderPayload;
}

export function mapMozioReservation(data: MozioCreatedOrder): Reservation {
  return {
    provider: ProductProvider.MOZIO,
    id: data.id,
    expiration: {
      date: data.expiration.date,
    },
  };
}
```

### /home/bradleyjerome/projects/metrolinx/azure.commerce.cdts/src/services/submit-reservations/apply-report-discounts.service.ts
```
import type { OrderLineItem } from '~/types/models/order';
import { PriceDiscountType } from '~/types/models/price';
import { getPreciseFloatNumber } from '~/utils/get-precise-float-number';

import type { PriceDiscount } from '../types';
import type { MozioDispatchPayload } from './types';

export function applyReportDiscountsService(
  mozioDispatches: MozioDispatchPayload[],
  orderLineItems: OrderLineItem[],
): MozioDispatchPayload[] {
  const uniqDiscounts = getUniqDiscounts(orderLineItems);

  mozioDispatches.forEach((dispatch) => {
    const discountsForDispatch = uniqDiscounts.filter((discount) => {
      return dispatch.lineItems.some(
        (lineItem) => lineItem.id === discount.lineItemId,
      );
    });

    if (discountsForDispatch.length === 0) {
      return;
    }

    const isAllDiscountsApplied = discountsForDispatch.every(
      (d) => d.amount.value === 0,
    );

    if (isAllDiscountsApplied) {
      return;
    }

    const currency = discountsForDispatch.at(0)?.amount.currency;

    if (!currency) {
      return;
    }

    dispatch.report.price.discount = dispatch.report.price.discount ?? {
      name: '',
      amount: {
        value: 0,
        currency,
      },
    };

    discountsForDispatch.forEach((discount) => {
      const currentSellingPrice = dispatch.report.price.selling.value;

      if (currentSellingPrice === 0 || discount.amount.value === 0) {
        return;
      }

      // making ts happy. This stuff is defined above
      if (!dispatch.report.price.discount) {
        return;
      }

      const appliedDiscountNames = dispatch.report.price.discount?.name;
      const discountedAmount = getPreciseFloatNumber(
        currentSellingPrice - discount.amount.value,
      );
      const remainingDiscount = Math.abs(Math.min(0, discountedAmount));

      const appliedDiscount = getPreciseFloatNumber(
        discount.amount.value - remainingDiscount,
      );

      dispatch.report.price.selling.value = getPreciseFloatNumber(
        Math.max(0, discountedAmount),
      );

      dispatch.report.price.discount.name = appliedDiscountNames
        ? `${appliedDiscountNames},${getDiscountName(discount)}`
        : getDiscountName(discount);

      dispatch.report.price.discount.amount.value = getPreciseFloatNumber(
        dispatch.report.price.discount.amount.value + appliedDiscount,
      );

      discount.amount.value = remainingDiscount;
    });
  });

  return mozioDispatches;
}

function getDiscountName(discount: PriceDiscount) {
  switch (discount.type) {
    case PriceDiscountType.AUTOMATIC:
      return `Auto:${discount.id}`;
    case PriceDiscountType.MANUAL:
      return 'Manual';
    case PriceDiscountType.CODE:
      return `Code:${discount.metadata.code}`;
  }
}

type LineItemDiscount = PriceDiscount & {
  lineItemId: string;
};

function getUniqDiscounts(lineItems: OrderLineItem[]): LineItemDiscount[] {
  const discountsMap: Record<string, LineItemDiscount> = {};

  lineItems.forEach((lineItem) => {
    const discounts = lineItem.prices.flatMap((p) => p.discounts);

    discounts.forEach((d) => {
      discountsMap[`${d.id + lineItem.id}`] = {
        id: d.id,
        lineItemId: lineItem.id,
        amount: d.amount,
        type: d.type,
        metadata: d.metadata,
      } as LineItemDiscount;
    });
  });

  return Object.values(discountsMap);
}
```

### /home/bradleyjerome/projects/metrolinx/azure.commerce.cdts/src/services/mappers/line-item/map-line-item-return-trip-modification.ts
```
import { StatusCodes } from 'http-status-codes';

import type { BigCommerceCreateCartOptionSelection } from '~/clients/big-commerce/create-cart/types';
import { ProductModifierName } from '~/constants/product';
import type { Modifier } from '~/services/get-products-by-id/types';
import type { ProductTicketModification } from '~/types/models/product/modification';
import { ApiError, ApiErrorCodes } from '~/utils/error';

type MapLineItemReturnTripModificationArgs = {
  modification: ProductTicketModification;
  modifiersData: Modifier[];
};

export function mapLineItemReturnTripModification({
  modification,
  modifiersData,
}: MapLineItemReturnTripModificationArgs) {
  const modifier = modifiersData.find(
    (m) => m.name === ProductModifierName.IS_RETURN,
  );

  if (!modifier) {
    throw new ApiError('Missing return trip modifier', {
      code: ApiErrorCodes.MISSING_RETURN_TRIP_MODIFIER,
      status: StatusCodes.UNPROCESSABLE_ENTITY,
    });
  }

  const returnTripValue = modification.isReturn
    ? modifier.options.checked
    : modifier.options.unchecked;

  const returnTripsModifierData: BigCommerceCreateCartOptionSelection = {
    option_id: modifier.id,
    option_value: returnTripValue,
  };

  return returnTripsModifierData;
}
