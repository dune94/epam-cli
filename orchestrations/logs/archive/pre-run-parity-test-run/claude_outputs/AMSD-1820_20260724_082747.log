import type {
  HttpRequest,
  HttpResponseInit,
  InvocationContext,
} from '@azure/functions';
import { app } from '@azure/functions';
import { StatusCodes } from 'http-status-codes';

import { MOZIO_SIGNATURE_HEADER_NAME } from '~/constants/mozio-webhook';
import { mozioWebhookController } from '~/controllers/mozio-webhooks';
import {
  withErrorBoundaryMiddleware,
  applyMiddlewares,
  withAsyncContextMiddleware,
  getAsyncContext,
  withWebhookRetryMiddleware,
  withAuthBySubscriptionKeyMiddleware,
} from '~/middlewares';
import { getAuthBySubscriptionKey } from '~/services/integration-permissions/get-auth-context';
import { forkJoin } from '~/utils';

export async function httpMozioWebhook(
  request: HttpRequest,
  context: InvocationContext,
): Promise<HttpResponseInit> {
  const mozioSignatureHeader = request.headers.get(MOZIO_SIGNATURE_HEADER_NAME);
  const { logger, correlationId } = getAsyncContext();

  const { auth, body } = await forkJoin({
    auth: getAuthBySubscriptionKey(request),
    body: request.text(),
  });

  await mozioWebhookController(
    {
      logger,
      auth,
    },
    {
      body,
      mozioSignatureHeader,
    },
  );

  return {
    status: StatusCodes.OK,
    jsonBody: {
      invocationId: context.invocationId,
      correlationId,
    },
  };
}

export const httpMozioWebhookHandler = applyMiddlewares(httpMozioWebhook, [
  withAuthBySubscriptionKeyMiddleware,
  withAsyncContextMiddleware,
  withWebhookRetryMiddleware,
  withErrorBoundaryMiddleware,
]);

app.http('v1-provider-mozio-hook', {
  route: 'v1/providers/mozio/webhook',
  methods: ['POST'],
  authLevel: 'anonymous',
  handler: httpMozioWebhookHandler,
});
```

