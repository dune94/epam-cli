﻿export module constructionNoticesRibbon {
    "use strict";
    //Reopen button Functionality Code

    // Reopen button visibility
    export async function showHideReopenButton(formContext: Xrm.FormContext): Promise<boolean> {
        //const stakeholderMeetingID = formContext.data.entity.getId().replace(/[\{\}]/g, "");
        const state = formContext.getAttribute("statecode")?.getValue();
        const isCorrectState = state === 1; // Assuming 1 is the Inactive state
        // Show button only if record is inactive
        return isCorrectState;
    }

    // Reopen button action
    export async function reOpenConstructionNotice(formContext: Xrm.FormContext): Promise<void> {
        const constructionNoticeEntityName = formContext.data.entity.getEntityName();
        const constructionNoticeID = formContext.data.entity.getId().replace(/[\{\}]/g, "");
        try {
            await Xrm.WebApi.updateRecord(constructionNoticeEntityName, constructionNoticeID, {
                statecode: 0,
                statuscode: 1
            });
            let bpfId: string | null = null;
            bpfId = await getBpfInstanceId(constructionNoticeID);

            if (bpfId) {
                await Xrm.WebApi.updateRecord(
                    "mlx_constructionnoticebpf",
                    bpfId,
                    {
                        statecode: 0,
                        statuscode: 1
                    }
                );
            } else {
                console.warn("No BPF instance found to reactivate.");
            }


            await formContext.data.refresh(true);

        } catch (error: any) {
            Xrm.Navigation.openAlertDialog({
                text: `Reopen failed: ${error.message}`
            });
        }

    }
    export async function getBpfInstanceId(constructionNoticeID: string): Promise<string> {
        const result = await Xrm.WebApi.retrieveMultipleRecords(
            "mlx_constructionnoticebpf",
            `?$select=businessprocessflowinstanceid&$filter=_bpf_mlx_constructionnoticeid_value eq ${constructionNoticeID}`
        );
        return result.entities.length > 0
            ? result.entities[0].businessprocessflowinstanceid.replace(/[{}]/g, "")
            : null;
    }
    //Cancel Button Functionality Code

    export async function showHideCancelButton(formContext: Xrm.FormContext): Promise<boolean> {
        //const stakeholderMeetingID = formContext.data.entity.getId().replace(/[\{\}]/g, "");
        const state = formContext.getAttribute("statecode")?.getValue();
        const isCorrectState = state === 0; // 0 is the active state
        // Show button only if record is active
        return isCorrectState;
    }
    export async function Cancel(formContext: Xrm.FormContext): Promise<void> {
        const constructionNoticeEntityName = formContext.data.entity.getEntityName();
        const constructionNoticeID = formContext.data.entity.getId().replace(/[\{\}]/g, "");
        try {
            await Xrm.WebApi.updateRecord(constructionNoticeEntityName, constructionNoticeID, {
                statecode: 1,
                statuscode: 100000001
            });
            let bpfId: string | null = null;
            bpfId = await getBpfInstanceId(constructionNoticeID);

            if (bpfId) {
                await Xrm.WebApi.updateRecord(
                    "mlx_constructionnoticebpf",
                    bpfId,
                    {
                        statecode: 1,
                        statuscode: 3
                    }
                );
            } else {
                console.warn("No BPF instance found to reactivate.");
            }
            await formContext.data.refresh(true);
        } catch (error: any) {
            Xrm.Navigation.openAlertDialog({
                text: `Cancellation Failed: ${error.message}`
            });
        }
    }

    export async function createCmsEntry(formContext: Xrm.FormContext): Promise<void> {
        try {
            // Ensure record is saved
            const recordId = formContext.data.entity.getId();
            if (!recordId) {
                Xrm.Navigation.openAlertDialog({ text: "Unable to generate CMS Entry" });
                return;
            }

            // Do not override if URLs already exist
            const imUrl = formContext.getAttribute("mlx_imcmsentryurl")?.getValue();
            const mxUrl = formContext.getAttribute("mlx_mxcmsentryurl")?.getValue();
            if (imUrl || mxUrl) {
                return;
            }

            const cleanId = recordId.replace(/[{}]/g, "");
            const entityName = formContext.data.entity.getEntityName();

            const request = {
                TargetId: cleanId,
                EntityName: entityName,
                OperationType: "CMS",
                Language: "",
                
                getMetadata: function () {
                    return {
                        boundParameter: null,
                        parameterTypes: {
                            TargetId: { typeName: "Edm.String", structuralProperty: 1 },
                            EntityName: { typeName: "Edm.String", structuralProperty: 1 },
                            OperationType: { typeName: "Edm.String", structuralProperty: 1 },
                            Language: { typeName: "Edm.String", structuralProperty: 1 }
                        },
                        operationName: "mlx_GanericPluginForPSMEIntergration",
                        operationType: 0
                    };
                }
            };
            const response = await Xrm.WebApi.online.execute(request);
            const result = await response.json();

            if (result?.IsSuccess) {
                formContext.ui.setFormNotification(result.Message ?? "Request submitted.", "INFO", "CMS_SUCCESS");
            } else {
                formContext.ui.setFormNotification(result?.Message ?? "Request failed.", "ERROR", "CMS_ERROR");
            }
            await formContext.data.refresh(true);
            if ((Xrm as any).CommandBar?.refreshCommandBars) {
                (Xrm as any).CommandBar.refreshCommandBars();
            } else {
                // Fallback for older clients
                (formContext.ui as any).refreshRibbon?.(true);
            }
            // Clear info notification when URLs are available
            const imUrlExist = formContext.getAttribute("mlx_imcmsentryurl")?.getValue();
            const mxUrlExist = formContext.getAttribute("mlx_mxcmsentryurl")?.getValue();
            if (imUrlExist && mxUrlExist) {
                formContext.ui.clearFormNotification("CMS_SUCCESS");
            }
        } catch (error: any) {
            Xrm.Navigation.openAlertDialog({ text: "Unable to generate CMS Entry" });
        }
    }
    export  function hideCreateCMSButton(formContext: Xrm.FormContext): boolean {
        const recordId = formContext.data.entity.getId();
        if (!recordId) {
            return false; // hide
        }
        const imUrl =  formContext.getAttribute("mlx_imcmsentryurl")?.getValue();
        const mxUrl =  formContext.getAttribute("mlx_mxcmsentryurl")?.getValue();
        if (imUrl && mxUrl) {
            return false; // hide
        }
        return true; // show
    }
    export async function openGeneratePdfModalButton(formContext: Xrm.FormContext): Promise<void> {
        const recordId = formContext.data.entity.getId().replace(/[{}]/g, "");
        const pageInput = {
            pageType: "custom",
            name: "mlx_generatepdfmodal_0ae8c",
            recordId: recordId
        };
        const navigationOptions: Xrm.Navigation.NavigationOptions = {
            target: 2,
            width: { value: 520, unit: "px" },
            height: { value: 360, unit: "px" },
            position: 1,
            title: "Generate PDF"
        };
        console.log("Point 1");

       Xrm.Navigation.navigateTo(pageInput as any, navigationOptions)
            .then(
                function () {
                    // Called when the dialog closes
                    Xrm.Navigation.openForm({
                        entityName: formContext.data.entity.getEntityName(),
                        entityId: formContext.data.entity.getId()
                    })
                }
            ).catch(
                function (error) {
                    // Handle error
                    console.log(error);
                }
        );
    }
    export function hideGeneratePdfButton(formContext: Xrm.FormContext): boolean {
        const imUrl = formContext.getAttribute("mlx_imcmsentryurl")?.getValue();
        const mxUrl = formContext.getAttribute("mlx_mxcmsentryurl")?.getValue();
        if (imUrl && mxUrl) {
            return true; // show
        }
        else {
            return false; // hide
        }
    }
}
