```
import { PropsWithChildren } from "react";
import { GetStaticPaths, GetStaticProps, NextPage } from "next";
import { serverSideTranslations } from "next-i18next/serverSideTranslations";
import { resolvePageComponent, resolveStationPageComponent } from "services/pageComponentResolver";
import { pageService } from "services/pageService";
import { staticPathsResolver } from "services/staticPathsResolver";
import { Layout } from "components/Layout/Layout";
import { PageHead } from "components/pages/PageHead";
import { readFromFs } from "utils/fsCache";
import { getLocaleByNextLocale, NextLocales } from "utils/locale";
import { readCachedPageDataFromFs } from "utils/pageDataCache";
import { refineClientData } from "utils/refineClientData";
import { ContentTypes } from "constants/contentstack";
import { IContentstackPage } from "interface/content/page";
import { IDirectoryData, IMappedByLocaleDirectories } from "interface/directory";

interface IDynamicSlugParams {
  slug: string[];
}

export interface IPageProps {
  content: {
    // TODO(devteam): define types for header and footer
    header: [any];
    footer: [any];
    page: [IContentstackPage];
    directories: IDirectoryData;
    languageAlternativePageSlug?: string[];
    pageSpecificData?: Record<string, any>;
    pagesBaseURLs?: {
      [key in ContentTypes]?: string;
    };
  };
  contentTypeUid: string;
}

const DefaultLayout = ({ children }: PropsWithChildren) => children;

const Page: NextPage<IPageProps> = (props) => {
  const { content, contentTypeUid } = props;
  const PageComponent = resolvePageComponent(contentTypeUid);
  const StationDetailsLayout = resolveStationPageComponent(contentTypeUid) ?? DefaultLayout;

  return (
    <>
      <PageHead page={content?.page} contentTypeUid={contentTypeUid} />
      <Layout contentTypeUid={contentTypeUid}>
        <StationDetailsLayout page={content?.page}>
          {PageComponent ? <PageComponent {...content} /> : <h1>Page not implemented</h1>}
        </StationDetailsLayout>
      </Layout>
    </>
  );
};

export const getStaticPaths: GetStaticPaths = async () => {
  const { MAINTENANCE_MODE } = process.env;

  if (MAINTENANCE_MODE === "true") {
    return { paths: [], fallback: false };
  }

  const paths = await staticPathsResolver.resolveStaticPaths();

  return {
    paths,
    fallback: false,
  };
};

export const getStaticProps: GetStaticProps = async (context) => {
  const { locale: nextLocale = "" } = context;
  const { slug = [] } = (context?.params as unknown as IDynamicSlugParams) || {};
  const contentstackLocale = getLocaleByNextLocale(nextLocale);

  const cachedHeaderData = readFromFs<{ [locale: string]: any }>({
    fileName: "header",
  });
  const cachedFooterData = readFromFs<{ [locale: string]: any }>({
    fileName: "footer",
  });
  const cachedPagesBaseURLs = readFromFs<{ [locale: string]: Record<string, string> }>({
    fileName: "pagesBaseURLs",
  });

  const header = cachedHeaderData?.[contentstackLocale];
  const footer = cachedFooterData?.[contentstackLocale];
  const pagesBaseURLs = cachedPagesBaseURLs?.[contentstackLocale];

  const {
    uid: pageUid,
    contentTypeUid,
    languageAlternativePageSlug,
    entry: pageContent,
  } = readCachedPageDataFromFs([nextLocale, ...slug]);

  const directories = readFromFs<IMappedByLocaleDirectories>({ fileName: "directories" });
  const currentLocaleDirectories = directories?.[contentstackLocale] || {};

  const pageSpecificData = await pageService.getPageSpecificData({
    recentNews: pageContent.recent_news,
    contentTypeUid,
    entryUid: pageUid,
    lang: contentstackLocale,
  });

  const rawContent: IPageProps["content"] = {
    header,
    page: [pageContent],
    footer,
    pageSpecificData,
    directories: currentLocaleDirectories,
    languageAlternativePageSlug,
    pagesBaseURLs,
  };

  return {
    props: {
      contentTypeUid,
      content: refineClientData(rawContent, nextLocale as NextLocales),
      ...(await serverSideTranslations(nextLocale, ["common"])),
    },
  };
};

export default Page;
```

