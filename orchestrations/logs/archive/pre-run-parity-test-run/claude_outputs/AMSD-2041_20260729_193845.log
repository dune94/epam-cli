    if (count) {
      query.includeCount();
    }

    if (skip) {
      query.skip(skip);
    }

    if (limit) {
      query.limit(limit);
    }

    this.setCommonConfig({ query, ...commonConfig });

    if (where) {
      Object.entries(where).forEach(([key, value]) => query.where(key, value));
    }

    return query;
