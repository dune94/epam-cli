```
import { createContext, useMemo, useState, useEffect, ReactNode } from "react";
import ContentstackLivePreview from "@contentstack/live-preview-utils";
import { ContentTypes } from "constants/contentstack";
import { IContentstackHeader } from "interface/content/header";
import { IContentstackPage } from "interface/content/page";
import { IDirectoryData } from "interface/directory";
import { IOnboarding } from "interface/onboarding";
import { Stack } from "services/contentstack";

export interface IContentstackContext {
  header?: [IContentstackHeader];
  footer?: [any];
  onboarding?: [IOnboarding];
  page?: [IContentstackPage];
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  directories?: IDirectoryData;
  languageAlternativePageSlug?: string[];
}

export const ContentstackContext = createContext<IContentstackContext>({});

function deepMerge(target: any, source: any): any {
  if (typeof target !== "object" || target === null || typeof source !== "object" || source === null) {
    return source !== undefined ? source : target;
  }
  if (Array.isArray(source)) {
    return source;
  }
  const result = { ...target };
  for (const key of Object.keys(source)) {
    if (source[key] !== undefined) {
      result[key] = deepMerge(target[key], source[key]);
    }
  }
  return result;
}

interface IContentstackProviderProps {
  content: IContentstackContext;
  children: ReactNode;
}

export const ContentstackProvider = ({ content, children }: IContentstackProviderProps) => {
  const [livePreviewData, setLivePreviewData] = useState<Record<string, any>>({});

  useEffect(() => {
    ContentstackLivePreview.init({
      ssr: false,
      enable: true,
      stackSdk: Stack as any,
    }).catch(() => {
      // Live preview init failure should not crash the app
    });

    const callbackUid = ContentstackLivePreview.onEntryChange(() => {
      try {
        const hash = ContentstackLivePreview.hash;
        if (hash) {
          try {
            const parsed = JSON.parse(atob(hash));
            setLivePreviewData((prev) => deepMerge(prev, parsed));
          } catch {
            // Invalid hash data — keep previous content
          }
        }
      } catch {
        // Preview callback error should not crash the app
      }
    }, { skipInitialRender: true });

    return () => {
      try {
        ContentstackLivePreview.unsubscribeOnEntryChange(callbackUid);
      } catch {
        // Cleanup error should not crash the app
      }
    };
  }, []);

  const mergedContent = useMemo(
    () => deepMerge(content, livePreviewData) as IContentstackContext,
    [content, livePreviewData],
  );

  return (
    <ContentstackContext.Provider value={mergedContent}>
      {children}
    </ContentstackContext.Provider>
  );
};
```

