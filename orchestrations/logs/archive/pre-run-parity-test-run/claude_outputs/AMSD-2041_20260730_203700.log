import { CachePolicy } from "contentstack";
import { contentstackConfig, ContentstackLocales, ContentTypes } from "constants/contentstack";
import { ONLY_FIELDS as NEWS_ONLY_FIELDS } from "constants/news";
import { INewsDetailsPageBaseInfo } from "interface/content/news";
import {
  IContentStackConstructionNoticePage,
  IContentstackPage,
  INewsArticlePage,
  IRegionPage,
  IShallowReference,
  ITopicPage,
} from "interface/content/page";
import { TRelatedProjects } from "interface/content/project";
import { IEnrichedPublishedPage } from "interface/contentstack";
import { IDirectoryData, IMappedByLocaleDirectories } from "interface/directory";
import { IMappedByLocaleEvents } from "interface/events";
import { IMappedByLocalePageSlugs } from "interface/page";
import { IMappedByLocaleProjects, IProject } from "interface/projects";
import { IRegionWithProjects } from "interface/regions";
import { ITopicProjectData, ITopicWithProjects } from "interface/topics";
import logger from "services/logger";
import { isDevelopmentEnv } from "utils/envs";
import { readFromFs } from "utils/fsCache";
import { getValue } from "utils/getValue";
import { getFullSlug, transformSlugIntoUrl } from "utils/slug";
import { contactUsService } from "./contactUsService";
import {
  findSingletonEntry,
  getEntry,
  getInteractiveMapsConstructionNoticeEntry,
  getPageContentTypes,
  getSingleEntry,
  getSingletonEntry,
} from "./contentstack";
import {
  getRelatedProjectsList,
  mapBasicPageToContentCard,
  mapEventToLinkedEventsData,
  mapProjectNavigationToLinks,
  mapProjectToRelatedProjectsData,
} from "./mappers";
import { newsService } from "./newsService";
import { podcastService } from "./podcastService";
import { projectsSearchService } from "./projectsSearchService";
import { regionService } from "./regionService";
import { topicService } from "./topicService";

interface IMappedByLocaleData {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  [locale: string]: any;
}

export const nonPageContentTypes = ["project_hub_page"];

const getHeaderEntry = (lang: ContentstackLocales) =>
  getEntry({
    contentTypeUid: ContentTypes.GlobalHeader,
    referenceFieldPath: [],
    lang,
  });

const getFooterEntry = (lang: ContentstackLocales) =>
  getEntry({ contentTypeUid: ContentTypes.GlobalFooter, lang });

const getOnboardingEntry = (lang: ContentstackLocales) =>
  getEntry({
    contentTypeUid: ContentTypes.Onboarding,
    referenceFieldPath: ["subscriptions.subscription_configuration"],
    lang,
  });

const getCookiesBannerEntry = (lang: ContentstackLocales) =>
  getEntry({ contentTypeUid: ContentTypes.CookiesBlock, lang });

const getSinglePageEntry = (
  contentTypeUid: string,
  entryUid: string,
  lang: ContentstackLocales,
) => {
  const config = contentstackConfig[contentTypeUid];

  return getSingleEntry({
    contentTypeUid,
    entryUid,
    lang,
    ...config,
  });
};

const getSingletonPageEntry = (contentTypeUid: string, lang: ContentstackLocales) => {
  const config = contentstackConfig[contentTypeUid];

  return getSingletonEntry({
    contentTypeUid,
    lang,
    ...config,
  });
};

class PageService {
  private isDevelopment = isDevelopmentEnv();

  async getAllPublishedPages(): Promise<IEnrichedPublishedPage[]> {
    const contentTypes = await getPageContentTypes();

    const contentTypesUids = contentTypes
      .map((contentType) => contentType.uid)
      .filter((uid) => !nonPageContentTypes.includes(uid));

    const handlePageEntriesError = (contentTypeUid: string, locale: string) => (error: unknown) => {
      logger.error(
        error,
        `Error retrieving page entries of content type: ${contentTypeUid} of locale: ${locale}`,
      );
      throw error;
    };

    const pageEntriesPromises = contentTypesUids.reduce((acc, contentTypeUid) => {
      const enSpecificPageTypeEntriesPromise = getEntry<IContentstackPage[]>({
        contentTypeUid,
        lang: ContentstackLocales.EN,
      }).then(
        this.getEnrichedPageDetails(contentTypeUid, ContentstackLocales.EN),
        handlePageEntriesError(contentTypeUid, ContentstackLocales.EN),
      );

      const frSpecificPageTypeEntriesPromise = getEntry<IContentstackPage[]>({
        contentTypeUid,
        lang: ContentstackLocales.FR,
      }).then(
        this.getEnrichedPageDetails(contentTypeUid, ContentstackLocales.FR),
        handlePageEntriesError(contentTypeUid, ContentstackLocales.FR),
      );

      acc.push(enSpecificPageTypeEntriesPromise, frSpecificPageTypeEntriesPromise);

      return acc;
    }, [] as Promise<IEnrichedPublishedPage>[]);

    const results = await Promise.all(pageEntriesPromises);

    return results.filter(({ entries }) => Array.isArray(entries) && entries.length);
  }

  getMappedByLocalePageSlugs(
    pages: IEnrichedPublishedPage[],
    mappedDirectories: IMappedByLocaleDirectories,
  ): IMappedByLocalePageSlugs {
    return pages.reduce((acc, { locale, entries }) => {
      entries.forEach((entry: IContentstackPage) => {
        const { uid, url, directory } = entry;
        const directoryUid = directory?.[0]?.uid;
        const directoryDetails = directoryUid
          ? mappedDirectories[locale]?.[directoryUid]
          : undefined;
        const slug = getFullSlug(directoryDetails?.parts, url);

        acc[locale] = acc[locale] || {};
        acc[locale][uid] = slug;
      });

      return acc;
    }, {} as IMappedByLocalePageSlugs);
  }

  async getPageEntry({
    contentTypeUid,
    lang,
    entryUid,
  }: {
    contentTypeUid: string;
    lang: ContentstackLocales;
    entryUid?: string;
  }) {
    /**
     * Muting error logs for local dev as next is doing SSR on dev, so this function can be called
     * before the static paths generation
     */
    const cachedHeaderData = readFromFs<IMappedByLocaleData>({
      fileName: "header",
      muteErrorLog: this.isDevelopment,
    });

    const cachedFooterData = readFromFs<IMappedByLocaleData>({
      fileName: "footer",
      muteErrorLog: this.isDevelopment,
    });

    const cachedCookiesBannerData = readFromFs<IMappedByLocaleData>({
      fileName: "cookiesBanner",
      muteErrorLog: this.isDevelopment,
    });

    const cachedOnboardingData = readFromFs<IMappedByLocaleData>({
      fileName: "onboarding",
      muteErrorLog: this.isDevelopment,
    });

    const cachedHeader = cachedHeaderData?.[lang];
    const cachedFooter = cachedFooterData?.[lang];
    const cachedCookiesBanner = cachedCookiesBannerData?.[lang];
    const cachedOnboarding = cachedOnboardingData?.[lang];

    try {
      const [header, footer, cookiesBanner, onboarding, page] = await Promise.all([
        cachedHeader || getHeaderEntry(lang),
        cachedFooter || getFooterEntry(lang),
        cachedCookiesBanner || getCookiesBannerEntry(lang),
        cachedOnboarding || getOnboardingEntry(lang),
        entryUid
          ? getSinglePageEntry(contentTypeUid, entryUid, lang)
          : getSingletonPageEntry(contentTypeUid, lang),
      ]);

      return {
        header,
        footer,
        cookiesBanner,
        onboarding,
        page,
      };
    } catch (e) {
      logger.error(
        e,
        `Error retrieving page entry by contentType: ${contentTypeUid} entryUid: ${entryUid} locale: ${lang}`,
      );
      throw e; // Rethrowing the error to fail the build
    }
  }

  async getHeaderAndFooter({ lang }: { lang: ContentstackLocales }) {
    try {
      const [header, footer] = await Promise.all([
        getEntry({
          contentTypeUid: ContentTypes.GlobalHeader,
          referenceFieldPath: [],
          lang,
        }),
        getEntry({ contentTypeUid: ContentTypes.GlobalFooter, lang }),
      ]);

      return {
        header,
        footer,
      };
    } catch (e) {
      logger.error(e, `Error retrieving header and footer by locale: ${lang}`);
      throw e;
    }
  }

  async getCookiesBanner({ lang }: { lang: ContentstackLocales }) {
    try {
      return await getEntry({
        contentTypeUid: ContentTypes.CookiesBlock,
        referenceFieldPath: [],
        lang,
      });
    } catch (e) {
      logger.error(e, `Error retrieving cookies banner by locale: ${lang}`);
      throw e;
    }
  }

  async getOnboarding({ lang }: { lang: ContentstackLocales }) {
    try {
      return await getEntry({
        contentTypeUid: ContentTypes.Onboarding,
        referenceFieldPath: ["subscriptions.subscription_configuration"],
        lang,
      });
    } catch (e) {
      logger.error(e, `Error retrieving onboarding by locale: ${lang}`);
      throw e;
    }
  }

  private getEnrichedPageDetails =
    (contentTypeUid: string, locale: ContentstackLocales) =>
    (entries: IContentstackPage[]): IEnrichedPublishedPage => {
      return { contentTypeUid, locale, entries: entries.filter(({ url }) => Boolean(url)) };
    };

  async getPageSpecificData({
    contentTypeUid,
    entryUid,
    lang,
    page,
  }: {
    contentTypeUid: string;
    entryUid: string;
    lang: ContentstackLocales;
    page: IContentstackPage | IContentStackConstructionNoticePage;
  }) {
    try {
      switch (contentTypeUid) {
        // News Listing Page ("listing_page") in the Contentstack
        case ContentTypes.NewsLandingPage: {
          const [news, categories] = await Promise.all([
            newsService.getNews<INewsDetailsPageBaseInfo>({
              lang,
              limit: 10,
              checkHiddenArticles: true,
              only: NEWS_ONLY_FIELDS,
            }),
            newsService.getNewsCategories({ lang }),
          ]);

          return {
            news,
            categories,
          };
        }

        case ContentTypes.NewsArticle: {
          const includePodcastFeed = (page as INewsArticlePage).news_article_components?.some(
            (component) => Boolean(component.Podcast_Component),
          );

          const [news, contactUsPageUrlData, podcastFeed] = await Promise.all([
            newsService.getNews<INewsDetailsPageBaseInfo>({
              lang,
              limit: 5,
              only: NEWS_ONLY_FIELDS,
            }),
            contactUsService.getContactUsPageUrl(lang),
            includePodcastFeed ? podcastService.getPodcastFeed() : Promise.resolve(null),
          ]);

          return {
            news,
            contactUsPageUrlData,
            podcastFeed,
          };
        }

        case ContentTypes.AboutUs:
          return {
            news: await newsService.getNews<INewsDetailsPageBaseInfo>({
              lang,
              limit: 5,
              only: NEWS_ONLY_FIELDS,
            }),
          };

        case ContentTypes.Homepage: {
          const eventsData = readFromFs<IMappedByLocaleEvents>({ fileName: "events" });
          const events = Object.values(eventsData?.[lang] || {});

          return {
            news: await newsService.getNews<INewsDetailsPageBaseInfo>({
              lang,
              limit: 5,
              only: NEWS_ONLY_FIELDS,
            }),
            events: events.sort(
              (a, b) =>
                new Date(a.joinAnEvent.event_start_time).getTime() -
                new Date(b.joinAnEvent.event_start_time).getTime(),
            ),
          };
        }
        case ContentTypes.TopicPage:
        case ContentTypes.RegionPage: {
          const projects = readFromFs<IMappedByLocaleProjects>({ fileName: "projects" });
          const eventsData = readFromFs<IMappedByLocaleEvents>({ fileName: "events" });
          const currentLocaleProjects = projects?.[lang] || {};
          const currentProjects = Object.values(currentLocaleProjects);
          const events = Object.values(eventsData?.[lang] || {});
          const preSelectedProjects = (page as IRegionPage | ITopicPage)?.project_hub_block || [];
          const filteredProjects = currentProjects.filter(
            (project) =>
              project.topic?.some((item) => item.uid === entryUid) ||
              project.region?.some((item) => item.uid === entryUid),
          );
          const manuallySortedProjects = preSelectedProjects
            .map(({ uid: uidA }) => filteredProjects?.find(({ uid: uidB }) => uidA === uidB))
            .filter(Boolean) as IProject[];
          const restProjects = filteredProjects.filter(
            ({ uid: uidA }) => !manuallySortedProjects.find(({ uid: uidB }) => uidA === uidB),
          );
          const sortedProjects = [...manuallySortedProjects, ...restProjects];

          return {
            projects: sortedProjects.map((project) => {
              const projectNav = mapProjectNavigationToLinks(project);

              return {
                uid: project.uid,
                base_content: project.base_content,
                ...(projectNav && { project_navigation: projectNav }),
              };
            }),
            events: events
              .filter(
                (event) =>
                  event.region?.uid === entryUid ||
                  event.topics?.some((topic) => topic.uid === entryUid),
              )
              .map(mapEventToLinkedEventsData)
```
