```
import { GetStaticPaths, GetStaticProps } from "next";
import { serverSideTranslations } from "next-i18next/serverSideTranslations";
import { NextLocales } from "@metrolinx/cx-shared/build/src/constants/locales";
import { Layout } from "components/Layout";
import { PageHead } from "components/pages/PageHead";
import { TLineColors } from "context/LineColorsContext";
import { TEnrichedNextPage } from "interface/common";
import { IGlobalDictionary } from "interface/content/globalDictionary";
import { IContentstackPage } from "interface/content/page";
import { IDirectoryData, IMappedByLocaleDirectories } from "interface/directory";
import { onBoardingService } from "services/onBoardingService";
import { resolvePageComponent } from "services/pageComponentResolver";
import { pageService } from "services/pageService";
import { staticPathsResolver } from "services/staticPathsResolver";
import { getBreadcrumbs } from "utils/breadcrumbs";
import { readFromFs } from "utils/fsCache";
import { getLocaleByNextLocale } from "utils/locale";
import { readCachedPageDataFromFs } from "utils/pageDataCache";
import { refineClientData } from "utils/refineClientData";

interface IDynamicSlugParams {
  slug: string[];
}

export interface IPageProps {
  session: any;
  content: {
    // TODO: Define types for header and footer
    header: [any];
    footer: [any];
    page: [IContentstackPage];
    directories: IDirectoryData;
    languageAlternativePageSlug?: string[];
  };
  contentTypeUid: string;
}

const Page: TEnrichedNextPage<IPageProps> = ({ content, contentTypeUid }) => {
  const PageComponent = resolvePageComponent(contentTypeUid);

  return (
    <>
      <PageHead page={content?.page} contentTypeUid={contentTypeUid} />
      {PageComponent ? <PageComponent {...content} /> : <h1>Page not implemented</h1>}
    </>
  );
};

Page.Layout = Layout;

export const getStaticPaths: GetStaticPaths = async () => {
  const { MAINTENANCE_MODE } = process.env;

  if (MAINTENANCE_MODE === "true") {
    return { paths: [], fallback: false };
  }

  const paths = await staticPathsResolver.resolveStaticPaths();

  return {
    paths,
    fallback: false,
  };
};

export const getStaticProps: GetStaticProps = async (context) => {
  const { locale: nextLocale = "" } = context;
  const { slug = [] } = (context?.params as unknown as IDynamicSlugParams) || {};

  const {
    uid: pageUid,
    contentTypeUid,
    languageAlternativePageSlug,
    entry: pageContent,
  } = readCachedPageDataFromFs([nextLocale, ...slug]);

  const contentstackLocale = getLocaleByNextLocale(nextLocale);
  const directories = readFromFs<IMappedByLocaleDirectories>({ fileName: "directories" });
  const currentLocaleDirectories = directories?.[contentstackLocale] || {};

  const breadcrumbs = getBreadcrumbs({
    pageUrl: pageContent.url,
    pageBreadcrumbLabel: pageContent.breadcrumb_label?.breadcrumb_label || pageContent.title,
    directories: currentLocaleDirectories,
    directoryUid: pageContent.directory?.[0]?.uid || "",
  });

  const onBoardingData = await onBoardingService.getPageSpecificData(contentstackLocale);

  let pageSpecificData: any;

  try {
    pageSpecificData = await pageService.getPageSpecificData({
      contentTypeUid,
      entryUid: pageUid,
      lang: contentstackLocale,
    });
  } catch {
    pageSpecificData = null;
  }

  const cachedFooterData = readFromFs<{ [locale: string]: any }>({
    fileName: "footer",
  });
  const cachedHeaderData = readFromFs<{ [locale: string]: any }>({
    fileName: "header",
  });
  const cachedServiceAlerts = readFromFs<{ [locale: string]: any }>({
    fileName: "serviceAlerts",
  });
  const cachedStaticUpdates = readFromFs<{ [locale: string]: any }>({
    fileName: "staticUpdates",
  });
  const cachedCookiesBanner = readFromFs<{ [locale: string]: any }>({
    fileName: "cookiesBanner",
  });
  const cachedGlobalDictionary = readFromFs<{ [locale: string]: [IGlobalDictionary] }>({
    fileName: "globalDictionary",
  });
  const lineColors = readFromFs<TLineColors>({
    fileName: "lineColors",
  });
  const cachedPagesBaseURLs = readFromFs<{ [locale: string]: Record<string, string> }>({
    fileName: "pagesBaseURLs",
  });

  const footer = cachedFooterData?.[contentstackLocale];
  const header = cachedHeaderData?.[contentstackLocale];
  const serviceAlerts = cachedServiceAlerts?.[contentstackLocale];
  const staticUpdates = cachedStaticUpdates?.[contentstackLocale];
  const cookiesBanner = cachedCookiesBanner?.[contentstackLocale];
  const globalDictionary = cachedGlobalDictionary?.[contentstackLocale];
  const pagesBaseURLs = cachedPagesBaseURLs?.[contentstackLocale];

  return {
    props: {
      content: refineClientData(
        {
          cookiesBanner,
          header,
          footer,
          globalDictionary,
          serviceAlerts,
          staticUpdates,
          page: [pageContent],
          pageSpecificData,
          onBoardingData,
          directories: currentLocaleDirectories,
          pagesBaseURLs,
          languageAlternativePageSlug,
          breadcrumbs,
        },
        nextLocale as NextLocales,
      ),
      contentTypeUid,
      lineColors: lineColors ?? {},
      ...(await serverSideTranslations(nextLocale, ["common"])),
    },
  };
};

export default Page;
```

