```
import {
  createContext,
  Dispatch,
  ReactNode,
  SetStateAction,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useState,
} from "react";
import { ContentTypes } from "constants/contentstack";
import { IGlobalDictionary } from "interface/content/globalDictionary";
import { IContentstackPage, IPageSpecificData } from "interface/content/page";
import { ILocalizedSelectOption } from "interface/content/page";
import { IPageLevelServiceAlertsContent } from "interface/content/serviceAlerts";
import { IDirectoryData } from "interface/directory";
import { IBreadcrumb } from "interface/page";
import { IStaticUpdates } from "interface/serviceUpdates";
import { Stack } from "services/contentstack";

export interface IContentstackContent {
  // TODO(devteam): define types for header and footer
  header?: [any];
  footer?: [any];
  staticUpdates?: IStaticUpdates;
  serviceAlerts?: IPageLevelServiceAlertsContent;
  page?: [IContentstackPage];
  pageSpecificData?: IPageSpecificData;
  directories?: IDirectoryData;
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  languageAlternativePageSlug?: string[];
  onBoardingData?: {
    primaryReasonForTravel: ILocalizedSelectOption[];
    aboutYou: ILocalizedSelectOption[];
    travelInterests: ILocalizedSelectOption[];
  };
  globalDictionary?: [IGlobalDictionary];
  breadcrumbs?: IBreadcrumb[];
}

export interface ILivePreview {
  enabled: boolean;
  previewKey?: string;
}

interface IContentStackProviderProps {
  defaultContent?: IContentstackContent;
  children: ReactNode;
}

export const ContentstackContext = createContext<{
  content: IContentstackContent;
  livePreview: ILivePreview;
  setLivePreview: Dispatch<SetStateAction<ILivePreview>>;
  updateContent: (updatedContent: Partial<IContentstackContent>) => void;
}>({
  content: {},
  livePreview: { enabled: false },
  setLivePreview: () => undefined,
  updateContent: () => undefined,
});

export const useContentstackContext = () => {
  const context = useContext(ContentstackContext);

  if (!context) {
    throw new Error("useContentstackContext must be used within the ContentstackProvider");
  }

  return context;
};

export const ContentstackProvider = ({
  defaultContent = {},
  children,
}: IContentStackProviderProps) => {
  const [content, setContent] = useState<IContentstackContent>(defaultContent);
  const [livePreview, setLivePreview] = useState<ILivePreview>({
    enabled: process.env.CONTENTSTACK_LIVE_PREVIEW === "true",
    previewKey: process.env.CONTENTSTACK_PREVIEW_KEY,
  });

  // Merge live/draft content updates (e.g. from Contentstack's onEntryChange
  // live preview callback) into state so every useContent consumer re-renders
  // with the latest draft content automatically, with no component-level
  // changes required.
  const updateContent = useCallback((updatedContent: Partial<IContentstackContent>) => {
    setContent((previousContent) => ({
      ...previousContent,
      ...updatedContent,
    }));
  }, []);

  useEffect(() => {
    if (defaultContent && Object.keys(defaultContent).length > 0) {
      setContent((previousContent) => ({
        ...previousContent,
        ...defaultContent,
      }));
    }
  }, [defaultContent]);

  // Subscribe to Contentstack live preview updates through the same SDK Stack
  // that ContentstackFactory (src/services/contentstack.ts) wraps, so preview
  // traffic flows through the existing configured client.
  useEffect(() => {
    if (!livePreview.enabled) {
      return;
    }

    const stackWithLivePreview = Stack as unknown as {
      livePreview?: { onEntryChange?: (cb: (data: unknown) => void) => void };
    };

    if (typeof stackWithLivePreview.livePreview?.onEntryChange === "function") {
      stackWithLivePreview.livePreview.onEntryChange((data) => {
        updateContent(data as Partial<IContentstackContent>);
      });
    }
  }, [livePreview.enabled, updateContent]);

  const context = useMemo(
    () => ({
      content,
      livePreview,
      setLivePreview,
      updateContent,
    }),
    [content, livePreview, updateContent],
  );

  return <ContentstackContext.Provider value={context}>{children}</ContentstackContext.Provider>;
};
```

