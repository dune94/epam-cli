```
/**
 * Unit tests for Contentstack Live Preview wiring in src/services/contentstack.ts.
 *
 * These tests validate the three acceptance-criteria behaviours:
 *  1. Stack options include a `live_preview` block with `enable: true` and
 *     `preview_token: CONTENTSTACK_PREVIEW_TOKEN` (NOT `management_token`)
 *     when CONTENTSTACK_PREVIEW_TOKEN is set.
 *  2. Stack options DO NOT include `live_preview` when CONTENTSTACK_PREVIEW_TOKEN is unset.
 *  3. Stack.setHost is called with CONTENTSTACK_PREVIEW_HOST when set, taking priority
 *     over CONTENTSTACK_API_HOST.
 *
 * The src/services/contentstack.ts module reads env vars at import-time and
 * constructs the Contentstack Stack at module-evaluation time, so we must
 * manipulate process.env and then `jest.resetModules()` + re-require the module
 * inside each test (mirrors the existing pattern in __tests__/next.config.source.spec.ts).
 */

const ORIGINAL_ENV = process.env;

const mockStack = {
  setHost: jest.fn(),
  ContentType: jest.fn(),
  getContentTypes: jest.fn(),
};

jest.mock("contentstack", () => ({
  Stack: jest.fn(() => mockStack),
}));

jest.mock("@contentstack/utils", () => ({
  jsonToHTML: jest.fn(),
}));

jest.mock("services/logger", () => ({
  __esModule: true,
  default: {
    error: jest.fn(),
  },
}));

jest.mock("utils/envs", () => ({
  isTestEnv: () => true,
}));

const loadServiceModule = () => {
  jest.resetModules();
  // Re-require the contentstack module after env and mocks are set.
  // eslint-disable-next-line @typescript-eslint/no-var-requires
  const contentstackModule = require("../../../src/services/contentstack");
  return contentstackModule;
};

describe("contentstack service — Live Preview wiring", () => {
  let contentstackPkg: { Stack: jest.Mock };

  beforeEach(() => {
    jest.clearAllMocks();
    mockStack.setHost.mockClear();
    contentstackPkg = require("contentstack");
    contentstackPkg.Stack.mockClear();
    contentstackPkg.Stack.mockImplementation(() => mockStack);
    // Reset env to a known base before each test sets its own vars.
    process.env = { ...ORIGINAL_ENV };
    delete process.env.CONTENTSTACK_PREVIEW_TOKEN;
    delete process.env.CONTENTSTACK_PREVIEW_HOST;
    delete process.env.CONTENTSTACK_API_HOST;
  });

  afterAll(() => {
    process.env = ORIGINAL_ENV;
  });

  it("includes a live_preview block with preview_token (not management_token) when CONTENTSTACK_PREVIEW_TOKEN is set", () => {
    process.env.CONTENTSTACK_PREVIEW_TOKEN = "preview-token-abc123";

    const { options } = loadServiceModule();

    expect(options.live_preview).toBeDefined();
    expect(options.live_preview.enable).toBe(true);
    expect(options.live_preview.preview_token).toBe("preview-token-abc123");
    // Guard against the prior defect: must NOT be management_token.
    expect(options.live_preview.management_token).toBeUndefined();
    // Guard against the prior defect: no host inside the live_preview block.
    expect(options.live_preview.host).toBeUndefined();
  });

  it("omits the live_preview block when CONTENTSTACK_PREVIEW_TOKEN is unset", () => {
    delete process.env.CONTENTSTACK_PREVIEW_TOKEN;

    const { options } = loadServiceModule();

    expect(options.live_preview).toBeUndefined();
  });

  it("calls Stack.setHost with CONTENTSTACK_PREVIEW_HOST when set, taking priority over CONTENTSTACK_API_HOST", () => {
    process.env.CONTENTSTACK_PREVIEW_HOST = "preview.contentstack.com";
    process.env.CONTENTSTACK_API_HOST = "api.contentstack.com";

    loadServiceModule();

    expect(mockStack.setHost).toHaveBeenCalledTimes(1);
    expect(mockStack.setHost).toHaveBeenCalledWith("preview.contentstack.com");
  });
});
```

