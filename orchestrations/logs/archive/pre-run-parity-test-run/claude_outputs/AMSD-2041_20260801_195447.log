const loadFreshModule = () => {
  let mod: any;
  jest.isolateModules(() => {
    mod = require("services/contentstack");
  });
  return mod;
};

describe("contentstack service - live preview wiring", () => {
  const OLD_ENV = process.env;

  let StackMock: any;

  beforeEach(() => {
    jest.resetModules();
    process.env = { ...OLD_ENV };

    process.env.CONTENTSTACK_API_KEY = "TEST_KEY";
    process.env.CONTENTSTACK_DELIVERY_TOKEN = "TEST_DELIVERY_TOKEN";
    process.env.CONTENTSTACK_ENVIRONMENT = "TEST_ENVIRONMENT";
    process.env.CONTENTSTACK_BRANCH = "TEST_BRANCH";
    process.env.NODE_ENV = "test";

    StackMock = {
      ContentType: jest.fn().mockImplementation(() => ({
        Query: () => ({
          language: () => ({
            toJSON: () => ({ mockQuery: true }),
          }),
        }),
        Entry: () => ({
          language: () => ({
            toJSON: () => ({ mockEntry: true }),
            fetch: jest.fn().mockResolvedValue({ mockEntryResult: true }),
          }),
        }),
      })),
      setHost: jest.fn(),
      livePreviewQuery: jest.fn(),
    };

    jest.doMock("contentstack", () => ({
      __esModule: true,
      default: {
        Stack: jest.fn(() => StackMock),
      },
      Stack: jest.fn(() => StackMock),
    }));
  });

  afterEach(() => {
    jest.clearAllMocks();
  });

  afterAll(() => {
    process.env = OLD_ENV;
  });

  describe("live_preview block on stack options", () => {
    it("includes a live_preview block with preview_token when CONTENTSTACK_PREVIEW_TOKEN is set", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = "PREVIEW_TOKEN_VALUE";

      const { options } = loadFreshModule();

      expect(options.live_preview).toEqual({
        enable: true,
        preview_token: "PREVIEW_TOKEN_VALUE",
      });
    });

    it("does not include a live_preview block when CONTENTSTACK_PREVIEW_TOKEN is unset", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = undefined;

      const { options } = loadFreshModule();

      expect(options.live_preview).toBeUndefined();
    });

    it("uses preview_token (not management_token) inside live_preview", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = "PREVIEW_TOKEN_VALUE";

      const { options } = loadFreshModule();

      expect(options.live_preview).toHaveProperty("preview_token");
      expect(options.live_preview).not.toHaveProperty("management_token");
    });

    it("does not put a host field inside the live_preview block", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = "PREVIEW_TOKEN_VALUE";

      const { options } = loadFreshModule();

      expect(options.live_preview).not.toHaveProperty("host");
    });
  });

  describe("Stack.setHost priority", () => {
    it("calls Stack.setHost with CONTENTSTACK_PREVIEW_HOST when set", () => {
      process.env.CONTENTSTACK_API_HOST = "api.contentstack.com";
      process.env.CONTENTSTACK_PREVIEW_HOST = "preview.contentstack.com";

      loadFreshModule();

      expect(StackMock.setHost).toHaveBeenCalledWith("preview.contentstack.com");
    });

    it("falls back to CONTENTSTACK_API_HOST when CONTENTSTACK_PREVIEW_HOST is unset", () => {
      process.env.CONTENTSTACK_API_HOST = "api.contentstack.com";
      process.env.CONTENTSTACK_PREVIEW_HOST = undefined;

      loadFreshModule();

      expect(StackMock.setHost).toHaveBeenCalledWith("api.contentstack.com");
    });

    it("does not call Stack.setHost when neither host env var is set", () => {
      process.env.CONTENTSTACK_API_HOST = undefined;
      process.env.CONTENTSTACK_PREVIEW_HOST = undefined;

      loadFreshModule();

      expect(StackMock.setHost).not.toHaveBeenCalled();
    });
  });

  describe("live_preview flowing through queries via setCommonConfig", () => {
    it("forwards preview_hash to stack.livePreviewQuery when set", async () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = "PREVIEW_TOKEN_VALUE";

      const { findSingletonEntry } = loadFreshModule();

      const livePreviewQuerySpy = StackMock.livePreviewQuery as jest.Mock;

      StackMock.ContentType.mockImplementationOnce(() => {
        const findMock = jest.fn().mockResolvedValue([[{ uid: "x" }], 1]);
        const queryInstance: any = {
          includeCount: jest.fn().mockReturnThis(),
          skip: jest.fn().mockReturnThis(),
          limit: jest.fn().mockReturnThis(),
          where: jest.fn().mockReturnThis(),
          includeReference: jest.fn().mockReturnThis(),
          only: jest.fn().mockReturnThis(),
          except: jest.fn().mockReturnThis(),
          find: findMock,
        };
        return {
          Query: () => ({
            language: () => ({
              toJSON: () => queryInstance,
            }),
          }),
        };
      });

      const result = await findSingletonEntry({
        contentTypeUid: "page",
        lang: "en-ca" as any,
        live_preview: { enable: true, preview_hash: "abc123" },
      });

      expect(result).toEqual({ uid: "x" });
      expect(livePreviewQuerySpy).toHaveBeenCalledWith(
        expect.objectContaining({ live_preview: "abc123", content_type_uid: "page" }),
      );
    });

    it("does not call livePreviewQuery when live_preview is absent", async () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = undefined;

      const { findSingletonEntry } = loadFreshModule();

      const livePreviewQuerySpy = StackMock.livePreviewQuery as jest.Mock;

      StackMock.ContentType.mockImplementationOnce(() => {
        const findMock = jest.fn().mockResolvedValue([[{ uid: "y" }], 1]);
        const queryInstance: any = {
          includeCount: jest.fn().mockReturnThis(),
          skip: jest.fn().mockReturnThis(),
          limit: jest.fn().mockReturnThis(),
          where: jest.fn().mockReturnThis(),
          includeReference: jest.fn().mockReturnThis(),
          only: jest.fn().mockReturnThis(),
          except: jest.fn().mockReturnThis(),
          find: findMock,
        };
        return {
          Query: () => ({
            language: () => ({
              toJSON: () => queryInstance,
            }),
          }),
        };
      });

      const result = await findSingletonEntry({
        contentTypeUid: "page",
        lang: "en-ca" as any,
      });

      expect(result).toEqual({ uid: "y" });
      expect(livePreviewQuerySpy).not.toHaveBeenCalled();
    });
  });
});
