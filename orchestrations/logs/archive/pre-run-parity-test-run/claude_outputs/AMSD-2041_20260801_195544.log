/* eslint-disable @typescript-eslint/no-var-requires, @typescript-eslint/no-explicit-any */
export {};

// Stable mock object referenced by the factory below. jest.resetModules()
// clears the require cache but the factory is still registered, so subsequent
// requires for "contentstack" will hand back this object again.
const contentstackMock = {
  Stack: jest.fn(),
};

// Hoisted mock: any `require("contentstack")` inside the test or the SUT
// returns the mock above. `jest.resetModules` between tests re-runs this
// factory for each fresh require, giving us the same `contentstackMock`
// instance back each time.
jest.mock("contentstack", () => contentstackMock);

const ENV_KEYS = [
  "CONTENTSTACK_API_KEY",
  "CONTENTSTACK_DELIVERY_TOKEN",
  "CONTENTSTACK_ENVIRONMENT",
  "CONTENTSTACK_API_HOST",
  "CONTENTSTACK_PREVIEW_HOST",
  "CONTENTSTACK_PREVIEW_TOKEN",
  "CONTENTSTACK_BRANCH",
  "CONTENTSTACK_FETCH_TIMEOUT",
];

const setEnv = (vars: Record<string, string | undefined>) => {
  ENV_KEYS.forEach((k) => {
    if (vars[k] === undefined) delete process.env[k];
    else process.env[k] = vars[k];
  });
};

const baseEnv = {
  CONTENTSTACK_API_KEY: "test-api-key",
  CONTENTSTACK_DELIVERY_TOKEN: "test-delivery-token",
  CONTENTSTACK_ENVIRONMENT: "test-env",
  CONTENTSTACK_BRANCH: "main",
};

describe("contentstack service - Live Preview configuration", () => {
  beforeEach(() => {
    jest.resetModules();
    contentstackMock.Stack.mockReset();
    setEnv({ ...baseEnv });
  });

  afterEach(() => {
    setEnv({});
  });

  it("enables live_preview when CONTENTSTACK_PREVIEW_TOKEN is set", () => {
    // Arrange
    const setHost = jest.fn();
    contentstackMock.Stack.mockReturnValueOnce({ setHost });
    process.env.CONTENTSTACK_PREVIEW_TOKEN = "preview-token-abc";

    // Act
    let mod: any;
    jest.isolateModules(() => {
      mod = require("services/contentstack");
    });

    // Assert
    expect(mod.options.live_preview).toEqual({
      enable: true,
      preview_token: "preview-token-abc",
    });
    const passedConfig = contentstackMock.Stack.mock.calls[0][0];
    expect(passedConfig.live_preview).toEqual({
      enable: true,
      preview_token: "preview-token-abc",
    });
    expect(setHost).not.toHaveBeenCalled();
    expect(mod.Stack.setHost).toBe(setHost);
  });

  it("omits live_preview when CONTENTSTACK_PREVIEW_TOKEN is unset", () => {
    // Arrange
    const setHost = jest.fn();
    contentstackMock.Stack.mockReturnValueOnce({ setHost });
    delete process.env.CONTENTSTACK_PREVIEW_TOKEN;

    // Act
    let mod: any;
    jest.isolateModules(() => {
      mod = require("services/contentstack");
    });

    // Assert
    expect(mod.options.live_preview).toBeUndefined();
    const passedConfig = contentstackMock.Stack.mock.calls[0][0];
    expect(passedConfig.live_preview).toBeUndefined();
    expect(mod.options.api_key).toBe("test-api-key");
    expect(mod.options.delivery_token).toBe("test-delivery-token");
    expect(mod.options.environment).toBe("test-env");
    expect(mod.options.branch).toBe("main");
    expect(setHost).not.toHaveBeenCalled();
  });

  it("prefers CONTENTSTACK_PREVIEW_HOST over CONTENTSTACK_API_HOST for setHost", () => {
    // Arrange
    const setHost = jest.fn();
    contentstackMock.Stack.mockReturnValueOnce({ setHost });
    process.env.CONTENTSTACK_API_HOST = "api.contentstack.com";
    process.env.CONTENTSTACK_PREVIEW_HOST = "preview.contentstack.com";

    // Act
    jest.isolateModules(() => {
      require("services/contentstack");
    });

    // Assert - preview host wins
    expect(setHost).toHaveBeenCalledTimes(1);
    expect(setHost).toHaveBeenCalledWith("preview.contentstack.com");
  });

  it("falls back to CONTENTSTACK_API_HOST when CONTENTSTACK_PREVIEW_HOST is unset", () => {
    // Arrange
    const setHost = jest.fn();
    contentstackMock.Stack.mockReturnValueOnce({ setHost });
    process.env.CONTENTSTACK_API_HOST = "api.contentstack.com";
    delete process.env.CONTENTSTACK_PREVIEW_HOST;

    // Act
    jest.isolateModules(() => {
      require("services/contentstack");
    });

    // Assert - API host used as fallback
    expect(setHost).toHaveBeenCalledTimes(1);
    expect(setHost).toHaveBeenCalledWith("api.contentstack.com");
  });

  it("does not call setHost when neither host env var is set", () => {
    // Arrange
    const setHost = jest.fn();
    contentstackMock.Stack.mockReturnValueOnce({ setHost });
    delete process.env.CONTENTSTACK_API_HOST;
    delete process.env.CONTENTSTACK_PREVIEW_HOST;

    // Act
    jest.isolateModules(() => {
      require("services/contentstack");
    });

    // Assert
    expect(setHost).not.toHaveBeenCalled();
  });
});
