      expect(exceptSpy.mock.calls[2][0]).toEqual("a.b.c");
      expect(exceptSpy.mock.calls[2][1]).toEqual(["exceptArrElt"]);
      expect(languageSpy).toHaveBeenCalledWith(ContentstackLocales.EN);
      expect(includeReferenceSpy).toHaveBeenCalledWith(["a.b.c"]);
      expect(toJSONSpy).toHaveBeenCalled();
      expect(fetchSpy).toHaveBeenCalled();
      expect(onlySpy.mock.calls[0][0]).toEqual("a.b");
      expect(onlySpy.mock.calls[0][1]).toEqual("onlyRef");
      expect(onlySpy.mock.calls[1][0]).toEqual("a.b.c");
      expect(onlySpy.mock.calls[1][1]).toEqual(["onlyArrElt"]);
      expect(result).toEqual({ uid: "newsArticleUid" });
    });
  });

  describe("getPageContentTypes", () => {
    it("should call getContentTypes method on stack", async () => {
      const getContentTypesSpy = jest.spyOn(Stack, "getContentTypes");

      const result = await getPageContentTypes();

      expect(getContentTypesSpy).toHaveBeenCalledWith({ query: { "options.is_page": true } });
      expect(result).toEqual(["1", "2", "3"]);
    });
  });
  describe("live preview support", () => {
    it("should include live_preview block in options when CONTENTSTACK_PREVIEW_TOKEN is set", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = "preview-token-value";

      // eslint-disable-next-line @typescript-eslint/no-var-requires
      const testedModule = require("../contentstack.ts");

      expect(testedModule.options).toEqual(
        expect.objectContaining({
          live_preview: {
            enable: true,
            preview_token: "preview-token-value",
          },
        }),
      );
    });

    it("should omit live_preview block in options when CONTENTSTACK_PREVIEW_TOKEN is unset", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = undefined;

      // eslint-disable-next-line @typescript-eslint/no-var-requires
      const testedModule = require("../contentstack.ts");

      expect(testedModule.options).not.toHaveProperty("live_preview");
    });

    it("should prioritize CONTENTSTACK_PREVIEW_HOST over CONTENTSTACK_API_HOST when set", () => {
      process.env.CONTENTSTACK_PREVIEW_HOST = "preview-rest.contentstack.com";
      process.env.CONTENTSTACK_API_HOST = "api.contentstack.io";

      // module-init runs `Stack(options)` and then `.setHost(host)`.
      // Re-importing      // Stack factory whose returned instances carry their own mock
      // `setHost` jest fn. We must capture the *post-init* instance's
      // setHost by requiring the module first, then re-requiring
      // contentstack to grab the SAME factory's mock instance.
      // eslint-disable-next-line @typescript-eslint/no-var-requires
      const contentstackMock = require("contentstack");
      const StackFactory = contentstackMock.Stack as jest.Mock;

      // eslint-disable-next-line @typescript-eslint/no-var-requires
      require("../contentstack.ts");

      // Every `Stack(options)` call registers a new mock instance on the
      // factory. The LAST instance corresponds to the module-init call.
      const mockInstances = StackFactory.mock.results.map((r: any) => r.value);
      const lastInstance = mockInstances[mockInstances.length - 1];
      const setHostSpy = lastInstance.setHost;

      expect(setHostSpy).toHaveBeenCalledWith("preview-rest.contentstack.com");
      expect(setHostSpy).not.toHaveBeenCalledWith("api.contentstack.io");
    });
  });
});
```

