      expect(exceptSpy).toHaveBeenCalledWith(excludedFields);
      expect(languageSpy).toHaveBeenCalledWith(ContentstackLocales.EN);
      expect(includeCountSpy).toHaveBeenCalled();
      expect(includeReferenceSpy).toHaveBeenCalledWith(["a.b.c"]);
      expect(toJSONSpy).toHaveBeenCalled();
      expect(findSpy).toHaveBeenCalled();
      expect(result).toEqual([{ uid: "newsArticleUid" }, { uid: "newsArticleUid2" }]);
    });

    it("should additionally request other batches if not all results returned by a single call", async () => {
      const skipSpy = jest.spyOn(Stack, "skip" as any);
      const limitSpy = jest.spyOn(Stack, "limit" as any);

      jest
        .spyOn(Stack, "find" as any)
        .mockResolvedValueOnce([[{ uid: "newsArticleUid" }, { uid: "newsArticleUid2" }], 4]);
      const result = await getEntry({
        contentTypeUid: "contentType",
        lang: ContentstackLocales.EN,
        referenceFieldPath: ["a.b.c"],
      });

      expect(skipSpy).toHaveBeenCalledWith(2);
      expect(limitSpy).toHaveBeenCalledWith(100);
      expect(result).toEqual([
        { uid: "newsArticleUid" },
        { uid: "newsArticleUid2" },
        { uid: "newsArticleUid" },
        { uid: "newsArticleUid2" },
      ]);
    });
  });

  describe("getSingleEntry", () => {
    it("should call contentstack methods to retrieve data", async () => {
      const contentTypeSpy = jest.spyOn(Stack, "ContentType");
      const entrySpy = jest.spyOn(Stack, "Entry" as any);
      const exceptSpy = jest.spyOn(Stack, "except" as any);
      const languageSpy = jest.spyOn(Stack, "language" as any);
      const includeReferenceSpy = jest.spyOn(Stack, "includeReference" as any);
      const toJSONSpy = jest.spyOn(Stack, "toJSON" as any);
      const fetchSpy = jest.spyOn(Stack, "fetch" as any);
      const onlySpy = jest.spyOn(Stack, "only" as any);
      const result = await getSingleEntry({
        contentTypeUid: "contentType",
        entryUid: "entryUid",
        lang: ContentstackLocales.EN,
        referenceFieldPath: ["a.b.c"],
        only: { "a.b": "onlyRef", "a.b.c": ["onlyArrElt"] },
        except: { "a.b": "exceptRef", "a.b.c": ["exceptArrElt"] },
      });

      expect(contentTypeSpy).toHaveBeenCalledWith("contentType");
      expect(entrySpy).toHaveBeenCalledWith("entryUid");
      expect(exceptSpy.mock.calls[0][0]).toEqual(excludedFields);
      expect(exceptSpy.mock.calls[1][0]).toEqual("a.b");
      expect(exceptSpy.mock.calls[1][1]).toEqual("exceptRef");
      expect(exceptSpy.mock.calls[2][0]).toEqual("a.b.c");
      expect(exceptSpy.mock.calls[2][1]).toEqual(["exceptArrElt"]);
      expect(languageSpy).toHaveBeenCalledWith(ContentstackLocales.EN);
      expect(includeReferenceSpy).toHaveBeenCalledWith(["a.b.c"]);
      expect(toJSONSpy).toHaveBeenCalled();
      expect(fetchSpy).toHaveBeenCalled();
      expect(onlySpy.mock.calls[0][0]).toEqual("a.b");
      expect(onlySpy.mock.calls[0][1]).toEqual("onlyRef");
      expect(onlySpy.mock.calls[1][0]).toEqual("a.b.c");
      expect(onlySpy.mock.calls[1][1]).toEqual(["onlyArrElt"]);
      expect(result).toEqual({ uid: "newsArticleUid" });
    });
  });

  describe("getPageContentTypes", () => {
    it("should call getContentTypes method on stack", async () => {
      const getContentTypesSpy = jest.spyOn(Stack, "getContentTypes");

      const result = await getPageContentTypes();

      expect(getContentTypesSpy).toHaveBeenCalledWith({ query: { "options.is_page": true } });
      expect(result).toEqual(["1", "2", "3"]);
    });
  });

  describe("live preview", () => {
    it("should forward live_preview to query.livePreviewQuery when provided", async () => {
      const livePreviewQuerySpy = jest.spyOn(Stack, "livePreviewQuery" as any);
      const previewHash = "preview-hash-123";

      await getSingleEntry({
        contentTypeUid: "contentType",
        entryUid: "entryUid",
        lang: ContentstackLocales.EN,
        live_preview: { live_preview: previewHash },
      });

      expect(livePreviewQuerySpy).toHaveBeenCalledWith(
        expect.objectContaining({ live_preview: previewHash }),
      );
    });

    it("should forward content_type_uid when provided alongside live_preview", async () => {
      const livePreviewQuerySpy = jest.spyOn(Stack, "livePreviewQuery" as any);
      const previewHash = "preview-hash-456";
      const contentTypeUid = "page";

      await getSingleEntry({
        contentTypeUid,
        entryUid: "entryUid",
        lang: ContentstackLocales.EN,
        live_preview: { live_preview: previewHash, content_type_uid: contentTypeUid },
      });

      expect(livePreviewQuerySpy).toHaveBeenCalledWith(
        expect.objectContaining({
          live_preview: previewHash,
          content_type_uid: contentTypeUid,
        }),
      );
    });

    it("should not call livePreviewQuery when live_preview is omitted from config", async () => {
      const livePreviewQuerySpy = jest.spyOn(Stack, "livePreviewQuery" as any);

      await getSingleEntry({
        contentTypeUid: "contentType",
        entryUid: "entryUid",
        lang: ContentstackLocales.EN,
      });

      expect(livePreviewQuerySpy).not.toHaveBeenCalled();
    });

    it("should configure live_preview on Stack options when preview env vars are set", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = "preview-token";
      process.env.CONTENTSTACK_PREVIEW_HOST = "preview.contentstack.com";

      // eslint-disable-next-line @typescript-eslint/no-var-requires
      const testedModule = require("../contentstack.ts");

      expect(testedModule.options).toEqual(
        expect.objectContaining({
          live_preview: {
            enable: true,
            host: "preview.contentstack.com",
            management_token: "preview-token",
          },
        }),
      );
    });

    it("should omit live_preview from Stack options when preview env vars are missing", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = undefined;
      process.env.CONTENTSTACK_PREVIEW_HOST = undefined;

      // eslint-disable-next-line @typescript-eslint/no-var-requires
      const testedModule = require("../contentstack.ts");

      expect(testedModule.options.live_preview).toBeUndefined();
    });
  });
});
