    it("should log error if request to contentstack fails", async () => {
      jest
        .spyOn(Stack, "getContentTypes" as any)
        .mockRejectedValueOnce(new Error("Contentstack error"));

      await expect(getPageContentTypes()).rejects.toThrow(new Error("Contentstack error"));
      expect(logger.error).toHaveBeenCalledWith(
        "Contentstack error",
        "Error retrieving pages content types",
      );
    });
  });
});
