import { IRichTextDocument } from "@metrolinx/cx-shared/build/src/interface/content/richText";
import { ContentstackLocales } from "constants/contentstack";
import { IContentstackPage } from "./content/page";

export interface ICommonContentstackConfig {
  referenceFieldPath?: string[];
  only?: Record<string, string | string[]> | string[];
  except?: Record<string, string | string[]> | string[];
  live_preview?: {
    enable?: boolean;
    preview_token?: string;
    preview_hash?: string;
  };
}

export interface IContentstackPageConfig extends ICommonContentstackConfig {
  jsonRtePath?: string[];
  includeFields?: string[];
}

export interface IContentstackGetEntry extends IContentstackPageConfig {
  contentTypeUid: string;
  lang: ContentstackLocales;
}

export interface IContentstackGetSingletonEntry extends IContentstackGetEntry {
  where?: Record<string, string>;
}

export interface IContentstackGetSingleEntry extends IContentstackGetEntry {
  entryUid: string;
}

export interface ICreateQueryConfig extends ICommonContentstackConfig {
  contentTypeUid: string;
  lang: ContentstackLocales;
  where?: Record<string, string>;
  count?: boolean;
  skip?: number;
  limit?: number;
}

export interface ICreateEntryConfig extends ICommonContentstackConfig {
  contentTypeUid: string;
  lang: ContentstackLocales;
  entryUid: string;
}

export interface IEnrichedPublishedPage {
  contentTypeUid: string;
  locale: ContentstackLocales;
  entries: IContentstackPage[];
}

export interface IContentstackSelectOption {
  value: string;
  key: string;
}

export interface IContentstackSchemaItem {
  uid: string;
  enum: {
    choices: IContentstackSelectOption[];
  };
  schema: IContentstackSchemaItem[];
}

export interface IContentstackContentType {
  uid: string;
  schema: IContentstackSchemaItem[];
}

export interface IRichTextContent {
  [key: string]: IRichTextDocument | IRichTextDocument[];
}
