      process.env.CONTENTSTACK_PREVIEW_TOKEN = "TEST_PREVIEW_TOKEN";

      const testedModule = require("../contentstack.ts");

      expect(testedModule.options).toEqual(
        expect.objectContaining({
          live_preview: {
            enable: true,
            preview_token: "TEST_PREVIEW_TOKEN",
          },
        }),
      );
      // Must NOT use the SDK's `management_token` key — the Story contract specifies `preview_token`.
      expect(testedModule.options.live_preview).not.toHaveProperty("management_token");
    });

    it("should not set live_preview when CONTENTSTACK_PREVIEW_TOKEN is missing", () => {
      process.env.CONTENTSTACK_PREVIEW_TOKEN = undefined;

      const testedModule = require("../contentstack.ts");

      expect(testedModule.options).not.toHaveProperty("live_preview");
    });
