  ILocalizedSelectOption,
} from "interface/content/page";
import { IPageLevelServiceAlertsContent } from "interface/content/serviceAlerts";
import { IDirectoryData } from "interface/directory";
import { IBreadcrumb } from "interface/page";
import { IStaticUpdates } from "interface/serviceUpdates";
import { applyLivePreviewQuery } from "services/contentstack";

export interface IContentstackContent {
  // TODO(devteam): define types for header and footer
  header?: [any];
  footer?: [any];
  staticUpdates?: IStaticUpdates;
  serviceAlerts?: IPageLevelServiceAlertsContent;
  page?: [IContentstackPage];
  pageSpecificData?: IPageSpecificData;
  directories?: IDirectoryData;
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  languageAlternativePageSlug?: string[];
  onBoardingData?: {
    primaryReasonForTravel: ILocalizedSelectOption[];
    aboutYou: ILocalizedSelectOption[];
    travelInterests: ILocalizedSelectOption[];
  };
  globalDictionary?: [IGlobalDictionary];
  breadcrumbs?: IBreadcrumb[];
}

interface IContentStackProviderProps {
  defaultContent?: IContentstackContent;
  children: ReactNode;
}

export const ContentstackContext = createContext<{
  content: IContentstackContent;
}>({ content: {} });

export const useContentstackContext = () => {
  const context = useContext(ContentstackContext);

  if (!context) {
    throw new Error("useContentstackContext must be used within the ContentstackProvider");
  }

  return context;
};

/**
 * Parse the Contentstack Live Preview hash from `window.location.hash`.
 *
 * Supports either:
 *   `#live_preview=<hash>&content_type_uid=<uid>`
 *   `#content_type_uid=<uid>&live_preview=<hash>`
 *   query-string style usage of `window.location.hash`
 */
const parseLivePreviewHash = (): { live_preview?: string; content_type_uid?: string } => {
  if (typeof window === "undefined") return {};

  const rawHash = window.location.hash || "";
  const stripped = rawHash.startsWith("#") ? rawHash.slice(1) : rawHash;
  if (!stripped) return {};

  const params = new URLSearchParams(stripped);
  return {
    live_preview: params.get("live_preview") || undefined,
    content_type_uid: params.get("content_type_uid") || undefined,
  };
};

export const ContentstackProvider = ({
  defaultContent = {},
  children,
}: IContentStackProviderProps) => {
  const [content, setContent] = useState<IContentstackContent>(defaultContent);

  // React to Contentstack Live Preview hash changes so editors see real-time
  // content updates without re-publishing.
  useEffect(() => {
    const handleHashChange = () => {
      const { live_preview, content_type_uid } = parseLivePreviewHash();

      if (live_preview && content_type_uid) {
        applyLivePreviewQuery({ live_preview, content_type_uid });
      }
    };

    handleHashChange();

    window.addEventListener("hashchange", handleHashChange);
    // Contentstack's editor posts a message on preview; re-parse on receipt.
    window.addEventListener("message", handleHashChange);

    return () => {
      window.removeEventListener("hashchange", handleHashChange);
      window.removeEventListener("message", handleHashChange);
    };
  }, []);

  // If `defaultContent` prop changes (e.g. after a page transition on the
  // client), resync internal state to it.
  useEffect(() => {
    setContent(defaultContent);
  }, [defaultContent]);

  return (
    <ContentstackContext.Provider value={{ content }}>{children}</ContentstackContext.Provider>
  );
};
```

