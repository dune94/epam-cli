  ICreateQueryConfig,
} from "../interface/contentstack";
import logger from "./logger";

const {
  CONTENTSTACK_API_KEY = "",
  CONTENTSTACK_DELIVERY_TOKEN = "",
  CONTENTSTACK_ENVIRONMENT = "",
  CONTENTSTACK_API_HOST = "",
  CONTENTSTACK_BRANCH = "",
