```typescript
import { ContentCard } from '../interface/content/contentCard';

const BASE_URL = 'https://api.contentstack.io/v3';

interface FetchContentOptions {
  contentTypeUid: string;
  previewToken?: string;
  environment?: string;
}

/**
 * Fetch content entries from Contentstack, with support for live preview.
 * When a preview token is provided, the request targets draft/preview content
 * instead of published content.
 */
export async function fetchContentPreview(
  contentTypeUid: string,
  previewToken?: string,
  environment?: string
): Promise<ContentCard[]> {
  const params = new URLSearchParams();

  if (previewToken) {
    params.append('preview_token', previewToken);
  }

  if (environment) {
    params.append('environment', environment);
  } else {
    params.append('environment', 'production');
  }

  params.append('include_count', 'true');

  const url = `${BASE_URL}/content_types/${contentTypeUid}/entries?${params.toString()}`;

  const response = await fetch(url, {
    headers: {
      'Content-Type': 'application/json',
    },
  });

  if (!response.ok) {
    throw new Error(`Failed to fetch content: ${response.statusText}`);
  }

  const data = await response.json();

  return (data.entries || []).map((entry: any) => ({
    uid: entry.uid,
    title: entry.title || '',
    url: entry.url || '',
    contentType: contentTypeUid,
    previewToken,
    environment,
  }));
}
```

