import React from 'react';
import { ContentCard } from '../../../interface/content/contentCard';

export interface ContentstackLinkProps {
  content: ContentCard;
  preview?: boolean;
}

/**
 * Renders links to Contentstack CMS for a given content card.
 * When `preview` is true, includes a live preview link with the preview token.
 */
export const ContentstackLink: React.FC<ContentstackLinkProps> = ({
  content,
  preview = false,
}) => {
  const editUrl = `https://app.contentstack.com/#!/stack/content-type/${content.contentType}/entry/${content.uid}/edit`;

  const previewUrl = preview && content.previewToken
    ? `https://app.contentstack.com/#!/stack/content-type/${content.contentType}/entry/${content.uid}/preview?preview_token=${content.previewToken}&environment=${content.environment || 'production'}`
    : null;

  return (
    <div className="contentstack-link">
      <a
        href={editUrl}
        target="_blank"
        rel="noopener noreferrer"
        className="contentstack-link__edit"
      >
        Edit in Contentstack
      </a>
      {previewUrl && (
        <a
          href={previewUrl}
          target="_blank"
          rel="noopener noreferrer"
          className="contentstack-link__preview"
        >
          Live Preview
        </a>
      )}
    </div>
  );
};

export default ContentstackLink;
