import { useState, useEffect } from 'react';
import { ContentCard } from '../interface/content/contentCard';
import { fetchContentPreview } from '../services/contentstack';

export interface UseContentResult {
  content: ContentCard[] | null;
  loading: boolean;
  error: Error | null;
}

/**
 * Hook to fetch content from Contentstack with optional live preview support.
 *
 * @param contentTypeUid - The UID of the content type to fetch.
 * @param preview - When true, fetches draft/preview content using a preview token.
 */
export function useContent(
  contentTypeUid: string,
  preview: boolean = false
): UseContentResult {
  const [content, setContent] = useState<ContentCard[] | null>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<Error | null>(null);

  useEffect(() => {
    let cancelled = false;

    async function load() {
      setLoading(true);
      setError(null);

      try {
        const previewToken = preview
          ? new URLSearchParams(window.location.search).get('preview_token') ?? undefined
          : undefined;

        const environment = preview
          ? new URLSearchParams(window.location.search).get('environment') ?? undefined
          : undefined;

        const result = await fetchContentPreview(
          contentTypeUid,
          previewToken,
          environment
        );

        if (!cancelled) {
          setContent(result);
        }
      } catch (err) {
        if (!cancelled) {
          setError(err instanceof Error ? err : new Error(String(err)));
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    }

    load();

    return () => {
      cancelled = true;
    };
  }, [contentTypeUid, preview]);

  return { content, loading, error };
}
```

