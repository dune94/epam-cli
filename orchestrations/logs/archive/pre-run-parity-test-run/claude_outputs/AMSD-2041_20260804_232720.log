### /home/bradleyjerome/projects/metrolinx/next.gotransit.com/src/hooks/useContent.ts
```
import { useCallback, useEffect, useState } from "react";
import { useContentstackContext } from "context/ContentstackContext";
import { getValue } from "utils/getValue";

/**
 * Contentstack's CMS preview pane launches the page inside an iframe and
 * appends a `live_preview` hash parameter to the URL. Drafts are pushed to
 * the page via `window.postMessage({ type: "contentstack-live-preview", ... })`
 * events. We detect both at the hook level so all 236+ consumers get
 * preview support with zero component-level changes — without changing
 * the hook's public signature.
 *
 * The overlay is stored in module-scope `useRef`-like state via a small
 * singleton so every consumer re-renders together when a draft arrives.
 */
const PREVIEW_HASH_KEY = "live_preview";
const PREVIEW_MESSAGE_TYPE = "contentstack-live-preview";

const isPreviewMode = (): boolean => {
  if (typeof window === "undefined") return false;
  return new URLSearchParams(window.location.hash.replace(/^#/, "")).has(PREVIEW_HASH_KEY);
};

// Module-scoped draft overlay shared across all useContent() instances.
let previewOverlay: Record<string, unknown> = {};
const previewListeners = new Set<() => void>();

const notifyPreviewListeners = () => {
  previewListeners.forEach((l) => l());
};

if (typeof window !== "undefined") {
  window.addEventListener("message", (event: MessageEvent) => {
    const data = event.data as { type?: string; content?: Record<string, unknown> } | undefined;
    if (data?.type !== PREVIEW_MESSAGE_TYPE || !data.content) return;
    previewOverlay = { ...previewOverlay, ...data.content };
    notifyPreviewListeners();
  });
}

export const useContent = () => {
  const { content } = useContentstackContext();
  const [, forceUpdate] = useState(0);

  // Re-render consumers when a preview draft arrives so updates appear in
  // real time without a page refresh.
  useEffect(() => {
    if (!isPreviewMode()) return undefined;
    const listener = () => forceUpdate((n) => n + 1);
    previewListeners.add(listener);
    return () => {
      previewListeners.delete(listener);
    };
  }, []);

  const getContentByKey = useCallback(
    <T>(path: string, defaultValue: T): T => {
      if (isPreviewMode() && Object.prototype.hasOwnProperty.call(previewOverlay, path)) {
        return getValue<T>(previewOverlay, path, defaultValue);
      }
      return getValue<T>(content, path, defaultValue);
    },
    [content],
  );

  return {
    getContentByKey,
  };
};
```

