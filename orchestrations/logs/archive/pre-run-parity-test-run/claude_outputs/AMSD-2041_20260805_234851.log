import { GetStaticPaths, GetStaticProps, NextPage } from "next";
import { useEffect, useRef, useState } from "react";
import ContentstackLivePreview from "@contentstack/live-preview-utils";
import { serverSideTranslations } from "next-i18next/serverSideTranslations";
import { Layout } from "components/layout/Layout";
import { PageHead } from "components/pages/PageHead";
import { ContentstackLocales } from "constants/contentstack";
import { ContentstackContext, IContentstackContext } from "context/contentstackContext";
import { IMappedByLocaleDirectories } from "interface/directory";
import { resolvePageComponent } from "services/pageComponentResolver";
import { pageService } from "services/pageService";
import { staticPathsResolver } from "services/staticPathsResolver";
import { readFromFs } from "utils/fsCache";
import { getLocaleByNextLocale, getNextLocaleByLocale, NextLocales } from "utils/locale";
import { readCachedPageDataFromFs } from "utils/pageDataCache";
import { refineClientData } from "utils/refineClientData";

interface IDynamicSlugParams {
  slug: string[];
}

interface IPageProps {
  content: IContentstackContext;
  contentTypeUid: string;
  contentstackLocale: ContentstackLocales;
}

const Page: NextPage<IPageProps> = (props) => {
  const { content, contentTypeUid, contentstackLocale } = props;
  const [liveContent, setLiveContent] = useState<IContentstackContext>(content);
  const PageComponent = resolvePageComponent(contentTypeUid);

  // Guard so the SDK's init() runs at most once per component mount. The full SDK's
  // `isInitialized` is private and not visible on the exported union type.
  const initRef = useRef(false);

  useEffect(() => {
    let isMounted = true;

    if (!initRef.current) {
      initRef.current = true;
      ContentstackLivePreview.init();
    }

    const onChange = async () => {
      const pageEntry = content.page?.[0];
      const pageUid = pageEntry?.uid;

      if (!contentstackLocale || !pageUid) return;

      try {
        const fetched = await pageService.getPageEntry({
          contentTypeUid,
          entryUid: pageUid,
          lang: contentstackLocale,
        });

        if (!isMounted) return;

        // Cast is safe: refineClientData returns the IContentstackContext shape for
        // pageService.getPageEntry responses (the same input shape used in getStaticProps).
        const refined = refineClientData(
          { ...fetched, page: [fetched.page] },
          getNextLocaleByLocale(contentstackLocale),
        ) as IContentstackContext;

        setLiveContent((prev) => ({ ...prev, ...refined, page: refined.page ?? prev.page }));
      } catch {
        // Retain the last displayed content if the live-preview connection is lost.
      }
    };

    // `onEntryChange` returns a callback UID (per OnEntryChangeCallbackUID) that
    // the full SDK's unsubscribeOnEntryChange requires; the light SDK returns a
    // string we can pass straight through.
    const callbackUid = ContentstackLivePreview.onEntryChange(onChange);

    return () => {
      isMounted = false;
      ContentstackLivePreview.unsubscribeOnEntryChange(callbackUid);
    };
  }, [content, contentTypeUid, contentstackLocale]);

  return (
    <ContentstackContext.Provider value={liveContent}>
      {liveContent.page && <PageHead page={liveContent.page} contentTypeUid={contentTypeUid} />}
      <Layout contentTypeUid={contentTypeUid}>
        {PageComponent ? <PageComponent {...liveContent} /> : <h1>Page not implemented</h1>}
      </Layout>
    </ContentstackContext.Provider>
  );
};

export const getStaticPaths: GetStaticPaths = async () => {
  const { MAINTENANCE_MODE } = process.env;

  if (MAINTENANCE_MODE === "true") {
    return { paths: [], fallback: false };
  }

  return {
    paths: await staticPathsResolver.resolveStaticPaths(),
    fallback: false,
  };
};

export const getStaticProps: GetStaticProps = async (context) => {
  const { locale: nextLocale = "" } = context;
  const { slug = [] } = (context?.params as unknown as IDynamicSlugParams) || {};
  const {
    uid: pageUid,
    contentTypeUid,
    languageAlternativePageSlug = "",
  } = readCachedPageDataFromFs([nextLocale, ...slug]);

  const contentstackLocale = getLocaleByNextLocale(nextLocale);
  const directories = readFromFs<IMappedByLocaleDirectories>({ fileName: "directories" });
  const currentLocaleDirectories = directories?.[contentstackLocale] || {};

  const content = await pageService.getPageEntry({
    contentTypeUid,
    entryUid: pageUid,
    lang: contentstackLocale,
  });

  const pageSpecificData = await pageService.getPageSpecificData({
    contentTypeUid,
    entryUid: pageUid,
    lang: contentstackLocale,
    page: content.page,
  });

  const cachedPagesBaseURLs = readFromFs<{ [locale: string]: Record<string, string> }>({
    fileName: "pagesBaseURLs",
  });
  const pagesBaseURLs = cachedPagesBaseURLs?.[contentstackLocale];

  return {
    props: {
      content: refineClientData(
        {
          ...content,
          page: [content.page],
          pageSpecificData,
          directories: currentLocaleDirectories,
          languageAlternativePageSlug,
          pagesBaseURLs,
        },
        nextLocale as NextLocales,
      ),
      contentTypeUid,
      contentstackLocale,
      ...(await serverSideTranslations(nextLocale, ["common"])),
    },
  };
};

export default Page;
```

