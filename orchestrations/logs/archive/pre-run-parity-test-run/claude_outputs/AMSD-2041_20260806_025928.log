<parameter namecontent">import React, {
  createContext,
  useContext,
  useEffect,
  useRef,
  useCallback,
  useMemo,
  useState,
} from 'react';

// ContentstackLivePreview is provided by @contentstack/live-preview-utils
// If the package is not yet installed, install it via:
//   npm install @contentstack/live-preview-utils
import ContentstackLivePreview from '@contentstack/live-preview-utils';

export interface ContentstackContextType {
  isLivePreview: boolean;
  isEditing: boolean;
  onEntryChange: (cb: () =&gt; void) =&gt; () =&gt; void;
}

const defaultContextValue: ContentstackContextType = {
  isLivePreview: false,
  isEditing: false,
  onEntryChange: () =&gt; () =&gt; {},
};

export const ContentstackContext = createContext&lt;ContentstackContextType&gt;(
  defaultContextValue
);

export interface ContentstackProviderProps {
  children: React.ReactNode;
  apiKey?: string;
  environment?: string;
}

export function ContentstackProvider({
  children,
  apiKey = process.env.CONTENTSTACK_API_KEY,
  environment = process.env.CONTENTSTACK_ENVIRONMENT,
}: ContentstackProviderProps) {
  const [isLivePreview, setIsLivePreview] = useState(false);
  const [isEditing, setIsEditing] = useState(false);
  const callbacksRef = useRef&lt;Set&lt;() =&gt; void&gt;&gt;(new Set());

  useEffect(() =&gt; {
    if (!apiKey || !environment) {
      // eslint-disable-next-line no-console
      console.warn(
        'ContentstackProvider: Missing apiKey or environment. Live Preview will not be initialized.'
      );
      return;
    }

    ContentstackLivePreview.init({
      stackDetails: {
        apiKey,
        environment,
      },
    });

    // Register the internal callback that fans out to all registered callbacks
    ContentstackLivePreview.onEntryChange(() =&gt; {
      callbacksRef.current.forEach((cb) =&gt; cb());
    });

    // Detect if we are in live preview / editing mode
    if (typeof window !== 'undefined') {
      const params = new URLSearchParams(window.location.search);
      const livePreview = params.get('live_preview') === 'true';
      const editing = params.get('mode') === 'edit';
      setIsLivePreview(livePreview);
      setIsEditing(editing);
    }
  }, [apiKey, environment]);

  const onEntryChange = useCallback((cb: () =&gt; void) =&gt; {
    callbacksRef.current.add(cb);
    return () =&gt; {
      callbacksRef.current.delete(cb);
    };
  }, []);

  const value = useMemo&lt;ContentstackContextType&gt;(
    () =&gt; ({
      isLivePreview,
      isEditing,
      onEntryChange,
    }),
    [isLivePreview, isEditing, onEntryChange]
  );

  return (
    &lt;ContentstackContext.Provider value={value}&gt;
      {children}
    &lt;/ContentstackContext.Provider&gt;
  );
}

export function useContentstack(): ContentstackContextType {
  return useContext(ContentstackContext);
}

export default ContentstackProvider;
</invoke>
