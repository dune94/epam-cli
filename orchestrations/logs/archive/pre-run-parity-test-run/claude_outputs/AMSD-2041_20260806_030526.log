### /home/bradleyjerome/projects/metrolinx/next.metrolinx.com/src/context/contentstackContext.tsx
```
import { createContext, FC, ReactNode, useContext, useEffect, useState } from "react";
import ContentstackLivePreview from "@contentstack/live-preview-utils";
import { ContentTypes } from "constants/contentstack";
import { IContentstackHeader } from "interface/content/header";
import { IContentstackPage } from "interface/content/page";
import { IDirectoryData } from "interface/directory";
import { IOnboarding } from "interface/onboarding";

export interface IContentstackContext {
  header?: [IContentstackHeader];
  footer?: [any];
  onboarding?: [IOnboarding];
  page?: [IContentstackPage];
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  directories?: IDirectoryData;
  languageAlternativePageSlug?: string[];
  livePreviewData?: { [entryUid: string]: unknown };
}

export const ContentstackContext = createContext<IContentstackContext>({});

interface IContentstackProviderProps {
  children: ReactNode;
  initialValue?: IContentstackContext;
}

export const ContentstackProvider: FC<IContentstackProviderProps> = ({
  children,
  initialValue = {},
}) => {
  const [value, setValue] = useState<IContentstackContext>(initialValue);

  useEffect(() => {
    if (typeof window === "undefined") return;

    try {
      ContentstackLivePreview.onEntryChange(() => {
        setValue((prev) => ({ ...prev }));
      });
    } catch (error) {
      // SDK may be unavailable outside a CMS preview session; fall back to published values.
      console.error(error);
    }
  }, []);

  return <ContentstackContext.Provider value={value}>{children}</ContentstackContext.Provider>;
};

export const useContentstack = () => {
  return useContext(ContentstackContext);
};
```

