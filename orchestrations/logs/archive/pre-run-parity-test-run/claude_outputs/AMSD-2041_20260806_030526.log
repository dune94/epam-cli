```
import { createContext, useContext, useState, ReactNode } from "react";
import { ContentTypes } from "constants/contentstack";
import { IContentstackHeader } from "interface/content/header";
import { IContentstackPage } from "interface/content/page";
import { IDirectoryData } from "interface/directory";
import { IOnboarding } from "interface/onboarding";
import { useContent } from "hooks/useContent";

export interface IContentstackContext {
  header?: [IContentstackHeader];
  footer?: [any];
  onboarding?: [IOnboarding];
  page?: [IContentstackPage];
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  directories?: IDirectoryData;
  languageAlternativePageSlug?: string[];
  livePreviewData?: Record<string, any>;
}

// `ContentstackContext` is the source of truth for CMS entry data. Consumers
// read from it via `useContent` (see src/hooks/useContent.ts), which wraps
// `useContext(ContentstackContext)` with a typed `getContentByKey` helper.
// The provider that mounts this context lives at the page entry point
// (src/pages/[[...slug]].tsx). Live-preview updates are wired there too, so
// this module intentionally exports only the context + its value shape.
export const ContentstackContext = createContext<IContentstackContext>({});

// Re-exported so consumers can `import { useContent } from "context/contentstackContext"`
// without having to know the hook's physical location.
export { useContent };

/**
 * Hook to access the Contentstack context. Returns the full context value.
 */
export function useContentstack(): IContentstackContext {
  return useContext(ContentstackContext);
}

/**
 * Provider component that wires up live-preview updates via the
 * Contentstack Live Preview SDK's `onEntryChange` callback.
 * On each entry change, it re-spreads its state to trigger a re-render,
 * reflecting any mutations the SDK has made to the context value.
 */
export function ContentstackProvider({
  initialValue,
  children,
}: {
  initialValue?: IContentstackContext;
  children: ReactNode;
}) {
  const [value, setValue] = useState<IContentstackContext>(initialValue ?? {});

  // Register the live-preview callback once on mount
  useState(() => {
    try {
      // eslint-disable-next-line @typescript-eslint/no-var-requires
      const livePreviewUtils = require("@contentstack/live-preview-utils");
      const defaultExport =
        livePreviewUtils.default ?? livePreviewUtils;
      if (defaultExport?.onEntryChange) {
        defaultExport.onEntryChange(() => {
          // Re-spread the state to trigger a re-render. The SDK mutates
          // the context object in place, so spreading the top-level keys
          // picks up any nested changes.
          setValue((prev) => ({ ...prev }));
        });
      }
    } catch (e) {
      console.error(e);
    }
  });

  return (
    <ContentstackContext.Provider value={value}>
      {children}
    </ContentstackContext.Provider>
  );
}
```

