import { UniformContext } from "@uniformdev/context-react";
import { SessionProvider } from "next-auth/react";
import { appWithTranslation } from "next-i18next";
import { ErrorBoundary, FallbackProps } from "react-error-boundary";
import { AppEnvironmentProvider } from "@metrolinx/cx-shared/build/src/context/AppEnvironmentContext";
import { AppImage } from "components/AppImage";
import { AppLink } from "components/AppLink";
import ClientSideErrorFallback from "components/ClientSideErrorFallback";
import { CommonAnalytics } from "components/CommonAnalytics";
import { PageRenderer } from "components/PageRenderer";
import { TAutocompleteItem } from "components/Searchbox/StationAutocomplete";
import { AuthProvider } from "context/AuthContext";
import { ContentstackProvider } from "context/ContentstackContext";
import { LeaveGuardProvider } from "context/LeaveGuardContext";
import { LineColorsProvider } from "context/LineColorsContext";
import { OrderProvider } from "context/OrderContext";
import { SWRConfigProvider } from "context/SWRConfigProvider";
import { ServiceGuaranteeClaimProvider } from "context/ServiceGuaranteeClaimContext";
import { TransferCartProvider } from "context/TransferCartContext";
import { UserProfileProvider } from "context/UserProfileContext";
import { context } from "context/uniformContext";
import { UserDefaultStationContext } from "context/userDefaultStationContext";
import { useAuthRefetchInterval } from "hooks/useAuthRefetchInterval";
import { useClearStoragesOnSignOut } from "hooks/useClearStoragesOnSignOut";
import { TEnrichedNextComponentType } from "interface/common";
import { IPageProps } from "interface/page";
import packageJSON from "../../package.json";

const initAppSettings = () => {
  window.appSettings = { version: packageJSON.version };
};

interface IAppProps extends AppProps {
  Component: TEnrichedNextComponentType;
  pageProps: IPageProps;
}

function MyApp({ Component, pageProps }: IAppProps) {
  const { content, lineColors } = pageProps;

  const { session, isLoading, refetchInterval } = useAuthRefetchInterval();

  const [defaultStationContext, setDefaultStationContext] = useState<TAutocompleteItem>();

  const isSignedOut = !isLoading && !session;

  useEffect(() => {
    initAppSettings();

    const root = document.getElementById("__next");
    root?.setAttribute("tabindex", "-1");
  }, []);

  useClearStoragesOnSignOut(isSignedOut);

  const defaultStationCtxValue = useMemo(
    () => ({ defaultStationContext, setDefaultStationContext }),
    [defaultStationContext],
  );

  return (
    <AppEnvironmentProvider imageAs={AppImage} linkAs={AppLink}>
      <ErrorBoundary FallbackComponent={ClientSideErrorFallback as ComponentType<FallbackProps>}>
        <SWRConfigProvider>
          <AuthProvider>
            <ContentstackProvider defaultContent={content}>
              <UserProfileProvider>
                <UserDefaultStationContext.Provider value={defaultStationCtxValue}>
                  <LineColorsProvider defaultColors={lineColors}>
                    <UniformContext context={context}>
                      <SessionProvider refetchInterval={refetchInterval} refetchOnWindowFocus>
                        <TransferCartProvider>
                          <OrderProvider>
                            <ServiceGuaranteeClaimProvider>
                              <LeaveGuardProvider>
                                <PageRenderer
                                  {...pageProps}
                                  pageAs={Component}
                                  layoutAs={Component.Layout}
                                />
                              </LeaveGuardProvider>
                            </ServiceGuaranteeClaimProvider>
                          </OrderProvider>
                        </TransferCartProvider>
                        <CommonAnalytics contentTypeUid={pageProps.contentTypeUid} />
                      </SessionProvider>
                    </UniformContext>
                  </LineColorsProvider>
                </UserDefaultStationContext.Provider>
              </UserProfileProvider>
            </ContentstackProvider>
          </AuthProvider>
        </SWRConfigProvider>
      </ErrorBoundary>
    </AppEnvironmentProvider>
  );
}

export default appWithTranslation(MyApp);
