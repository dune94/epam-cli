import { createContext, ReactNode, useContext, useEffect, useState } from "react";
import { useRouter } from "next/router";
import { ContentTypes } from "constants/contentstack";
import { IAbandonedCartPrompt } from "interface/content/abandonedCartPrompt";
import { IGlobalDictionary } from "interface/content/globalDictionary";
import { IContentstackPage, IPageSpecificData } from "interface/content/page";
import { ILocalizedSelectOption } from "interface/content/page";
import { IPageLevelServiceAlertsContent } from "interface/content/serviceAlerts";
import { IDirectoryData } from "interface/directory";
import { IBreadcrumb } from "interface/page";
import { IStaticUpdates } from "interface/serviceUpdates";

export interface IContentstackContent {
  // TODO(devteam): define types for header and footer
  header?: [any];
  footer?: [any];
  staticUpdates?: IStaticUpdates;
  serviceAlerts?: IPageLevelServiceAlertsContent;
  page?: [IContentstackPage];
  pageSpecificData?: IPageSpecificData;
  directories?: IDirectoryData;
  pagesBaseURLs?: {
    [key in ContentTypes]?: string;
  };
  languageAlternativePageSlug?: string[];
  onBoardingData?: {
    primaryReasonForTravel: ILocalizedSelectOption[];
    aboutYou: ILocalizedSelectOption[];
    travelInterests: ILocalizedSelectOption[];
  };
  globalDictionary?: [IGlobalDictionary];
  abandonedCartPrompt?: IAbandonedCartPrompt;
  breadcrumbs?: IBreadcrumb[];
  contentTypeUid?: string;
}

interface IContentStackProviderProps {
  defaultContent?: IContentstackContent;
  /**
   * Registers a no-argument callback with Contentstack Live Preview. Pass
   * `ContentstackLivePreview.onEntryChange` from `@contentstack/live-preview-utils`
   * here; the provider supplies the internal callback that refreshes the
   * current route when the SDK fires the event.
   */
  onEntryChange?: (callback: () => void) => void;
  children: ReactNode;
}

export const ContentstackContext = createContext<{
  content: IContentstackContent;
}>({ content: {} });

export const useContentstackContext = () => {
  const context = useContext(ContentstackContext);

  if (!context) {
    throw new Error("useContentstackContext must be used within the ContentstackProvider");
  }

  return context;
};

export const ContentstackProvider = ({
  defaultContent = {},
  onEntryChange,
  children,
}: IContentStackProviderProps) => {
  const [content, setContent] = useState<IContentstackContent>(defaultContent);
  const router = useRouter();

  useEffect(() => {
    setContent(defaultContent);
  }, [defaultContent]);

  // Register the SDK's onEntryChange handler exactly once per provider
  // mount. When the CMS pushes a draft entry update, the SDK invokes our
  // callback, which forces a re-render and re-fetches the current route so
  // downstream consumers read fresh content from context.
  useEffect(() => {
    if (!onEntryChange) return;

    onEntryChange(() => {
      // Force a re-render of consumers (state identity change) and trigger
      // a soft route refresh so getStaticProps / getServerSideProps re-run
      // with the latest preview payload.
      setContent((current) => ({ ...current }));
      router.replace(router.asPath, undefined, { scroll: false });
    });

    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [onEntryChange]);

  return (
    <ContentstackContext.Provider value={{ content }}>{children}</ContentstackContext.Provider>
  );
};
