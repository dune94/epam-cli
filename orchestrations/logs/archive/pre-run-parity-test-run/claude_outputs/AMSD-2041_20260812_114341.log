              onEntryChange={ContentstackLivePreview.onEntryChange}
            >
              <UserProfileProvider>
                <UserDefaultStationContext.Provider value={defaultStationCtxValue}>
                  <LineColorsProvider defaultColors={lineColors}>
                    <UniformContext context={context}>
                      <SessionProvider refetchInterval={refetchInterval} refetchOnWindowFocus>
                        <TransferCartProvider>
                          <OrderProvider>
                            <ServiceGuaranteeClaimProvider>
                              <LeaveGuardProvider>
                                <PageRenderer
                                  {...pageProps}
                                  pageAs={Component}
                                  layoutAs={Component.Layout}
                                />
                              </LeaveGuardProvider>
                            </ServiceGuaranteeClaimProvider>
                          </OrderProvider>
                        </TransferCartProvider>
                        <CommonAnalytics contentTypeUid={pageProps.contentTypeUid} />
                      </SessionProvider>
                    </UniformContext>
                  </LineColorsProvider>
                </UserDefaultStationContext.Provider>
              </UserProfileProvider>
            </ContentstackProvider>
          </AuthProvider>
        </SWRConfigProvider>
      </ErrorBoundary>
    </AppEnvironmentProvider>
  );
}

export default appWithTranslation(MyApp);
