import { useCallback, useContext } from "react";
import { ContentstackContext, LivePreviewContext } from "context/contentstackContext";
import { getValue } from "utils/getValue";

export const useContent = () => {
  const content = useContext(ContentstackContext);
  const { previewPage } = useContext(LivePreviewContext);

  // When a live-preview signal is active, the freshly fetched draft entry overrides the
  // published `page` slice of the existing ContentstackContext value. Everything else
  // (header/footer/onboarding/etc.) flows through unchanged so non-page components are not
  // disturbed by the preview update.
  const effectiveContent = previewPage ? { ...content, page: previewPage } : content;

  const getContentByKey = useCallback(
    <T>(path: string, defaultValue: T) => getValue<T>(effectiveContent, path, defaultValue),
    [effectiveContent],
  );

  return {
    getContentByKey,
  };
};
```

