```typescript
// scripts/review-hw003.ts
import fs from 'fs';
import path from 'path';
import { execSync } from 'child_process';

interface Criterion {
  text: string;
  met: boolean;
  rationale: string;
}

interface Finding {
  severity: 'blocker' | 'major' | 'minor';
  file: string;
  line: number | string;
  description: string;
  suggestedFix: string;
}

// HW-001 Acceptance Criteria (extracted from story definition)
const HW001_CRITERIA: string[] = [
  'greet.ts file exists and is a valid TypeScript file',
  'Exports a named function greet',
  'Function signature is greet(name: string): string',
  'Function returns "Hello, {name}!" where {name} is the input parameter',
  'greet.ts is syntactically valid TypeScript and compiles without errors',
  'greet("World") returns "Hello, World!"',
  'greet("Alice") returns "Hello, Alice!"',
  'greet accepts only string input (type-checked)',
];

async function performReview(): Promise<void> {
  const projectRoot = process.cwd();
  const greetPath = path.join(projectRoot, 'greet.ts');
  const reviewDir = path.join(projectRoot, 'review');
  const reportPath = path.join(reviewDir, 'HW-003-review.md');

  // Create review directory
  if (!fs.existsSync(reviewDir)) {
    fs.mkdirSync(reviewDir, { recursive: true });
  }

  const findings: Finding[] = [];
  const criteria: Criterion[] = [];
  let testOutput = '';
  let testPassed = false;

  // Check if greet.ts exists
  const greetExists = fs.existsSync(greetPath);
  if (!greetExists) {
    findings.push({
      severity: 'blocker',
      file: 'greet.ts',
      line: 'N/A',
      description: 'greet.ts not found',
      suggestedFix: 'Create greet.ts in the project root directory',
    });
    
    // Mark all criteria as not met
    for (const text of HW001_CRITERIA) {
      criteria.push({
        text,
        met: false,
        rationale: 'greet.ts does not exist',
      });
    }
  } else {
    // Read and analyze greet.ts
    const greetContent = fs.readFileSync(greetPath, 'utf-8');
    
    // Criterion 1: File exists and is valid TypeScript
    criteria.push({
      text: HW001_CRITERIA[0],
      met: true,
      rationale: 'greet.ts exists and is a valid TypeScript file',
    });

    // Check for named export of greet function
    const hasNamedExport = /export\s+(function\s+)?greet|export\s+const\s+greet/.test(greetContent);
    criteria.push({
      text: HW001_CRITERIA[1],
      met: hasNamedExport,
      rationale: hasNamedExport 
        ? 'Named function greet is exported'
        : 'Named function greet is not exported',
    });

    // Check function signature
    const hasCorrectSignature = /greet\s*\(\s*name\s*:\s*string\s*\)\s*:\s*string/.test(greetContent);
    criteria.push({
      text: HW001_CRITERIA[2],
      met: hasCorrectSignature,
      rationale: hasCorrectSignature
        ? 'Function signature matches greet(name: string): string'
        : 'Function signature does not match expected pattern',
    });

    // Check return value format
    const hasCorrectReturn = /return\s+[`"]Hello,\s*\$?\{?name\}?\s*![`"]|return\s+`Hello,\s*\$\{name\}!`/.test(greetContent);
    criteria.push({
      text: HW001_CRITERIA[3],
      met: hasCorrectReturn,
      rationale: hasCorrectReturn
        ? 'Function returns "Hello, {name}!" format'
        : 'Return statement does not match expected format',
    });

    // Check compilation (performed by test runner)
    criteria.push({
      text: HW001_CRITERIA[4],
      met: true,
      rationale: 'Will be verified by test execution',
    });

    // Criteria 5-8 will be verified by running tests
    for (let i = 5; i < HW001_CRITERIA.length; i++) {
      criteria.push({
        text: HW001_CRITERIA[i],
        met: true,
        rationale: 'Will be verified by test execution',
      });
    }
  }

  // Run test command
  try {
    const testCommand = '~/.local/share/fnm/node-versions/v20.20.2/installation/bin/node ./node_modules/.bin/vitest run';
    try {
      testOutput = execSync(testCommand, {
        cwd: projectRoot,
        encoding: 'utf-8',
        stdio: ['pipe', 'pipe', 'pipe'],
      });
      testPassed = testOutput.includes('passed');
    } catch (error: any) {
      testOutput = error.stdout || error.stderr || String(error);
      testPassed = false;
    }
  } catch (error) {
    findings.push({
      severity: 'blocker',
      file: 'N/A',
      line: 'N/A',
      description: 'Test command execution failed',
      suggestedFix: 'Ensure Node.js v20.20.2 and vitest are properly installed',
    });
    testOutput = String(error);
  }

  // Update criteria based on test results
  if (testPassed && greetExists) {
    for (let i = 3; i < criteria.length; i++) {
      criteria[i].met = true;
    }
  } else if (greetExists && !testPassed) {
    for (let i = 3; i < criteria.length; i++) {
      criteria[i].met = false;
      criteria[i].rationale = 'Test execution failed or returned negative result';
    }
  }

  // Determine overall verdict
  const hasBlockers = findings.some(f => f.severity === 'blocker');
  const allCriteriaMet = criteria.every(c => c.met);
  const verdict = (hasBlockers || !allCriteriaMet) ? 'fail' : 'pass';

  // Generate markdown report
  const reportContent = generateReport(findings, criteria, testOutput, verdict);

  // Write report
  fs.writeFileSync(reportPath, reportContent, 'utf-8');
  console.log(`Review report written to ${reportPath}`);
}

function generateReport(
  findings: Finding[],
  criteria: Criterion[],
  testOutput: string,
  verdict: string
): string {
  let report = '# HW-003 Code Review: greet.ts\n\n';

  // Summary Section
  report += '## Summary\n\n';
  report += `**Overall Verdict:** ${verdict}\n\n`;
  report += '### Test Execution\n\n';
  report += '**Test Command:** `~/.local/share/fnm/node-versions/v20.20.2/installation/bin/node ./node_modules/.bin/vitest run`\n\n';
  report += '**Test Output:**\n\n';
  report += '```\n';
  report += testOutput || '(no output captured)';
  report += '\n```\n\n';

  // Extract final summary line if present
  const summaryLineMatch = testOutput.match(/\d+\s+passed\s*(\|\s*\d+\s+failed)?/);
  if (summaryLineMatch) {
    report += `**Final Summary:** ${summaryLineMatch[0]}\n\n`;
  }

  // Findings Section
  report += '## Findings\n\n';
  if (findings.length === 0) {
    report += 'No findings\n\n';
  } else {
    for (const finding of findings) {
      report += `### ${finding.severity.toUpperCase()}: ${finding.description}\n\n`;
      report += `- **Severity:** ${finding.severity}\n`;
      report += `- **File:** ${finding.file}\n`;
      report += `- **Line:** ${finding.line}\n`;
      report += `- **Description:** ${finding.description}\n`;
      report += `- **Suggested Fix:** ${finding.suggestedFix}\n\n`;
    }
  }

  // HW-001 Criteria Checklist
  report += '## HW-001 Criteria Checklist\n\n';
  report += `**Total Criteria:** ${criteria.length}\n\n`;
  for (const criterion of criteria) {
    const status = criterion.met ? 'met' : 'not met';
    report += `- [${criterion.met ? 'x' : ' '}] **${status}**: ${criterion.text}\n`;
    report += `  - Rationale: ${criterion.rationale}\n\n`;
  }

  return report;
}

performReview().catch(console.error);
```

