  if (testSuccess && testOutput.toLowerCase().includes('passed')) {
    for (let i = 4; i < criteriaResults.length; i++) {
      criteriaResults[i].met = true;
      criteriaResults[i].rationale = 'Verified by vitest (tests passed)';
    }
  } else {
    for (let i = 4; i < criteriaResults.length; i++) {
      criteriaResults[i].met = false;
      criteriaResults[i].rationale = 'Not verified - test execution failed or tests did not pass';
    }
    if (!testSuccess && findings.filter(f => f.severity === 'blocker').length === 0) {
      findings.push({
        severity: 'blocker',
        file: 'N/A',
        line: 'N/A',
        description: 'Test execution failed',
        suggestedFix: 'Review test output and fix any compilation or runtime errors',
      });
    }
  }
}

// Determine verdict
const hasBlockers = findings.some(f => f.severity === 'blocker');
const allMet = criteriaResults.every(c => c.met);
const verdict = hasBlockers || !allMet ? 'fail' : 'pass';

// Generate markdown report
let markdown = '# HW-003 Code Review: greet.ts\n\n';

markdown += '## Summary\n\n';
markdown += `**Overall Verdict:** ${verdict}\n\n`;
markdown += '**Test Command:** `node ./node_modules/.bin/vitest run`\n\n';
markdown += '**Test Output:**\n\n```\n';
markdown += testOutput || '(no output captured)';
markdown += '\n```\n\n';

// Extract summary line
const summaryLine = testOutput.match(/\d+\s+passed(\s*\|\s*\d+\s+failed)?/);
if (summaryLine) {
  markdown += `**Final Summary:** ${summaryLine[0]}\n\n`;
}

markdown += '## Findings\n\n';
if (findings.length === 0) {
  markdown += 'No findings\n\n';
} else {
  for (const finding of findings) {
    markdown += `**${finding.severity.toUpperCase()}** - ${finding.description}\n\n`;
    markdown += `- **Severity:** ${finding.severity}\n`;
    markdown += `- **File:** ${finding.file}\n`;
    markdown += `- **Line:** ${finding.line}\n`;
    markdown += `- **Description:** ${finding.description}\n`;
    markdown += `- **Suggested Fix:** ${finding.suggestedFix}\n\n`;
  }
}

markdown += '## HW-001 Criteria Checklist\n\n';
for (const result of criteriaResults) {
  const status = result.met ? 'met' : 'not met';
  const symbol = result.met ? '✓' : '✗';
  markdown += `${symbol} **${status}**: ${result.text}\n`;
  markdown += `  - ${result.rationale}\n\n`;
}

// Write report
fs.writeFileSync(reportPath, markdown, 'utf-8');

// Verify file was not modified
const greetStatsAfter = greetExists ? fs.statSync(greetPath) : null;
if (greetStatsAfter && greetStats) {
  if (greetStats.mtimeMs !== greetStatsAfter.mtimeMs) {
    console.error('WARNING: greet.ts was modified during review!');
    process.exit(1);
  }
}

console.log(`✓ Review complete: ${reportPath}`);
console.log(`✓ Verdict: ${verdict}`);
```

