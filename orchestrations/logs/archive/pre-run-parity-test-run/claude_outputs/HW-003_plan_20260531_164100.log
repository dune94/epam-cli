import click
from epam_cli.config import load_config

@click.group()
def cli():
    """EPAM CLI - Enhanced Project and Asset Management."""
    pass

@cli.command()
def hello():
    """Output Hello, World!"""
    click.echo("Hello, World!")

@cli.command()
@click.option('--name', default=None, help='Name to greet')
def greet(name):
    """Greet a user by name."""
    if name is None:
        config = load_config()
        name = config.get('default_name', 'World')
    click.echo(f"Hello, {name}!")

if __name__ == "__main__":
    cli()
