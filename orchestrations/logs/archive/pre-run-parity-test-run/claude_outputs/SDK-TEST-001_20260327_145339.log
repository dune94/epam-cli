## Step 1: Create the Utility Function

**File: `src/utils/formatTokenCount.ts`**

```typescript
/**
 * Formats a raw token count into a human-readable display string.
 * 
 * @param n - The token count to format
 * @returns A formatted string with appropriate unit suffix (K for thousands, M for millions)
 * 
 * @example
 * formatTokenCount(0)       // '0'
 * formatTokenCount(999)     // '999'
 * formatTokenCount(1000)    // '1.0K'
 * formatTokenCount(1500)    // '1.5K'
 * formatTokenCount(1000000) // '1.0M'
 * formatTokenCount(2500000) // '2.5M'
 */
export function formatTokenCount(n: number): string {
  if (n < 1000) {
    return String(n);
  }

  if (n < 1000000) {
    const thousands = n / 1000;
    return `${thousands.toFixed(1)}K`;
  }

  const millions = n / 1000000;
  return `${millions.toFixed(1)}M`;
}
```

## Step 2: Create Unit Tests

**File: `test/unit/utils/formatTokenCount.test.ts`**

```typescript
import { describe, it, expect } from 'vitest';
import { formatTokenCount } from '../../../src/utils/formatTokenCount';

describe('formatTokenCount', () => {
  it('should return "0" for zero', () => {
    expect(formatTokenCount(0)).toBe('0');
  });

  it('should return string representation for values under 1000', () => {
    expect(formatTokenCount(1)).toBe('1');
    expect(formatTokenCount(100)).toBe('100');
    expect(formatTokenCount(999)).toBe('999');
  });

  it('should format thousands with K suffix and one decimal place', () => {
    expect(formatTokenCount(1000)).toBe('1.0K');
    expect(formatTokenCount(1500)).toBe('1.5K');
    expect(formatTokenCount(5000)).toBe('5.0K');
    expect(formatTokenCount(9999)).toBe('10.0K');
  });

  it('should format millions with M suffix and one decimal place', () => {
    expect(formatTokenCount(1000000)).toBe('1.0M');
    expect(formatTokenCount(2500000)).toBe('2.5M');
    expect(formatTokenCount(10000000)).toBe('10.0M');
    expect(formatTokenCount(999999999)).toBe('1000.0M');
  });

  it('should handle boundary values correctly', () => {
    // Just below K threshold
    expect(formatTokenCount(999)).toBe('999');
    // Just at K threshold
    expect(formatTokenCount(1000)).toBe('1.0K');
    // Just below M threshold
    expect(formatTokenCount(999999)).toBe('1000.0K');
    // Just at M threshold
    expect(formatTokenCount(1000000)).toBe('1.0M');
  });
});
```

