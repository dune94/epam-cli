## 1. Create the utility function

**src/utils/formatTokenCount.ts**
```typescript
/**
 * Formats a raw token count into a human-readable string.
 * 
 * @param n - The number of tokens to format
 * @returns A formatted string with appropriate unit suffix (K for thousands, M for millions)
 * 
 * @example
 * formatTokenCount(0) // '0'
 * formatTokenCount(999) // '999'
 * formatTokenCount(1000) // '1.0K'
 * formatTokenCount(1500) // '1.5K'
 * formatTokenCount(1000000) // '1.0M'
 * formatTokenCount(2500000) // '2.5M'
 */
export function formatTokenCount(n: number): string {
  if (n < 1000) {
    return n.toString();
  }

  if (n < 1000000) {
    const thousands = n / 1000;
    return `${thousands.toFixed(1)}K`;
  }

  const millions = n / 1000000;
  return `${millions.toFixed(1)}M`;
}
```

## 2. Create comprehensive unit tests

**test/unit/utils/formatTokenCount.test.ts**
```typescript
import { describe, it, expect } from 'vitest';
import { formatTokenCount } from '../../../src/utils/formatTokenCount';

describe('formatTokenCount', () => {
  // Zero and small numbers
  it('returns "0" for zero', () => {
    expect(formatTokenCount(0)).toBe('0');
  });

  // Below threshold (no formatting)
  it('returns "999" for 999', () => {
    expect(formatTokenCount(999)).toBe('999');
  });

  it('returns "1" for 1', () => {
    expect(formatTokenCount(1)).toBe('1');
  });

  it('returns "500" for 500', () => {
    expect(formatTokenCount(500)).toBe('500');
  });

  // Thousands boundary and formatting
  it('returns "1.0K" for 1000', () => {
    expect(formatTokenCount(1000)).toBe('1.0K');
  });

  it('returns "1.5K" for 1500', () => {
    expect(formatTokenCount(1500)).toBe('1.5K');
  });

  it('returns "2.0K" for 2000', () => {
    expect(formatTokenCount(2000)).toBe('2.0K');
  });

  it('returns "10.0K" for 10000', () => {
    expect(formatTokenCount(10000)).toBe('10.0K');
  });

  it('returns "100.0K" for 100000', () => {
    expect(formatTokenCount(100000)).toBe('100.0K');
  });

  it('returns "999.9K" for 999900', () => {
    expect(formatTokenCount(999900)).toBe('999.9K');
  });

  // Millions boundary and formatting
  it('returns "1.0M" for 1000000', () => {
    expect(formatTokenCount(1000000)).toBe('1.0M');
  });

  it('returns "2.5M" for 2500000', () => {
    expect(formatTokenCount(2500000)).toBe('2.5M');
  });

  it('returns "10.0M" for 10000000', () => {
    expect(formatTokenCount(10000000)).toBe('10.0M');
  });

  it('returns "100.0M" for 100000000', () => {
    expect(formatTokenCount(100000000)).toBe('100.0M');
  });

  it('returns "1000.0M" for 1000000000', () => {
    expect(formatTokenCount(1000000000)).toBe('1000.0M');
  });

  // Edge cases with rounding
  it('returns "1.5K" for 1499 (rounds down)', () => {
    expect(formatTokenCount(1499)).toBe('1.5K');
  });

  it('returns "1.6K" for 1550', () => {
    expect(formatTokenCount(1550)).toBe('1.6K');
  });

  it('returns "2.5M" for 2499999 (rounds down to 2.5M)', () => {
    expect(formatTokenCount(2499999)).toBe('2.5M');
  });
});
```

