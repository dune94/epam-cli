## Implementation

### 1. Create the utility function

```typescript
// src/utils/formatTokenCount.ts

/**
 * Formats a raw token count into a human-readable display string.
 * 
 * Examples:
 * - 0 → '0'
 * - 999 → '999'
 * - 1000 → '1.0K'
 * - 1500 → '1.5K'
 * - 1000000 → '1.0M'
 * - 2500000 → '2.5M'
 * 
 * @param n - The raw token count to format
 * @returns A formatted string representation of the token count
 */
export function formatTokenCount(n: number): string {
  if (n === 0) {
    return '0';
  }

  if (n < 1000) {
    return String(n);
  }

  if (n < 1000000) {
    const thousands = n / 1000;
    // Format with one decimal place, removing trailing zeros
    return (Math.round(thousands * 10) / 10).toLocaleString('en-US', {
      minimumFractionDigits: 0,
      maximumFractionDigits: 1,
    }) + 'K';
  }

  const millions = n / 1000000;
  // Format with one decimal place, removing trailing zeros
  return (Math.round(millions * 10) / 10).toLocaleString('en-US', {
    minimumFractionDigits: 0,
    maximumFractionDigits: 1,
  }) + 'M';
}
```

