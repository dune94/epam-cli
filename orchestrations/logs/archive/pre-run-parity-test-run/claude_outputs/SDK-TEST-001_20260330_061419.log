## Implementation

### 1. Create `src/utils/formatTokenCount.ts`

```typescript
/**
 * Formats a token count into a human-readable string.
 * 
 * @param n - The number of tokens to format
 * @returns A formatted string (e.g., '999', '1.5K', '2.5M')
 * 
 * @example
 * formatTokenCount(0) // '0'
 * formatTokenCount(999) // '999'
 * formatTokenCount(1000) // '1.0K'
 * formatTokenCount(1500) // '1.5K'
 * formatTokenCount(1000000) // '1.0M'
 * formatTokenCount(2500000) // '2.5M'
 */
export function formatTokenCount(n: number): string {
  if (n < 1000) {
    return n.toString();
  }

  if (n < 1000000) {
    const thousands = n / 1000;
    return thousands % 1 === 0
      ? `${thousands.toFixed(1)}K`
      : `${thousands.toFixed(1)}K`;
  }

  const millions = n / 1000000;
  return millions % 1 === 0
    ? `${millions.toFixed(1)}M`
    : `${millions.toFixed(1)}M`;
}
```

### 2. Create `test/unit/utils/formatTokenCount.test.ts`

```typescript
import { describe, it, expect } from 'vitest';
import { formatTokenCount } from '../../../src/utils/formatTokenCount';

describe('formatTokenCount', () => {
  it('should return "0" for zero', () => {
    expect(formatTokenCount(0)).toBe('0');
  });

  it('should return the number as string for values under 1000', () => {
    expect(formatTokenCount(1)).toBe('1');
    expect(formatTokenCount(99)).toBe('99');
    expect(formatTokenCount(999)).toBe('999');
  });

  it('should format thousands with K suffix', () => {
    expect(formatTokenCount(1000)).toBe('1.0K');
    expect(formatTokenCount(1500)).toBe('1.5K');
    expect(formatTokenCount(10000)).toBe('10.0K');
    expect(formatTokenCount(999999)).toBe('1000.0K');
  });

  it('should format millions with M suffix', () => {
    expect(formatTokenCount(1000000)).toBe('1.0M');
    expect(formatTokenCount(2500000)).toBe('2.5M');
    expect(formatTokenCount(10000000)).toBe('10.0M');
  });

  it('should handle boundary values correctly', () => {
    expect(formatTokenCount(999)).toBe('999');
    expect(formatTokenCount(1000)).toBe('1.0K');
    expect(formatTokenCount(999999)).toBe('1000.0K');
    expect(formatTokenCount(1000000)).toBe('1.0M');
  });

  it('should maintain one decimal place for all formatted values', () => {
    expect(formatTokenCount(1000)).toMatch(/^\d+\.\d K$/);
    expect(formatTokenCount(5500)).toMatch(/^\d+\.\d K$/);
    expect(formatTokenCount(1000000)).toMatch(/^\d+\.\d M$/);
    expect(formatTokenCount(3200000)).toMatch(/^\d+\.\d M$/);
  });
});
```

