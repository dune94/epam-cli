      expect(formatTokenCount(2000000)).toBe('2.0M');
    });

    it('returns "2.5M" for 2500000', () => {
      expect(formatTokenCount(2500000)).toBe('2.5M');
    });

    it('returns "2.6M" for 2550000 (rounds half-up within M range)', () => {
      expect(formatTokenCount(2550000)).toBe('2.6M');
