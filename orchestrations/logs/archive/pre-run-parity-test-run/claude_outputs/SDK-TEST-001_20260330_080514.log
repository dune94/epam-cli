    it('throws RangeError for -Infinity', () => {
      expect(() => formatTokenCount(-Infinity)).toThrow(RangeError);
      expect(() => formatTokenCount(-Infinity)).toThrow(
        'formatTokenCount: n must be a non-negative finite integer'
      );
    });

    it('throws RangeError for non-integer finite positive number', () => {
      expect(() => formatTokenCount(1500.7)).toThrow(RangeError);
      expect(() => formatTokenCount(1500.7)).toThrow(
        'formatTokenCount: n must be a non-negative finite integer'
      );
    });
  });

  describe('locale independence', () => {
    it('always uses ASCII period as decimal separator', () => {
      const result = formatTokenCount(1500);
      expect(result).toBe('1.5K');
      expect(result).toContain('.');
