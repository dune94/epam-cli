## Step 1: Create the Implementation

**src/utils/formatTokenCount.ts**

```typescript
/**
 * Converts a raw integer token count into a compact, human-readable display string.
 * 
 * Ranges:
 * - [0, 999]: displayed as-is
 * - [1000, 999999]: displayed with K suffix (e.g., "1.5K")
 * - [1000000, ∞): displayed with M suffix (e.g., "2.6M")
 * 
 * All values are formatted to one decimal place when a suffix is applied.
 * Rounding uses standard half-up rounding.
 * 
 * @param n - A non-negative finite integer token count
 * @returns A human-readable string representation
 * @throws {RangeError} If n is not a non-negative finite integer
 */
export function formatTokenCount(n: number): string {
  // Validate input: must be a non-negative finite integer
  if (!Number.isFinite(n) || !Number.isInteger(n) || n < 0) {
    throw new RangeError(
      'formatTokenCount: n must be a non-negative finite integer'
    );
  }

  // Sub-thousand range: return as-is
  if (n < 1000) {
    return String(n);
  }

  // Millions range: >= 1,000,000
  if (n >= 1000000) {
    const millions = n / 1000000;
    // Round to 1 decimal place using half-up rounding
    const rounded = Math.round(millions * 10) / 10;
    return `${rounded.toFixed(1)}M`;
  }

  // Thousands range: >= 1,000 and < 1,000,000
  const thousands = n / 1000;
  // Round to 1 decimal place using half-up rounding
  const rounded = Math.round(thousands * 10) / 10;
  return `${rounded.toFixed(1)}K`;
}
```

