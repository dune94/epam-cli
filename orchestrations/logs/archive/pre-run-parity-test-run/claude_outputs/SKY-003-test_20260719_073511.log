origin, destination, --origin, --destination, from.*destination, to.*destination, RAPIDAPI_KEY.*empty, RAPIDAPI_KEY.*whitespace, jest, @jest/globals, process.exit, exit(1), skyscanner/client.js, ../skyscanner/client, ../../skyscanner/client, formatTable.*mock, mockResolvedValue, mockRejectedValue

