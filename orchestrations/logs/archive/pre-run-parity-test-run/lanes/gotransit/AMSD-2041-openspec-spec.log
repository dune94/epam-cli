--- src/services/partnersPromotionsService.ts
import { ContentstackLocales, ContentTypes, ContentUid } from "constants/contentstack";
import { Stack } from "services/contentstack";

import logger from "./logger";

class PartnersPromotionsService {
  async getContentTypeByUid(type: string, uid: string) {
    const query = Stack.ContentType(type);
    return query
      .fetch()
      .then((response) => {
        const categorySchema = response?.content_type?.schema?.find(
          (item: any) => item.uid === uid,
        );
        return categorySchema?.enum?.choices || [];
      })
      .catch((error: any) => error);
  }

  async getPromoCategories({ lang }: { lang: ContentstackLocales }) {
    const query = Stack.ContentType(ContentTypes.PartnersPromotionsDetailPage)
      .Query()
      .language(lang)
      .toJSON();
    try {
      const detailPages: [{ promo_category: string[] }[]] = await query.find();
      const categories: { key: string; value: string }[] = await this.getContentTypeByUid(
        ContentTypes.PartnersPromotionsDetailPage,
        ContentUid.PromoCategory,
      );

      const categoriesCounts = (detailPages?.[0] || []).reduce((acc, curr) => {
        curr.promo_category.forEach((category) => {
          const count = acc[category];
          acc[category] = count === undefined ? 1 : count + 1;
        });
        return acc;
      }, {} as { [category: string]: number });

      const categoriesWithCounts = (categories || []).map((category) => {
        const count = categoriesCounts[category.value] ?? 0;
        return { ...category, count };
      });

      return categoriesWithCounts;
    } catch (error) {
      logger.error(error, "Error retrieving promo categories");
      return [];
    }
  }
}

export const partnersPromotionsService = new PartnersPromotionsService();

