14	export const actualiseEntries = async (contentType: string, entries: Entry[]) => {
15	  const actualisedEntries: Entry[] = [];
16	  const environment = await getCurrentEnvironment();
17	
18	  for (const entry of entries) {
19	    const entryEnvironmentPublishDetails = getEntryEnvironmentPublishDetails(
20	      entry,
21	      environment.uid,
22	    );
23	    const isPublished = !!entryEnvironmentPublishDetails;
24	
25	    if (!isPublished) {
26	      actualisedEntries.push(entry);
27	      continue;
28	    }
29	
30	    const publishedVersion = entryEnvironmentPublishDetails?.version;
31	    const isLatestVersionPublished = publishedVersion === entry._version;
32	
33	    if (!isLatestVersionPublished) {
34	      try {
35	        const publishedVersionEntry = await client.client
36	          .contentType(contentType)
37	          .entry(entry.uid)
38	          .fetch({ version: publishedVersion, locale: entry.locale });
39	
40	        actualisedEntries.push(publishedVersionEntry);
41	        logger.collect([publishedVersionEntry], ContentStatus.DRAFT_CONTENT);
42	      } catch (e: any) {
43	        console.error(e.message, "Error actualising entry:", entry.uid);
44	        logger.collect([entry], ContentStatus.ACTUALISATION_FAILED);
45	      }
46	    } else {
47	      actualisedEntries.push(entry);
48	    }
49	  }
50	
51	  return actualisedEntries;
52	};
