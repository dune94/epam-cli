        _mc_seam_err=\"$(mktemp \"${TMPDIR:-/tmp}/mc-seam-err-XXXXXX\")\"
        _mc_seam=\"$(\"${NODE_BIN:-node}\" \"$SCRIPT_DIR/lib/handlers/seam-env-args.js\" prd-model-coordinator \"$AUTOMATION_DIR/agents\" 2>\"$_mc_seam_err\")\" || {
