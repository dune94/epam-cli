+       __TOOL_PATH__: toolPath,
+       __STORY_TITLE__: story.title || '',
+       __STORY_DESCRIPTION__: story.description ? 'Description: ' + String(story.description) + '\n' : '',
+       __STORY_ACS__: (story.acceptanceCriteria || []).map((a) => '- ' + String(a)).join('\n'),
