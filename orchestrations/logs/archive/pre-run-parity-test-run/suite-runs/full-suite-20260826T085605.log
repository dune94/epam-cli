+       ...existingSpec,
+       runId,
+       assignedAgents: assigned.agents,
+       coordinatorNotes: assigned.notes,
+       status: specStatus,
+       updatedAt: new Date().toISOString(),
+       appliedAgents,
+       agentContributions,
