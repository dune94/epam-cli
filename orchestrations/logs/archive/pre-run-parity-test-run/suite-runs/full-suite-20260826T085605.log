+   const assigned = [];
+   for (const s of _stories) {
+     const cls = Array.isArray(s.codelines) && s.codelines.length ? s.codelines : (s.codeline ? [s.codeline] : ['']);
+     const perCodeline = {};
+     for (const cl of cls) {
+       const a = _lookup(s.id, cl);
