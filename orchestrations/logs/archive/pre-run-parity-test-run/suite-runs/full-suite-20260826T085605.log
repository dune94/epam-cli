+   const root = (prd && prd.project && prd.project.outputDir) || process.env.PROJECT_ROOT || '.';
+   const out = [];
+   for (const story of stories || []) {
+     const files = (story.technicalNotes && story.technicalNotes.files) || [];
+     for (const f of files) {
