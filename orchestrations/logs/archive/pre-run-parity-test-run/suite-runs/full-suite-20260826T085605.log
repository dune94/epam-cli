+         console.warn(`spec-mode: ${d.reason}`);
+         return null;
+       }
+     } catch (e) {
+       // Say so loudly rather than treating an unavailable validator as a pass.
+       console.warn(`spec-mode: declared-contract validator unavailable (${e.message}) — ${_seam} NOT validated`);
+     }
+   }
