+     echo "=== Testing Gates: $phase_id @ $(date -Iseconds) ===" > "$gate_log"
+     echo "Routing override decision: $routing_decision ($routing_reason), FORCE_LIGHTPANDA=$force_lightpanda, FORCE_PLAYWRIGHT=$force_playwright" >> "$gate_log"
