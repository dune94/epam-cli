+       i += 1;
+       continue;
+     }
+     if (arg === '--dry-run') {
+       parsed.dryRun = true;
+       continue;
+     }
+     if (arg === '--help' || arg === '-h') {
+       parsed.help = true;
+       continue;
+     }
+   }
+   return parsed;
+ }
+
+ function usage() {
