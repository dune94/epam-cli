+     ? renderEngineTemplate('spec-agent-speckit-refine', {
+       __FORCED_RETRY_BLOCK__: forcedRetryBlock,
+       __PHASE__: phase,
+       __STORY_ID__: story.id,
+       __EXISTING_CHILDREN__: JSON.stringify(openspecOutput?.splitStories || [], null, 2),
