+   const n = Number(limit);
+   if (!Number.isFinite(n) || n <= 0 || s.length <= n) return s;
+   const cut = s.slice(0, n);
+   const lastSpace = cut.lastIndexOf(' ');
+   return (lastSpace > 0 ? cut.slice(0, lastSpace) : cut).trim();
