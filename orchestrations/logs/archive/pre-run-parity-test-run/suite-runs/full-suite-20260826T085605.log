+ function resolveCodelinePath(story) {
+   // Prefer story-level codeline → JIRA_WORKTREE_<UPPER> → JIRA_WORKTREE_<DEFAULT>
+   const cl = story.codeline || process.env.JIRA_DEFAULT_CODELINE || '';
+   if (cl) {
