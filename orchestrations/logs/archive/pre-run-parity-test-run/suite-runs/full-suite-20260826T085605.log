+       },
+       findings: {
+         type: 'array',
+         items: {
+           type: 'object',
+           required: ['agent', 'severity', 'claim', 'checked', 'found'],
+           properties: {
+             agent: { type: 'string', description: 'The minted agent whose brief carries the defect.' },
+             severity: {
+               type: 'string',
+               enum: ['blocking', 'advisory'],
