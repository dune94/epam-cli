                success \"  [prd-model-coordinator] ${_mc_assigned_count} stor(y/ies) assigned model/aiProvider/reasoningEffort (reviewer approved)\"
                _mc_final_outcome=\"pass\"
                rm -f \"$_mc_verdict_stderr\"
                break
            fi
