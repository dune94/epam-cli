    _review_ladder_key=\"$(ai_ladder_state_key \"review-agent\" \"${story_id:-global}\")\"
    if [ -n \"${LOG_DIR:-}\" ]; then
        _review_progress=\"$(read_story_retry_count \"$LOG_DIR\" \"$_review_ladder_key\")\"
