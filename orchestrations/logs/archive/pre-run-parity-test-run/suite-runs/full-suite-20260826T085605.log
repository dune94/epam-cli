                error \"  [SkillsAudit] could not render the skills-coordinator prompt for [${_sc_role}] — leaving the note as-is rather than invoking an agent with nothing to read\"
                continue
            fi
            rm -f \"$_cp_vals\"
            _sc_attempt=0
