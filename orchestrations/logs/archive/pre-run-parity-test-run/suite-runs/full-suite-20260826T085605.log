+   for (let cycle = 1; cycle <= maxCycles; cycle++) {
+     const mech = findVcMechanism(vc, story && story.id, vocabulary).map((f) => f.reason + `: "${String(f.criterion).slice(0, 80)}"`);
+     let speckitFlags = [];
+     if (reviewVc) {
