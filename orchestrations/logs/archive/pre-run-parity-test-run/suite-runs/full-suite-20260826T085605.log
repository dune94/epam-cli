+             },
+           },
+         },
+       },
+       acceptanceCriteria: { type: 'array', items: { type: 'string' }, minItems: 1 },
+       description: { type: 'string' },
+       title: { type: 'string' },
+       acAddedBySpeckit: { type: 'array', items: { type: 'string' } },
