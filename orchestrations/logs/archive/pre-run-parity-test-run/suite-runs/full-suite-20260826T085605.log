+ const TOOL_ROSTER_REVIEW = {
+   name: 'submit_roster_review',
+   description:
+     'Report defects in a generated agent roster. Every finding must be grounded in something you ' +
+     'checked with your tools. Do not answer in prose.',
+   parameters: {
