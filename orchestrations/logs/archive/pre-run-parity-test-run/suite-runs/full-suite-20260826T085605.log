    # is the same idea applied to the artefacts that actually decide a run's behaviour.
    mkdir -p "$ARCHIVE_DIR/generated" 2>/dev/null || true
    cp -p "$_rf" "$ARCHIVE_DIR/generated/$(basename "$_rf")" 2>/dev/null || true
