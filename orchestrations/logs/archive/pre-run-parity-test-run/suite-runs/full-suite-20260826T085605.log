+           ], { encoding: 'utf8', timeout: toolTimeoutMs('codegraphExplore') });
+           f.prescriptionNote = String(res.stdout || '').trim();
+           f.prescriptionUnderspecified = res.status === 1;
+           if (f.prescriptionNote) {
