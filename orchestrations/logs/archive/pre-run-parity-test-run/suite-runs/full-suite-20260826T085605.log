+                 route="lightpanda-agent"
+                 route_reason="env_force_lightpanda"
+             elif [ "${route_score:-0}" -ge 7 ]; then
+                 route="playwright-agent"
+                 route_reason="complexity_high"
+             elif [ "${route_score:-0}" -ge 4 ]; then
+                 route="lightpanda-agent"
+                 route_reason="complexity_medium"
+             fi
