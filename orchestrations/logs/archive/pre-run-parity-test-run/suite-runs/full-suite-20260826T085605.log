+
+         if [ "${hours%.*}" -ge 8 ] 2>/dev/null; then score=$((score + 3));
+         elif [ "${hours%.*}" -ge 5 ] 2>/dev/null; then score=$((score + 2));
+         elif [ "${hours%.*}" -ge 3 ] 2>/dev/null; then score=$((score + 1));
+         fi
