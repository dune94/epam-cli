    _rung_provider=$(story_rung_get "$LOG_DIR" "$story_id" provider)
    _rung_effort=$(story_rung_get "$LOG_DIR" "$story_id" reasoningEffort)
    _rung_temperature=$(story_rung_get "$LOG_DIR" "$story_id" temperature)

