# escalation-chain — the SET-INDEPENDENT half of this project's env.
# A greenfield project whose ONLY way to complete is a two-hop cross-story escalation, run at £0.
# ESC-003's change exposes a defect in ESC-001's file through ESC-002's test: ESC-003's analyst
# escalates to ESC-002, ESC-002's to ESC-001, and ESC-001's escalated fix must reach the codeline.
# The stand-ins are the project's DATA (stand-in/): per-story files, per-story escalated fixes,
# per-story analyst answers. Nothing in the engine or the harness knows this project.
PROJECT_NAME=escalation-chain
EPAM_BROWNFIELD=0
EPAM_PHASES="scaffold core"
OUTPUT_DIR=/tmp/escalation-chain-build
PRD_CANONICAL=orchestrations/escalation-chain-prd.canonical.json
PRD_FILE=orchestrations/escalation-chain-prd.json
REQUIRED_KEYS=
EPAM_TEMPERATURE=0
SPEC_PASS_BLOCK_ON_TIMEOUT=true
SPEC_MODE_MAX_OUTPUT_TOKENS=16384
SPEC_AGENT_MAX_RETRIES=2
EPAM_MODEL_LADDER=
MINIMAX_TOOL_TIMEOUT_MS=15000
EPAM_RETRY_EXTENSION_ENABLED=1
EPAM_RETRY_EXTENSION_MAX=2
SKIP_REGRESSION_GUARD=true
EPAM_RALPH_WIGGUM_ENABLED=0
EPAM_MAX_RETRIES=7
SKIP_BROWSER_E2E_ROUTING=false
EPAM_TOPOLOGY_ROUTER=1
EPAM_PAUSE_AFTER_AGENT_MINT=0
EPAM_PAUSE_BEFORE_WRITER=0
EPAM_PROMPT_PROVISION_MODE=generate
