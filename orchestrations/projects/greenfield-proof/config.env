# greenfield-proof — the SET-INDEPENDENT half of this project's env.
# The smallest greenfield project that exercises every stage: two phases, one story each, Python.
PROJECT_NAME=greenfield-proof
EPAM_BROWNFIELD=0
EPAM_PHASES="scaffold core"
OUTPUT_DIR=/tmp/greenfield-proof-build
PRD_CANONICAL=orchestrations/greenfield-proof-prd.canonical.json
PRD_FILE=orchestrations/greenfield-proof-prd.json
REQUIRED_KEYS=
EPAM_TEMPERATURE=0
SPEC_PASS_BLOCK_ON_TIMEOUT=true
SPEC_MODE_MAX_OUTPUT_TOKENS=16384
SPEC_AGENT_MAX_RETRIES=2
EPAM_MODEL_LADDER=
MINIMAX_TOOL_TIMEOUT_MS=15000
EPAM_RETRY_EXTENSION_ENABLED=1
EPAM_RETRY_EXTENSION_MAX=2
SKIP_REGRESSION_GUARD=true
EPAM_RALPH_WIGGUM_ENABLED=0
# EPAM_STORY_TIMEOUT_SECS: unset on purpose (2026-09-22). The engine declares the walls
# (config/llm-defaults.json timeouts) and this project inherits them. A 600s pin here is what
# killed REGI-003b and REGI-010-A mid-work; the clock is not the pipeline's governance.
EPAM_MAX_RETRIES=7
SKIP_BROWSER_E2E_ROUTING=false
EPAM_TOPOLOGY_ROUTER=1
EPAM_PAUSE_AFTER_AGENT_MINT=0
EPAM_PAUSE_BEFORE_WRITER=0
# generate: every template specialised for this project, so the prompt-builder and prompt-review seams execute. The router is on so topology-router executes: every seam the greenfield flow has runs on this project.
EPAM_PROMPT_PROVISION_MODE=generate
