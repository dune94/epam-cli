# The provider-dependent half for the REPLAY stack: recorded turns through MockServer.
# Providers are plain `claude`, NOT the codemie wrapper — a replayed run authenticates
# against nothing, and the wrapper's --base-url would demand SSO credentials for the
# mock endpoint. Same KEYS as every other overlay; that is what makes the swap a swap.

ORCH_GATE_PROVIDER=claude
EPAM_ORCHESTRATION_PROVIDER=claude
SPEC_MODE_PROVIDER=claude
EPAM_FINAL_FALLBACK_PROVIDER=claude
EPAM_MODEL_PROVIDER_MAP="claude-*=claude"

# THE PLAN PASS IS DECLARED, NEVER INHERITED.
#
# llm-handler.sh defaults to ${EPAM_PLAN_EXECUTE:-1}, so an overlay that says nothing still gets
# a plan-then-answer round on every call -- a reasoning behaviour, and a 2.5x per-call cost
# (claude-haiku-4-5, 2026-08-26: $0.04947 with, $0.01969 without), decided by an absence. It also
# made two stacks incomparable without either file saying so: the claude overlays set 0 while
# every other set silently took the default.
#
# Operator decision 2026-09-08: NO set makes the plan pass. The value is 0 everywhere and is
# stated in every overlay, so it is read where it is looked for rather than inherited.
#
# Every provider set states its own value. A new set that forgets is caught by
# test/unit/orchestration/every-provider-set-declares-its-plan-pass.test.ts rather than quietly
# inheriting whatever the hub happens to default to.
EPAM_PLAN_EXECUTE=0
