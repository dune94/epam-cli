{
  "manifestFile": "package.json",
  "manifestKeys": [
    "dependencies",
    "devDependencies"
  ],
  "scanFileExtensions": [
    ".ts",
    ".tsx",
    ".js",
    ".jsx",
    ".mjs",
    ".cjs"
  ],
  "importPattern": "from\\s+['\"]([^./][^'\"]*)['\"]|require\\(\\s*['\"]([^./][^'\"]*)['\"]\\s*\\)",
  "installCommand": "npm install --save-dev {package}",
  "ignorePackages": [
    "assert",
    "buffer",
    "child_process",
    "cluster",
    "crypto",
    "dgram",
    "dns",
    "domain",
    "events",
    "fs",
    "http",
    "http2",
    "https",
    "net",
    "os",
    "path",
    "perf_hooks",
    "process",
    "punycode",
    "querystring",
    "readline",
    "repl",
    "stream",
    "string_decoder",
    "timers",
    "tls",
    "tty",
    "url",
    "util",
    "v8",
    "vm",
    "worker_threads",
    "zlib",
    "node:assert",
    "node:buffer",
    "node:child_process",
    "node:crypto",
    "node:events",
    "node:fs",
    "node:http",
    "node:https",
    "node:net",
    "node:os",
    "node:path",
    "node:process",
    "node:stream",
    "node:url",
    "node:util",
    "node:vm",
    "node:zlib"
  ],
  "requiredDevDependencies": [
    "typescript",
    "@types/node",
    "vitest",
    "tsx"
  ],
  "vendorDirs": [
    "node_modules"
  ],
  "vendorCacheExcludePatterns": [
    ".vite/*"
  ]
}
