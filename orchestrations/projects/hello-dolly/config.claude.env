# THE PROVIDER-DEPENDENT HALF OF THIS PROJECT'S ENV — the Claude stack (default).
#
# Same KEYS as every other overlay, different VALUES. That is what makes the swap a swap:
# EPAM_PROVIDER_SET picks which of these files is loaded beside config.env, and nothing is
# copied over anything, so an interrupted swap leaves no half-written state.
#
# DISJOINT FROM THE BASE: no key here may also appear in config.env. A test asserts it.
#
# The MODELS are NOT here — they are declared once in config/llm-defaults.claude.json and
# inherited by every project. A model named here would be a second home.

ORCH_GATE_PROVIDER=claude
EPAM_ORCHESTRATION_PROVIDER=claude
SPEC_MODE_PROVIDER=claude
EPAM_FINAL_FALLBACK_PROVIDER=claude
EPAM_MODEL_PROVIDER_MAP="claude-*=claude"

# PLAN/EXECUTE OFF ON THE CLAUDE STACK.
#
# llm-handler.sh makes a PLAN call before every answer ("state your PLAN, and nothing else"),
# then discards it and calls again. Measured 2026-08-26, same prompt through the real hub on
# claude-haiku-4-5: $0.04947 with it, $0.01969 without — the plan pass is 55% of every call, and
# calls cost 2.5x more with it on. Across mock3 run 9 that is $6.83 becoming roughly $2.73.
#
# It was added for a TOOL-BUDGET reason, not a reasoning one: the detective "explored twice —
# seven calls to plan, seven more to answer", and the fix was to strip tools from the plan pass.
# Claude Code plans internally with extended thinking, so a separate plan-then-answer round buys
# little here and is paid for on every single call.
#
# Declared in the CLAUDE overlay only. openrouter keeps it, where the behaviour was tuned and
# where the models have no comparable internal planning. A seam that genuinely needs it can still
# set EPAM_PLAN_EXECUTE=1 for itself.
EPAM_PLAN_EXECUTE=0
