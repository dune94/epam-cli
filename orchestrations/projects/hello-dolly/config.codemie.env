# hello-dolly — the provider-dependent half, codemie stack.
# Same KEYS as every other project's codemie overlay; that is what makes the swap a swap.
# DISJOINT FROM config.env: no key here may also appear there. A test asserts it.

ORCH_GATE_PROVIDER=codemie-claude
EPAM_ORCHESTRATION_PROVIDER=codemie-claude
SPEC_MODE_PROVIDER=codemie-claude
EPAM_FINAL_FALLBACK_PROVIDER=codemie-claude
EPAM_MODEL_PROVIDER_MAP="claude-*=codemie-claude"
