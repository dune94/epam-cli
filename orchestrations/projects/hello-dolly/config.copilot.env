# The copilot set's half of this project's env (projectEnv overlay): the GitHub Copilot CLI serves every role
# the claude overlay gives the claude CLI. Derived from config.claude.env, provider values only.

ORCH_GATE_PROVIDER=copilot
EPAM_ORCHESTRATION_PROVIDER=copilot
SPEC_MODE_PROVIDER=copilot
EPAM_FINAL_FALLBACK_PROVIDER=copilot
EPAM_MODEL_PROVIDER_MAP="claude-*=copilot"

EPAM_PLAN_EXECUTE=0
