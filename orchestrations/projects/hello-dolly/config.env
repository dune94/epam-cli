# hello-dolly — the SET-INDEPENDENT half of this project's env.
#
# Created 2026-08-25. It had none: mock1-paused-run.sh pinned its providers directly
# (export ORCH_GATE_PROVIDER="openrouter"), so the project never needed config and could never be
# swapped. A launcher pin is already-set and OUTRANKS config, so that pin had to go for this
# file to mean anything.
#
# Deliberately minimal: only PROJECT_NAME, which is DERIVED from this project's own
# prd.authored.json. Every other setting mock1-paused-run.sh exports at launch (codeline root,
# Jira endpoints, workspace paths) is RUN state, not project identity, and inventing values for
# them here would put facts nobody chose into config.
PROJECT_NAME=hello-dolly

# THIS PROJECT EXISTS TO EXECUTE EVERY SEAM. It is the £0 brownfield rehearsal the harness judges
# for "every seam the registry declares for this project's modes" — so every switch that gates a
# seam is ON here, whatever a paid project would choose (run 12, 2026-09-14: the router, the
# browser-e2e route check and the prompt builder/reviewer were declared and never asked).
# The topology router asks a model whether a phase runs single, parallel or sequential worktrees.
EPAM_TOPOLOGY_ROUTER=1
# The browser-e2e route check asks a model whether a story needs a browser run.
SKIP_BROWSER_E2E_ROUTING=false

# HOW THIS PROJECT'S PROMPTS ARE PROVISIONED — declared, because the mint refuses to guess.
# Undeclared, every launch of this project died at the mint with "EPAM_PROMPT_PROVISION_MODE is
# unset" (found 2026-09-13 by the £0 brownfield integration test). 'generate' provisions each
# template through the prompt builder and its reviewer — two of the seams this project must
# execute; 'copy' installed the templates as they were and neither seam ever ran (run 12).
EPAM_PROMPT_PROVISION_MODE=generate
# WHAT KIND OF PROJECT THIS IS is identity, not run state: its ticket is a defect in an existing
# codeline (the seed), so every brownfield-only seam applies to it. Declared here so the £0
# harness derives its expected seams from the project's own env (lib/seams-expected.js), the
# same way it does for a greenfield project; mock1-paused-run.sh exports the same value at launch.
EPAM_BROWNFIELD=1
