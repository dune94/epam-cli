# THE PROVIDER-DEPENDENT HALF OF THIS PROJECT'S ENV — CodeMie stack.
#
# Same KEYS as the openrouter overlay, different VALUES. That is what makes the swap a
# swap: EPAM_PROVIDER_SET picks which of these two files is loaded beside config.env,
# and nothing is copied over anything, so an interrupted swap leaves no half-written state.
#
# DISJOINT FROM THE BASE: no key here may also appear in config.env. A test asserts it.
#
# The MODELS are NOT here — they are declared once in config/llm-defaults.codemie.json and
# inherited by every project. A model named here would be a second home for a declaration.

ORCH_GATE_PROVIDER=codemie-claude
EPAM_ORCHESTRATION_PROVIDER=codemie-claude
SPEC_MODE_PROVIDER=codemie-claude
# EPAM_FINAL_FALLBACK_MODEL is declared ONCE in llm-defaults.codemie.json (finalFallback), not per project — a model named here would be a second home.
EPAM_FINAL_FALLBACK_PROVIDER=codemie-claude
EPAM_MODEL_PROVIDER_MAP="claude-*=codemie-claude"
