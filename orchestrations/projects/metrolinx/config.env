# ── Metrolinx Project Config ──────────────────────────────────────────────────
# Consumed by orchestrations/scripts/orchestrate.sh --project metrolinx

# ── Project identity ──────────────────────────────────────────────────────────
PROJECT_NAME=metrolinx
EPAM_BROWNFIELD=1
EPAM_PHASES="core"

# All 3 Metrolinx codelines' husky pre-commit hooks reject branch names that
# don't start with feature|bugfix|tech|release|hotfix/ — "bugfix/AI-<id>"
# satisfies that regex while keeping the AI-<story_id> identifier intact for
# existing lookup/grep logic. Other projects leave this unset (no prefix).
EPAM_BRANCH_PREFIX="bugfix/"

# ── Required keys (checked before launch, comma-separated) ───────────────────
REQUIRED_KEYS=MINIMAX_API_KEY,OPENROUTER_API_KEY,JIRA_TOKEN

# ── Secrets file (sourced after .env — for project-specific tokens) ───────────
SECRETS_FILE=orchestrations/jira/metrolinx.env

# ── Pipeline mode ─────────────────────────────────────────────────────────────
JIRA_PIPELINE=1

# ── AC Gate: auto-elaborate thin/missing ACs into prd.json ────────────────────
# ac-gate.js has no Jira write capability at all (removed 2026-07-22, not
# flag-gated) — there is no AC_GATE_SKIP_JIRA_COMMENTS to set here anymore.
AC_GATE_AUTO_ELABORATE=1

# ── Semble: semantic code search for codeline discovery + spec context ────────
# Injects targeted existing-code snippets (~2k tokens) into spec prompts instead
# of full-file reads (~100k tokens). ~98% token savings. No effect on greenfield.
SEMBLE_ENABLED=1

# ── Jira connection ────────────────────────────────────────────────────────────
JIRA_URL=https://metrolinx.atlassian.net
# JIRA_EMAIL and JIRA_TOKEN come from SECRETS_FILE (orchestrations/jira/metrolinx.env)
JIRA_PROJECT_KEY=AMSD
JIRA_BOARD_ID=
JIRA_JQL="issue = AMSD-1919"

# ── This tracker's own schema ─────────────────────────────────────────────────
# The ingest used to carry these as engine code — customfield_10016 for story points,
# customfield_10014 for the epic link — which are one OTHER tenant's ids. On this instance the
# epic link is customfield_10008 (verified against AMSD-2041, which returns "CE-175"), so the
# hardcoded id read as absent on every run and the value survived only because the code fell
# through to parent.key, which happens to hold the same thing.
#
# Story points is deliberately NOT declared: this tenant has four candidate fields (Story Point,
# Story Points, Story point estimate) and none is populated on the tickets this project runs, so
# naming one would be a guess. Absent is what the adapter already handles — effort falls back to
# the size label.
JIRA_FIELD_EPIC_LINK=customfield_10008

# WHICH STATUSES MEAN FINISHED, in this project's workflow. Matched as case-insensitive
# substrings. `completed` gates whether a story is skipped, so this list decides what the run
# does NOT attempt — an undeclared vocabulary classifies nothing and everything is attempted,
# which is the safe direction. These three reproduce what the engine used to match in English.
JIRA_STATUS_COMPLETED="Done,Closed,Resolved"
JIRA_STATUS_IN_PROGRESS="In Progress,Review,Testing"

# WHICH TYPES THIS PROJECT INGESTS. Undeclared means every type. These five reproduce the list
# that used to be written into the adapter, where a ticket outside it was dropped in silence.
JIRA_ISSUE_TYPES="Story,Task,Bug,Sub-task,Subtask"

# ── Brownfield codeline discovery ──────────────────────────────────────────────
# Root directory containing all Metrolinx local repositories.
# codeline-discovery.js scans this directory, filters to git repos, and calls
# an LLM to match Jira tickets to the correct repo(s) at runtime.
JIRA_CODELINE_ROOT=/home/bradleyjerome/projects/metrolinx

# ── Multi-codeline stories (MC-1) ─────────────────────────────────────────────
# One story, N executions, joined state — NOT split into sub-stories.
# A ticket like AMSD-2041 ("[GO, UP, MX] Live Preview of Content in CMS") spans
# several brand sites; the story keeps its identity and gains codelines[], then
# participates in one loop iteration per codeline with PROJECT_ROOT set per lane.
# Completion is joined: the story is done only when NO lane is outstanding, and a
# declared codeline that produced no result fails the run rather than passing on
# partial coverage.
#
# Without this, a spanning story is filtered out of every lane and the run
# behaves single-codeline while still reporting success.
EPAM_MULTI_CODELINE_STORIES=1

# ── Baseline branch ────────────────────────────────────────────────────────────
# Brownfield gate diff oracles (review-ranger, fuzz-weaver, etc.) diff the
# story's changes against this branch — not against HEAD~1 or a fresh git init.
JIRA_BASELINE_BRANCH=develop

# ── Gate / coordinator model ──────────────────────────────────────────────────
# ORCH_GATE_PROVIDER=openrouter   # moved to config.openrouter.env
# EPAM_ORCHESTRATION_PROVIDER=openrouter   # moved to config.openrouter.env
# MODEL PINS REMOVED 2026-08-25 — THE LADDER IS THE SOURCE OF TRUTH.
# These variables each pinned one model and won over the seam's ladder-resolved choice for
# every consumer that read them. Found by a MOCKED run: the request on the wire asked for
# z-ai/glm-5.2 while seamInvocationEnv had resolved z-ai/glm-5.3 — the resolver was right and
# a config literal beat it downstream. Every consumer already falls through to the seam
# (seamStartModel / EPAM_MODEL), so removing them hands the decision back to the ladder.
# EPAM_FINAL_FALLBACK_MODEL is deliberately KEPT: it applies after ladder exhaustion, which
# is the one point where the ladder has nothing left to say.
# ORCH_GATE_MODEL=z-ai/glm-5.2   # removed: ladder decides

# ── Escalation ladder ─────────────────────────────────────────────────────────
# ESCALATION_MODEL_HIGH also sets the novel-brownfield swap's target
# (claude.sh ~778): that swap only fires when this value differs from the
# story's already-resolved model. MiniMax-M3 here means the swap is a no-op
# when the effort-tier resolution already picked MiniMax-M3 (the common
# case) — letting it stay on M3 (modelOverrides maxIterations=120) instead
# of forcing a jump to a model missing from modelOverrides. Escalation past
# M3 still happens via retries through llm-settings.json's own
# ladders.high.modelLadder (MiniMax-M3 -> glm-5.2 -> kimi-k2.5 -> kimi-k3).
# ESCALATION_MODEL=z-ai/glm-5.2   # removed: ladder decides
# ESCALATION_MODEL_HIGH=MiniMax-M3   # removed: ladder decides

# ── Spec-mode models ──────────────────────────────────────────────────────────
# SPEC_MODE_PROVIDER=openrouter   # moved to config.openrouter.env
# SPEC_MODE_OPENSPEC_MODEL=z-ai/glm-5.2   # removed: ladder decides
# SPEC_MODE_OPENSPEC_MODEL_HIGH=z-ai/glm-5.1   # removed: ladder decides
# SPEC_MODE_SPECKIT_MODEL=z-ai/glm-5.1   # removed: ladder decides
# SPEC_MODE_SPECKIT_MODEL_HIGH=z-ai/glm-5.1   # removed: ladder decides
# SPEC_MODE_MODEL=z-ai/glm-5.2   # removed: ladder decides
SPEC_PASS_BLOCK_ON_TIMEOUT=true
# RUNCLAUDE_TIMEOUT_MS is deliberately NOT set. It is the operator's force-override and wins over
# everything, so setting it here held one number over all 36 seams — each of which declares the
# budget its own work needs. 76031b1 made those declarations live; this line kept them dead for
# this project, and its own commit message names the symptom: "prompt-builder declared 900s, was
# cut off at 360s, and took a survey, a roster, an assignment and 12 generated prompts with it."
# The roster specialiser hit the same cap at 360s against a declared 1800 while it was escalating
# to kimi-k3 and doing real work.
#
# Set it temporarily when debugging a hang — that is what the lever is for. Leaving it set means
# every seam's declaration is documentation.
SPEC_MODE_MAX_OUTPUT_TOKENS=32768
SPEC_AGENT_MAX_RETRIES=2

# ── Model ladder ──────────────────────────────────────────────────────────────
# EPAM_MODEL_LADDER_HIGH/MEDIUM, retries, self-heal extension, story/gate
# timeouts, and the temperature floor now live in ONE place — llm-settings.json
# (sibling file, schema: orchestrations/config/llm-settings.schema.json),
# loaded by claude.sh's load_llm_settings_json() as a fallback default. They
# used to be duplicated in this file AND orchestrations/jira/metrolinx.env,
# with values that had already drifted apart (EPAM_STORY_TIMEOUT_SECS was 690
# here vs 600 there) — removed rather than fixed in place so there is exactly
# one authoritative copy.
# ── HIGHEST — the ladder for seams whose judgement everything downstream rests on ──
# Two rungs, two providers: start on the first, escalate once. Bound to seams by NAME in
# agents/invocation-profiles.json ("ladder": "HIGHEST"), never by anything in engine code —
# which seams climb it is a registry edit, which models it contains is this line.
# WHAT A TIER CONTAINS IS DECLARED IN llm-settings.json, AND NOWHERE ELSE.
#
# This line used to pin EPAM_MODEL_LADDER_HIGHEST to a single hand-written pair. config.env
# is loaded BEFORE claude.sh serialises llm-settings.ladders.*, and that serialisation is
# guarded "only if unset" — so this assignment silently won, and every seam asking for the
# HIGHEST tier climbed a ONE-STEP ladder while llm-settings declared SEVEN transitions.
#
# Live 2026-08-12: "[FailureAnalyst] analyst ladder exhausted at 'z-ai/glm-5.2' (tier=HIGHEST)"
# — moving the analysts from 'high' to 'HIGHEST' made their ladder SHORTER, the opposite of
# the intent. Same shape as SKIP_REGRESSION_GUARD=false below: a project default assigned
# unconditionally, overriding the thing that owns the value.
#   was: EPAM_MODEL_LADDER_HIGHEST="z-ai/glm-5.2=moonshotai/kimi-k3"

EPAM_MODEL_LADDER=
# EPAM_FINAL_FALLBACK_MODEL=moonshotai/kimi-k3   # moved to config.openrouter.env
# EPAM_FINAL_FALLBACK_PROVIDER=openrouter   # moved to config.openrouter.env

# ── Provider routing ──────────────────────────────────────────────────────────
# EPAM_MODEL_PROVIDER_MAP="zhipuai/*=openrouter|moonshotai/*=openrouter|z-ai/*=openrouter|glm-*=openrouter|kimi-*=openrouter|deepseek/*=openrouter|MiniMax-*=minimax"   # moved to config.openrouter.env

# ── Runtime settings ──────────────────────────────────────────────────────────
MINIMAX_TOOL_TIMEOUT_MS=15000
# ORCH_MINI_MODEL=MiniMax-M2.5   # removed: ladder decides
# ORCH_UPGRADE_MODEL=MiniMax-M3   # removed: ladder decides
# A launch-time bypass beats this default, and the mechanism is the LOADER, not the syntax
# here: tier3-metrolinx-run.sh calls `load_env_file_safe "$PROJECT_CONFIG" preserve`, which
# keeps an already-set, non-empty value. Writing ${SKIP_REGRESSION_GUARD:-false} here does NOT
# work — env-file.sh assigns with `printf -v`, so the text is taken LITERALLY and the project
# default is lost entirely (tried 2026-08-13, caught by
# project-config-does-not-clobber-launch-env.test.ts).
SKIP_REGRESSION_GUARD=false
EPAM_RALPH_WIGGUM_ENABLED=0
SKIP_BROWSER_E2E_ROUTING=true

# Metrolinx own PRD template. Unset, synthesize-prd-from-jira.js:34 fell back to
# travel-app-prd.canonical.json, whose project.outputDir is /home/.../skyscanner-app.
# NO PRD TEMPLATE. The PRD is ingested every run from the tracker and this project's own config;
# a stored template made one run's output the next run's premise. See synthesize-prd-from-jira.js.

# ── Unreachable external services ───────────────────────────────────────────
# Contentstack is SaaS: there is no self-hosted image, and this project holds
# delivery credentials only — no preview token, no Live Preview SDK. Work that
# integrates it can be built and wired; it cannot be verified against the real
# service. Declaring that here means the spec pass writes criteria to the
# boundary we can actually prove, rather than criteria nothing can satisfy.
#
# SCOPED DELIBERATELY. Only the hosts listed below are mocked. Every other
# integration — internal APIs, the codeline's own services, anything reachable —
# keeps its real coverage. A flag that quietly removed coverage from APIs we CAN
# reach would trade a real defect for a green tick.
#
# The engine never learns what a CMS is: it reads the flag and the host list.
# Another unreachable class later is a config change, not a code change.
EPAM_MOCK_EXTERNAL_CMS_APIS=1
EPAM_MOCK_EXTERNAL_CMS_HOSTS="contentstack.io,contentstack.com,api.contentstack.io,cdn.contentstack.io"

# ── Test environment ──────────────────────────────────────────────────────────
# This project's date/locale tests assert UTC-rendered dates, as its CI runs.
# On a developer machine in another zone they fail by exactly one day
# (Expected "8 mai 2021" / Received "7 mai 2021" — 13 failures across two
# codelines on 2026-07-28, America/Toronto). Not a code defect and not something
# the engine should assume: which timezone a project's tests require is the
# PROJECT's answer, so it lives here rather than in any script.
TZ=UTC

# ── Codeline scope: DISCOVERED AGENTICALLY, never declared ───────────────────
# JIRA_CODELINES and JIRA_WORKTREE_* are deliberately NOT set here.
# ingest-jira-tickets.sh runs codeline-discovery.js ONLY when JIRA_CODELINES is
# empty. Declaring them pinned the scope to a hand-written list of client repo
# names and switched agentic discovery off entirely.
# Codelines are found at runtime by scoring the real repositories under
# JIRA_CODELINE_ROOT with CodeGraph. That is the only permitted source.

# Which of this tracker's issue types mean "a defect" — project data, not engine knowledge.
# The detective's whole contract hangs off this: a defect must trace a causal site and quote
# the broken expression; anything else is treated as new work, where there is no broken line
# to quote. Undeclared, every story is treated as new work.
EPAM_DEFECT_ISSUE_TYPES=bug

# HOW THIS PROJECT'S PROMPTS ARE PROVISIONED. 'copy' installs the generic templates as they are:
# metrolinx's prompts are deliberately the generic text until someone decides otherwise, and a
# regenerated library would quietly redraw them differently on every mint. There is no engine
# default -- picking one silently is how a project ends up running prompts nobody chose.
# GENERATE, not copy. Copy installs each prompt byte-identical to its generic template, so every
# agent in this project executed text with none of this codeline's facts in it — and self-heal had
# nothing project-specific to correct. Operator decision 2026-08-22: bear the generation cost for
# the code quality, since a prompt is the contract every agent works against.
EPAM_PROMPT_PROVISION_MODE=generate

# The topology router asks a model whether a phase runs single, parallel or sequential worktrees.
# Off: the count heuristic decides instead — deterministic, free, and the same answer the router
# was falling back to whenever it returned nothing. Set EPAM_TOPOLOGY to pin a shape outright, or
# EPAM_TOPOLOGY_ROUTER=1 to ask the model again.
EPAM_TOPOLOGY_ROUTER=0

# ── HUMAN REVIEW POINTS ────────────────────────────────
# Two pauses, both on. Enabled 2026-08-29 at the operator's instruction, for the first metrolinx
# run since the pause machinery was repaired: a run reaching a CLIENT codeline should stop where a
# human can read what it decided, twice.
#
# pause 1 (after the roster): the agents minted and every story's role assigned, before the spec
# pass builds on them. Roles are cheap to correct here and expensive after.
# pause 2 (before the writer): the spec pass, CPA, skill assessment and detective are all settled
# and inspectable, and no code exists yet.
#
# Both resume with EPAM_RESUME_RUN=<run-id>; the resume skips the pause it came from, keeps the
# later one, and preserves any edit made at the pause.
EPAM_PAUSE_AFTER_AGENT_MINT=1
EPAM_PAUSE_BEFORE_WRITER=1
