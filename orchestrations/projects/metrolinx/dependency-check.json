{
  "manifestFile": "package.json",
  "manifestKeys": ["dependencies", "devDependencies"],
  "scanFileExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
  "importPattern": "from\\s+['\"]([^./][^'\"]*)['\"]|require\\(\\s*['\"]([^./][^'\"]*)['\"]\\s*\\)",
  "installCommand": "npm install --ignore-scripts {package}",
  "ignorePackages": ["assert","async_hooks","buffer","child_process","cluster","crypto","dgram","dns","domain","events","fs","http","http2","https","module","net","os","path","perf_hooks","process","punycode","querystring","readline","repl","src","stream","string_decoder","tests","timers","tls","tty","url","util","v8","vm","worker_threads","zlib","node:assert","node:async_hooks","node:buffer","node:child_process","node:crypto","node:events","node:fs","node:http","node:https","node:module","node:net","node:os","node:path","node:process","node:stream","node:url","node:util","node:vm","node:zlib"],
  "requiredDevDependencies": ["typescript", "@types/node"],
  "vendorDirs": ["node_modules"],
  "commentPatterns": ["/\\*[\\s\\S]*?\\*/", "//[^\\n]*"],
  "testFailurePattern": "^FAIL\\s+(\\S+)",
  "localDependencyOverrides": [
    {
      "codeline": "next.upexpress.com",
      "package": "@metrolinx/cx-shared",
      "localSourcePath": "/home/bradleyjerome/projects/metrolinx/cx-shared"
    }
  ]
}
