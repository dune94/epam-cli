# MOCK3 — the pipeline's own end-to-end rehearsal project.
#
# It exists to exercise the SAME generic pipeline metrolinx and gotransit run, against a project
# the engine has never seen, so that "a new project is data" is a claim under test rather than an
# aspiration. Nothing here is read by any code path that metrolinx does not also take.
#
# WHAT MAKES IT DIFFERENT FROM METROLINX, deliberately:
#   - its PRD is its OWN (prd.canonical.json), never ingested from Jira
#   - its prompt library is GENERATED from the template layer, not copied
#   - its codelines are throwaway repos outside this repo, so a run cannot touch client work
PROJECT_NAME=mock3
EPAM_BROWNFIELD=1
EPAM_PHASES="core"
EPAM_BRANCH_PREFIX="bugfix/"

# NO JIRA. The PRD is authored, not synthesised, so the ingest path is skipped entirely --
# which is also what makes this project runnable with no client credentials at all.
JIRA_PIPELINE=0

# THE CODELINES LIVE OUTSIDE THIS REPO. Still not hardcoded in the sense that mattered: an
# operator who wants them elsewhere exports JIRA_CODELINE_ROOT and changes nothing else.
# A LITERAL PATH, and an override that already works. load_env_file_safe reads this file
# rather than executing it, so ${VAR:-default} is taken literally — the value arrived as the
# text "${EPAM_MOCK3_ROOT:-$HOME/projects/mock3}" and the directory check failed on it.
#
# The loader already provides what the override was for: it runs in preserve mode, so a
# JIRA_CODELINE_ROOT exported at launch wins over this line. Same property, one variable
# instead of a project-specific second one, and it is the shape metrolinx already uses.
JIRA_CODELINE_ROOT=/home/bradleyjerome/projects/mock3
JIRA_BASELINE_BRANCH=develop

# ── Codeline scope: DISCOVERED AGENTICALLY, never declared ───────────────────
# JIRA_CODELINES and JIRA_WORKTREE_* are deliberately NOT set, for the same reason metrolinx
# does not set them: discovery runs ONLY when JIRA_CODELINES is empty, so declaring them
# switches the discovery agent off entirely and pins the scope to a hand-written list.
#
# They WERE declared here, by me, in the first draft of this project -- which made mock3 skip
# the one agent it most needed to exercise, since mock3 exists to prove a project the engine
# has never seen can be onboarded as data. The codelines are found by scoring the real
# repositories under JIRA_CODELINE_ROOT, and codeline-facts.json is written by that same
# agent from what it observes in them.
EPAM_MULTI_CODELINE_STORIES=1

# Codeline scope is NOT declared here. It lives in the PRD as project.outputDirs, which
# resolve-codeline-scope.sh writes for every project — this file used to restate it as
# EPAM_ONLY_CODELINES and could only ever disagree with it. See lib/codeline-scope.sh.

# Same providers and models as the project this rehearses, so a difference in outcome is a
# difference in the PIPELINE and not in the models.
ORCH_GATE_PROVIDER=qwen
EPAM_ORCHESTRATION_PROVIDER=qwen
ORCH_GATE_MODEL=z-ai/glm-5.2
ESCALATION_MODEL=z-ai/glm-5.2
ESCALATION_MODEL_HIGH=MiniMax-M3
SPEC_MODE_PROVIDER=qwen
SPEC_MODE_OPENSPEC_MODEL=z-ai/glm-5.2
SPEC_MODE_OPENSPEC_MODEL_HIGH=z-ai/glm-5.1
SPEC_MODE_SPECKIT_MODEL=z-ai/glm-5.1
SPEC_MODE_SPECKIT_MODEL_HIGH=z-ai/glm-5.1
SPEC_MODE_MODEL=z-ai/glm-5.2
SPEC_PASS_BLOCK_ON_TIMEOUT=true
RUNCLAUDE_TIMEOUT_MS=360000
SPEC_MODE_MAX_OUTPUT_TOKENS=32768
SPEC_AGENT_MAX_RETRIES=2
EPAM_MODEL_LADDER=
EPAM_FINAL_FALLBACK_MODEL=moonshotai/kimi-k3
EPAM_FINAL_FALLBACK_PROVIDER=qwen
EPAM_MODEL_PROVIDER_MAP="zhipuai/*=qwen|moonshotai/*=qwen|z-ai/*=qwen|glm-*=qwen|kimi-*=qwen|deepseek/*=qwen|MiniMax-*=minimax"
MINIMAX_TOOL_TIMEOUT_MS=15000
ORCH_MINI_MODEL=MiniMax-M2.5
ORCH_UPGRADE_MODEL=MiniMax-M3
SKIP_REGRESSION_GUARD=false
EPAM_RALPH_WIGGUM_ENABLED=0
EPAM_RETRY_EXTENSION_ENABLED=1
REQUIRED_KEYS=MINIMAX_API_KEY,OPENROUTER_API_KEY

# NO EPAM_DEFAULT_SEAM. This project is the one most likely to mint an agent whose name no
# pattern anticipates, so it is the project that most needs that to be a loud mint failure
# rather than a silent fallback. If a real gap shows up, the fix is a seamPattern.

# 'generate': the whole point of this project is to exercise the path where the agent that mints
# the roster also writes this project's prompts, reading the templates itself and decorating them
# for the codelines and roles it just created. metrolinx never takes that path, so mock3 is the
# only place it is under test.
EPAM_PROMPT_PROVISION_MODE=generate
