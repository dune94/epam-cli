# The codemie-web set's half of this project's env (projectEnv overlay): CodeMie web assistants serve every role
# the claude overlay gives the claude CLI. Derived from config.copilot.env, provider values only.

ORCH_GATE_PROVIDER=codemie-web
EPAM_ORCHESTRATION_PROVIDER=codemie-web
SPEC_MODE_PROVIDER=codemie-web
EPAM_FINAL_FALLBACK_PROVIDER=codemie-web
EPAM_MODEL_PROVIDER_MAP="claude-*=codemie-web"

EPAM_PLAN_EXECUTE=0
