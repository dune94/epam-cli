# THE PROVIDER-DEPENDENT HALF OF THIS PROJECT'S ENV.
#
# Selected by EPAM_PROVIDER_SET (see orchestrations/config/provider-sets.json) and loaded
# by load_project_env alongside config.env. Swapping stacks replaces THIS file, not the base.
#
# These lines were MOVED VERBATIM from config.env on 2026-08-25 — not retyped. The same
# six keys with the same six values lived in every project, which is the duplication a set
# removes.
#
# DISJOINT FROM THE BASE: no key here may also appear in config.env. That is what makes
# load order irrelevant, so no caller needs a precedence rule. A test asserts it.

ORCH_GATE_PROVIDER=openrouter
EPAM_ORCHESTRATION_PROVIDER=openrouter
SPEC_MODE_PROVIDER=openrouter
EPAM_FINAL_FALLBACK_MODEL=moonshotai/kimi-k3
EPAM_FINAL_FALLBACK_PROVIDER=openrouter
EPAM_MODEL_PROVIDER_MAP="zhipuai/*=openrouter|moonshotai/*=openrouter|z-ai/*=openrouter|glm-*=openrouter|kimi-*=openrouter|deepseek/*=openrouter|MiniMax-*=minimax"
