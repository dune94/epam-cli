# multi-lane-estate — a £0 test project: ONE ticket spanning FOUR codelines (a shared library and
# three sites that consume it), run through the real `pipeline --jira` launcher. It exists so the
# multi-codeline brownfield path — lanes, worktrees, pauses, resume — runs end to end before any
# live run of a project with that shape (test/mock-agent/multi-lane-worktree.test.ts).
PROJECT_NAME=multi-lane-estate
EPAM_BROWNFIELD=1
EPAM_PHASES="core"
EPAM_BRANCH_PREFIX="bugfix/"
JIRA_PIPELINE=1
JIRA_PROJECT_KEY=EST
JIRA_JQL="issue = EST-1"
JIRA_STATUS_COMPLETED="Done,Closed,Resolved"
JIRA_ISSUE_TYPES="Story,Task,Bug"
EPAM_MULTI_CODELINE_STORIES=1
JIRA_BASELINE_BRANCH=develop
AC_GATE_AUTO_ELABORATE=1
EPAM_PROMPT_PROVISION_MODE=generate
EPAM_TOPOLOGY_ROUTER=0
SKIP_BROWSER_E2E_ROUTING=true
EPAM_PAUSE_AFTER_AGENT_MINT=1
EPAM_PAUSE_BEFORE_WRITER=1
