{
  "manifestFile": "package.json",
  "manifestKeys": [
    "dependencies",
    "devDependencies"
  ],
  "importPattern": "from\\s+['\"]([^./][^'\"]*)['\"]|require\\(\\s*['\"]([^./][^'\"]*)['\"]\\s*\\)",
  "installCommand": "npm install --ignore-scripts {package}",
  "ignorePackages": [
    "vitest",
    "node:test",
    "node:assert"
  ],
  "vendorDirs": [
    "node_modules"
  ],
  "testFailurePattern": "^FAIL\\s+(\\S+)",
  "autoInstall": false,
  "requiredDevDependencies": [
    "@types/node"
  ],
  "provisionCommand": "npm install --no-audit --no-fund",
  "runEnvironment": {
    "PATH": [
      "node_modules/.bin"
    ]
  }
}
